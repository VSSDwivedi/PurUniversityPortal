@{
    ViewData["Title"] = "Purbanchal University Exam Schedules";
    Layout = "_StudentLayout";
    ViewData["IsInnerPage"] = true;
    var exams = ViewBag.Exams as List<Examination> ?? new List<Examination>();
    // var faculties = ViewBag.Faculties as List<Faculty> ?? new List<Faculty>();
    // var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    // int? selFaculty = ViewBag.SelectedFacultyId;
    // int? selProgram = ViewBag.SelectedProgramId;
    int? selSem = ViewBag.SelectedSemesterId;
}
<style>
    .section-title {
        padding-bottom: 0px;
    }

    /* ========== Page tokens ========== */
    .pu-routine {
        --pu-navy: #0b2a5b;
        --pu-blue: #003980;
        --pu-gold: #f2b705;
        --pu-gold-dark: #d9a200;
        --pu-paper: #f4f6fb;
        --pu-ink: #1b2430;
        --pu-muted: #5b6678;
        --pu-line: #dde3ee;
        --pu-ok: #1a7f4b;
        --pu-bad: #b4372f;
        color: var(--pu-ink);
        font-feature-settings: "tnum" 1;
    }

        /* ========== Filter panel ========== */
        .pu-routine .pu-filter {
            background: #fff;
            border: 1px solid var(--pu-line) !important;
            border-top: 4px solid var(--pu-gold) !important;
            border-radius: 10px;
            box-shadow: 0 1px 2px rgba(11, 42, 91, .06) !important;
        }

            .pu-routine .pu-filter .section-title p {
                color: var(--pu-muted) !important;
                font-size: .875rem;
                letter-spacing: .01em;
                text-transform: none !important;
                font-weight: 600;
                margin-bottom: .15rem !important;
            }

            .pu-routine .pu-filter .section-title h2 {
                color: var(--pu-navy) !important;
                font-size: 1.6rem;
                letter-spacing: -.01em;
            }

        .pu-routine .form-floating > .form-select {
            border: 1.5px solid var(--pu-line);
            border-radius: 8px;
            min-height: 3.5rem;
            background-color: #fff;
            color: var(--pu-ink);
            font-weight: 500;
        }

            .pu-routine .form-floating > .form-select:focus {
                border-color: var(--pu-blue);
                box-shadow: 0 0 0 .2rem rgba(0, 57, 128, .15);
            }

        .pu-routine .form-floating > label {
            color: var(--pu-muted);
            font-weight: 500;
            text-transform: none;
        }

        .pu-routine .pu-search-btn {
            background: var(--pu-gold);
            border: 1px solid var(--pu-gold-dark);
            color: var(--pu-navy);
            border-radius: 8px;
            min-height: 3.5rem;
            transition: background-color .15s ease, transform .1s ease;
        }

            .pu-routine .pu-search-btn:hover {
                background: var(--pu-gold-dark);
                color: var(--pu-navy);
            }

            .pu-routine .pu-search-btn:active {
                transform: translateY(1px);
            }

            .pu-routine .pu-search-btn:focus-visible,
            .pu-routine .form-select:focus-visible {
                outline: 3px solid var(--pu-blue);
                outline-offset: 2px;
            }


        /* ========== Heading overlap fix (theme's .section-title styles) ========== */
        .pu-routine .pu-filter .section-title {
            position: static;
            margin-bottom: 1.25rem !important;
        }

            .pu-routine .pu-filter .section-title p {
                position: static !important;
                display: block;
                margin: 0 0 .25rem 0 !important;
                line-height: 1.3 !important;
                transform: none !important;
            }

            .pu-routine .pu-filter .section-title h2 {
                position: static !important;
                margin: 0 !important;
                line-height: 1.25 !important;
                text-transform: none !important;
                padding-bottom: 0;
            }

        /* ========== Reset button ========== */
        .pu-routine .pu-reset-btn {
            background: #fff;
            border: 1.5px solid var(--pu-line);
            color: var(--pu-navy);
            border-radius: 8px;
            min-height: 3.5rem;
            transition: background-color .15s ease, border-color .15s ease;
        }

            .pu-routine .pu-reset-btn:hover {
                background: var(--pu-paper);
                border-color: var(--pu-blue);
                color: var(--pu-blue);
            }

            .pu-routine .pu-reset-btn:focus-visible {
                outline: 3px solid var(--pu-blue);
                outline-offset: 2px;
            }

        /* ========== Schedules table card ========== */
        .pu-routine .pu-table-card {
            background: #fff;
            border: 1px solid var(--pu-line) !important;
            border-radius: 10px;
            box-shadow: 0 1px 2px rgba(11, 42, 91, .06) !important;
        }

        .pu-routine .pu-table-head {
            background: var(--pu-navy) !important;
            border-bottom: 0 !important;
            padding: 1rem 1.25rem !important;
        }

            .pu-routine .pu-table-head h5 {
                color: #fff !important;
                font-size: 1.05rem;
            }

                .pu-routine .pu-table-head h5 i {
                    color: var(--pu-gold) !important;
                }

            .pu-routine .pu-table-head .badge {
                background: var(--pu-gold) !important;
                color: var(--pu-navy);
                font-weight: 700;
                padding: .45em .8em;
                border-radius: 999px;
            }

        .pu-routine .pu-table thead th {
            background: var(--pu-paper);
            color: var(--pu-muted);
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .02em;
            white-space: nowrap;
            padding: .85rem 1rem;
            border-bottom: 2px solid var(--pu-line);
        }

        .pu-routine .pu-table tbody td {
            padding: 1rem;
            border-color: var(--pu-line);
            font-size: .93rem;
            vertical-align: middle;
        }

        .pu-routine .pu-table tbody tr:nth-child(even) {
            background: #fbfcfe;
        }

        .pu-routine .pu-table.table-hover > tbody > tr:hover > * {
            background-color: #eef3fb;
            --bs-table-accent-bg: transparent;
        }

        .pu-routine .pu-exam-name {
            color: var(--pu-blue) !important;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: .3rem;
        }

        .pu-routine .pu-table .badge.bg-secondary {
            background: var(--pu-paper) !important;
            color: var(--pu-muted);
            border: 1px solid var(--pu-line);
            font-weight: 600;
            border-radius: 4px;
        }

        .pu-routine .pu-table .badge.bg-info {
            background: #e3edfb !important;
            color: var(--pu-blue) !important;
            font-weight: 600;
            border-radius: 4px;
        }

        .pu-routine .pu-table .badge.bg-light {
            background: #fff !important;
            color: var(--pu-ink) !important;
            border: 1px solid var(--pu-line) !important;
            font-weight: 500;
            white-space: nowrap;
            border-radius: 4px;
            padding: .45em .7em;
        }

        .pu-routine .pu-date {
            white-space: nowrap;
            font-weight: 500;
        }

            .pu-routine .pu-date .text-success {
                color: var(--pu-ok) !important;
            }

            .pu-routine .pu-date .text-danger {
                color: var(--pu-bad) !important;
            }

        .pu-routine .pu-empty {
            text-align: center;
            padding: 3rem 1rem !important;
            color: var(--pu-muted);
        }

            .pu-routine .pu-empty i {
                font-size: 2rem;
                color: var(--pu-line);
                display: block;
                margin-bottom: .6rem;
            }

            .pu-routine .pu-empty strong {
                display: block;
                color: var(--pu-ink);
                margin-bottom: .2rem;
            }

    /* ========== Mobile: each row becomes a stacked card ========== */
    @@media (max-width: 767.98px) {
        .pu-routine .pu-filter .section-title h2 {
            font-size: 1.3rem;
        }

        .pu-routine .pu-table thead {
            display: none;
        }

        .pu-routine .pu-table,
        .pu-routine .pu-table tbody,
        .pu-routine .pu-table tr,
        .pu-routine .pu-table td {
            display: block;
            width: 100%;
        }

            .pu-routine .pu-table tbody tr {
                padding: .85rem 1rem;
                border-bottom: 1px solid var(--pu-line);
            }

            .pu-routine .pu-table tbody td {
                border: 0;
                padding: .3rem 0;
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                text-align: right;
            }

                .pu-routine .pu-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 auto;
                    color: var(--pu-muted);
                    font-size: .8rem;
                    font-weight: 600;
                    text-align: left;
                }

                .pu-routine .pu-table tbody td.pu-title-cell {
                    display: block;
                    text-align: left;
                    padding-bottom: .6rem;
                }

                    .pu-routine .pu-table tbody td.pu-title-cell::before {
                        content: none;
                    }

                .pu-routine .pu-table tbody td.pu-empty {
                    display: block;
                }

                    .pu-routine .pu-table tbody td.pu-empty::before {
                        content: none;
                    }
    }
</style>
