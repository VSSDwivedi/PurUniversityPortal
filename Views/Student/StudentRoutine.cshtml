<div class="container py-4 pu-routine">
    <!-- Filter Form replicating puexam.edu.np/exam-schedule-new -->
    <div class="card border-0 shadow-sm p-4 mb-4 bg-white border-top border-4 border-warning pu-filter">
        <div class="section-title mb-3">
            <p class="text-uppercase text-muted fw-bold small mb-1">Exam Schedules</p>
            <h2 class="fw-bold text-primary">Search Examination Schedules</h2>
        </div>
        <form method="get" asp-action="StudentRoutine">
            <div class="row g-3">

                @* ===== Faculty filter (abhi band) =====
                <div class="col-lg-3 col-md-6">
                    <div class="form-floating">
                        <select name="facultyId" id="faculty" class="form-select">
                            <option value="">Select Faculty</option>
                            @foreach (var f in faculties)
                            {
                                <option value="@f.FacultyId" selected="@(selFaculty == f.FacultyId ? "selected" : null)">@f.FacultyName</option>
                            }
                        </select>
                        <label for="faculty">FACULTY</label>
                    </div>
                </div>
                *@

                @* ===== Program filter (abhi band) =====
                <div class="col-lg-3 col-md-6">
                    <div class="form-floating">
                        <select name="programId" id="program" class="form-select">
                            <option value="">Select Program</option>
                            @foreach (var p in programs)
                            {
                                <option value="@p.ProgramId" data-faculty="@p.FacultyId" selected="@(selProgram == p.ProgramId ? "selected" : null)">@p.ProgramName</option>
                            }
                        </select>
                        <label for="program">PROGRAM</label>
                    </div>
                </div>
                *@

                <div class="col-lg-7 col-md-12">
                    <div class="form-floating">
                        <select name="semesterYearId" id="semesterYearId" class="form-select">
                            <option value="">Semester/Year</option>
                            @foreach (var s in semesters)
                            {
                                <option value="@s.SemesterId" selected="@(selSem == s.SemesterId ? "selected" : null)">@s.SemesterName</option>
                            }
                        </select>
                        <label for="semesterYearId">SEMESTER / YEAR</label>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-8">
                    <button type="submit" class="btn btn-warning h-100 w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 pu-search-btn">
                        <i class="fa-solid fa-magnifying-glass"></i> Search Schedule
                    </button>
                </div>

                <div class="col-lg-2 col-md-6 col-4">
                    <a asp-action="StudentRoutine" class="btn h-100 w-100 fw-bold d-flex align-items-center justify-content-center gap-2 pu-reset-btn">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Active Schedules Table -->
    <div class="card border-0 shadow-sm mb-4 bg-white overflow-hidden pu-table-card">
        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center pu-table-head">
            <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-clock text-primary me-2"></i> Active Examination Sessions</h5>
            <span class="badge bg-primary">Academic Year 2026/2083</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 pu-table">
                <thead class="table-light">
                    <tr>
                        <th>Examination Title</th>
                        <th>Type</th>
                        <th>Session</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Shift / Time</th>
                        <th>Center</th>
                        @*  <th class="text-end">Routine File</th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ex in exams)
                    {
                        <tr>
                            <td class="pu-title-cell">
                                <div class="fw-bold text-primary pu-exam-name">@ex.ExamName</div>
                                <span class="badge bg-secondary">@ex.ExamCode</span>
                            </td>
                            <td data-label="Type"><span class="badge bg-info text-dark">@ex.ExamType</span></td>
                            <td data-label="Session">@ex.AcademicYearName &bull; @ex.SemesterName</td>
                            <td data-label="Start date" class="pu-date"><span><i class="fa-regular fa-calendar-check text-success me-1"></i> @ex.StartDate.ToString("MMM dd, yyyy")</span></td>
                            <td data-label="End date" class="pu-date"><span><i class="fa-regular fa-calendar-xmark text-danger me-1"></i> @ex.EndDate.ToString("MMM dd, yyyy")</span></td>
                            <td data-label="Shift / time"><span class="badge bg-light text-dark border">07:00 AM - 10:00 AM (Morning)</span></td>
                            <td data-label="Center">@(ex.DefaultCenterName ?? "Allocated Exam Centers")</td>
                            @* <td class="text-end">
                                <a href="/files/notices/Routine_Spring_2026.pdf" target="_blank" class="btn btn-sm btn-outline-danger fw-bold">
                                    <i class="fa-solid fa-file-pdf me-1"></i> Routine PDF
                                </a>
                            </td>*@
                        </tr>
                    }
                    @if (!exams.Any())
                    {
                        <tr>
                            <td colspan="7" class="pu-empty">
                                <i class="fa-regular fa-calendar-xmark"></i>
                                <strong>No examinations found</strong>
                                Try a different semester or year, then search again.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

