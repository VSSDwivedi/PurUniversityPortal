@model Student
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_StudentLayout";
    var activeExams = ViewBag.ActiveExams as List<Examination> ?? new List<Examination>();
    var notices = ViewBag.RecentNotices as List<Notice> ?? new List<Notice>();
    var results = ViewBag.Results as List<Result> ?? new List<Result>();
}

<!-- Welcome Banner -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" style="background: linear-gradient(135deg, #0b2545 0%, #133b5c 100%);">
    <div class="card-body p-3 p-md-4 text-white">
        <div class="row align-items-center gy-3">
            <div class="col-lg-8 min-w-0">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-warning text-dark px-3 py-1 fw-bold">Student Dashboard</span>
                    <span class="badge @(Model.RegistrationStatus == "Approved" ? "bg-success" : "bg-warning text-dark")">
                        Registration: @Model.RegistrationStatus
                    </span>
                </div>
                <h2 class="fw-bold mb-1 fs-3 fs-md-2 text-truncate">Welcome back, @Model.FullName!</h2>
                <p class="text-white-50 mb-0 small">
                    Student ID: <span class="text-warning fw-bold">@Model.StudentUniqueId</span> &bull;
                    Registration No: <span class="text-white fw-bold">@(Model.RegistrationNumber ?? "Pending Approval")</span>
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-flex flex-wrap gap-2 justify-content-start justify-content-lg-end">
                    <a asp-action="ApplyExam" class="btn btn-warning fw-bold shadow-sm">
                        <i class="fa-solid fa-file-pen me-1"></i> Apply for Exam
                    </a>
                    <a asp-action="AdmitCard" class="btn btn-outline-light fw-bold">
                        <i class="fa-solid fa-id-card me-1"></i> Admit Card
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Profile & Academic Summary Cards -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-lg-4 col-sm-6">
        <div class="card h-100 shadow-sm border p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-3 flex-shrink-0">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div class="min-w-0">
                    <small class="text-muted d-block fw-bold text-truncate">PROGRAM & SEMESTER</small>
                    <div class="fw-bold text-dark text-truncate">@Model.ProgramName</div>
                    <span class="badge bg-light text-dark border">@Model.CurrentSemester</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-sm-6">
        <div class="card h-100 shadow-sm border p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-3 flex-shrink-0">
                    <i class="fa-solid fa-building-columns"></i>
                </div>
                <div class="min-w-0">
                    <small class="text-muted d-block fw-bold text-truncate">CAMPUS / COLLEGE</small>
                    <div class="fw-bold text-dark text-truncate">@Model.CollegeName</div>
                    <span class="text-muted small">Code: @Model.CollegeCode</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-sm-12">
        <div class="card h-100 shadow-sm border p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-danger bg-opacity-10 text-danger fs-3 flex-shrink-0">
                    <i class="fa-solid fa-id-badge"></i>
                </div>
                <div class="min-w-0">
                    <small class="text-muted d-block fw-bold text-truncate">ROLL NUMBER</small>
                    <div class="fw-bold text-danger fs-5 text-truncate">@(Model.RollNumber ?? "Not Assigned Yet")</div>
                    <span class="text-muted small">Session: @Model.AcademicYear</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Active Examinations & Latest Notices -->
<div class="row g-4">
    <!-- Active Exams Column -->
    <div class="col-lg-6">
        <div class="custom-card shadow-sm h-100">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="fa-solid fa-calendar-check text-primary"></i> Active Examination Sessions</h5>
                <a asp-action="ApplyExam" class="btn btn-sm btn-outline-primary fw-bold">Apply Now</a>
            </div>
            <div class="p-3">
                @if (activeExams.Any())
                {
                    foreach (var ex in activeExams)
                    {
                        <div class="border rounded p-3 mb-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <span class="badge bg-danger">@ex.Status</span>
                                <span class="small fw-bold text-muted">Deadline: @ex.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@ex.ExamName</h6>
                            <div class="small text-muted mb-2">
                                <i class="fa-regular fa-calendar me-1"></i> @ex.StartDate.ToString("MMM dd") - @ex.EndDate.ToString("MMM dd, yyyy")
                            </div>
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                                <span class="fw-bold text-success">Fee: NPR @ex.FeeAmount.ToString("N0")</span>
                                <a asp-action="ApplyExam" asp-route-examId="@ex.ExaminationId" class="btn btn-sm btn-primary fw-bold">
                                    <i class="fa-solid fa-file-pen me-1"></i> Apply Online
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4">No active examinations open right now.</p>
                }
            </div>
        </div>
    </div>

    <!-- Official Notices Column -->
    <div class="col-lg-6">
        <div class="custom-card shadow-sm h-100">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="fa-solid fa-bullhorn text-danger"></i> Important Examination Notices</h5>
                <a asp-controller="Home" asp-action="Notices" class="btn btn-sm btn-outline-primary fw-bold">View All</a>
            </div>
            <div class="p-0">
                @foreach (var n in notices.Take(4))
                {
                    <div class="notice-item">
                        <div class="notice-date-box">
                            <div class="day">@n.PublishDate.ToString("dd")</div>
                            <div class="month">@n.PublishDate.ToString("MMM")</div>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <span class="@(n.BadgeClass ?? "badge bg-primary") mb-1 d-inline-block">@(n.CategoryName ?? "Notice")</span>
                            <a asp-controller="Home" asp-action="NoticeDetails" asp-route-id="@n.NoticeId" class="notice-title">
                                @n.Title
                            </a>
                            @if (!string.IsNullOrEmpty(n.AttachmentUrl))
                            {
                                <a href="@n.AttachmentUrl" target="_blank" class="small text-danger fw-bold text-decoration-none mt-1 d-inline-block">
                                    <i class="fa-solid fa-file-pdf me-1"></i> Download Attachment
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
