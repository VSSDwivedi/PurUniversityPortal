@model Student
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "_StudentLayout";
    var activeExams = ViewBag.ActiveExams as List<Examination> ?? new List<Examination>();
    var notices = ViewBag.RecentNotices as List<Notice> ?? new List<Notice>();
    var results = ViewBag.Results as List<Result> ?? new List<Result>();

    string RegClass(string s) => s == "Approved" ? "std-ok"
                               : s == "Pending" ? "std-wait"
                               : s == "CorrectionRequired" ? "std-note"
                               : "std-bad";
}

<!-- Welcome Banner -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" style="background: linear-gradient(135deg, #0b2545 0%, #133b5c 100%);">
    <div class="card-body p-3 p-md-4 text-white">
        <div class="row align-items-center gy-3">
            <div class="col-lg-8 min-w-0">
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    <span class="badge bg-warning text-dark px-3 py-1 fw-bold">Student Dashboard</span>
                    <span class="badge @(Model.RegistrationStatus == "Approved" ? "bg-success" : "bg-warning text-dark")">
                        Registration: @Model.RegistrationStatus
                    </span>
                </div>
                <h2 class="fw-bold mb-1 fs-3 fs-md-2 text-truncate">Welcome back, @Model.FullName!</h2>
                <p class="text-white-50 mb-0 small">
                    Student ID: <span class="text-warning fw-bold">@Model.StudentUniqueId</span> &bull;
                    Registration No: <span class="text-white fw-bold">@(Model.RegistrationNumber ?? "Pending Approval")</span>
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-flex flex-wrap gap-2 justify-content-start justify-content-lg-end">
                    <a asp-action="ApplyExam" class="btn btn-warning fw-bold shadow-sm">
                        <i class="fa-solid fa-file-pen me-1"></i> Apply for Exam
                    </a>
                    <a asp-action="AdmitCard" class="btn btn-outline-light fw-bold">
                        <i class="fa-solid fa-id-card me-1"></i> Admit Card
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Profile & Academic Summary Cards -->
<div class="row g-3 g-md-4 mb-4">

@if (Model.RegistrationStatus != "Approved")
{
    <div class="std-alert">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <strong>Registration @Model.RegistrationStatus.</strong>
            Exam apply karne ke liye registration approve hona zaroori ho sakta hai. Status ke liye college office se sampark karein.
        </div>
    </div>
}

<!-- ============ Summary Cards ============ -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="std-info">
            <div class="std-info-icon"><i class="fa-solid fa-graduation-cap"></i></div>
            <div class="std-info-body">
                <div class="std-info-label">Program &amp; Semester</div>
                <div class="std-info-value">@Model.ProgramName</div>
                <span class="std-chip">@Model.CurrentSemester</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="std-info">
            <div class="std-info-icon"><i class="fa-solid fa-building-columns"></i></div>
            <div class="std-info-body">
                <div class="std-info-label">Campus / College</div>
                <div class="std-info-value">@Model.CollegeName</div>
                <span class="std-info-sub">Code: @Model.CollegeCode</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="std-info">
            <div class="std-info-icon"><i class="fa-solid fa-id-badge"></i></div>
            <div class="std-info-body">
                <div class="std-info-label">Roll Number</div>
                <div class="std-info-value roll @(Model.RollNumber == null ? "muted" : "")">@(Model.RollNumber ?? "Not Assigned Yet")</div>
                <span class="std-info-sub">Session: @Model.AcademicYear</span>
            </div>
        </div>
    </div>
</div>

 
</div>

<!-- ============ Exams & Notices ============ -->
<div class="row g-4">
    <!-- Active Exams -->
    <div class="col-lg-6">
        <div class="custom-card shadow-sm h-100">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="fa-solid fa-calendar-check text-primary"></i> Active Examination Sessions</h5>
                <a asp-action="ApplyExam" class="btn btn-sm btn-outline-primary fw-bold">Apply Now</a>
            </div>
            <div class="std-body">
                @if (activeExams.Any())
                {
                    foreach (var ex in activeExams)
                    {
                        <div class="border rounded p-3 mb-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <span class="badge bg-danger">@ex.Status</span>
                                <span class="small fw-bold text-muted">Deadline: @ex.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                            </div>
                            <h6 class="std-exam-name">@ex.ExamName</h6>
                            <div class="std-exam-date">
                                <i class="fa-regular fa-calendar"></i>
                                @ex.StartDate.ToString("MMM dd") - @ex.EndDate.ToString("MMM dd, yyyy")
                            </div>
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                                <span class="fw-bold text-success">Fee: NPR @ex.FeeAmount.ToString("N0")</span>
                                <a asp-action="ApplyExam" asp-route-examId="@ex.ExaminationId" class="btn btn-sm btn-primary fw-bold">
                                    <i class="fa-solid fa-file-pen me-1"></i> Apply Online
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="std-empty">
                        <i class="fa-solid fa-calendar-xmark"></i>
                        <div>No active examinations open right now.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Notices -->
    <div class="col-lg-6">
        <div class="custom-card shadow-sm h-100">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="fa-solid fa-bullhorn text-danger"></i> Important Examination Notices</h5>
                <a asp-controller="Home" asp-action="Notices" class="btn btn-sm btn-outline-primary fw-bold">View All</a>
            </div>
            <div>
                @if (notices.Any())
                {
                    foreach (var n in notices.Take(4))
                    {
                        <div class="std-notice">
                            <div class="std-date">
                                <div class="day">@n.PublishDate.ToString("dd")</div>
                                <div class="month">@n.PublishDate.ToString("MMM")</div>
                            </div>
                            <div class="std-notice-body">
                                <span class="std-cat">@(n.CategoryName ?? "Notice")</span>
                                <a asp-controller="Home" asp-action="NoticeDetails" asp-route-id="@n.NoticeId" class="std-notice-title">@n.Title</a>
                                @if (!string.IsNullOrEmpty(n.AttachmentUrl))
                                {
                                    <a href="@n.AttachmentUrl" target="_blank" rel="noopener" class="std-attach">
                                        <i class="fa-solid fa-file-pdf"></i> Download Attachment
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="std-empty">
                        <i class="fa-solid fa-bell-slash"></i>
                        <div>No notices available.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== Hero ===== */
    .std-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 26px 28px;
        border-radius: 14px;
        color: #fff;
        background: #1e3c72;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .22);
    }

        .std-hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            right: -70px;
            top: -110px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .08);
            pointer-events: none;
        }

        .std-hero > * {
            position: relative;
            z-index: 1;
        }

    .std-tag {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 6px;
        font-size: .78rem;
        font-weight: 800;
        color: #0f172a;
        background: #ffc53d;
    }

    .std-hero-title {
        margin: 6px 0 6px;
        font-size: 1.7rem;
        font-weight: 800;
    }

    .std-hero-sub {
        margin: 0;
        font-size: .92rem;
        font-weight: 600;
        color: #e2e8f0;
    }

        .std-hero-sub .gold {
            color: #ffc53d;
        }

        .std-hero-sub strong {
            font-weight: 800;
        }

    .std-btn-gold, .std-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 700;
        text-decoration: none;
        transition: background .15s ease, color .15s ease;
    }

    .std-btn-gold {
        color: #0f172a;
        background: #ffc53d;
        border: 1.5px solid #ffc53d;
        margin-right: 8px;
    }

        .std-btn-gold:hover {
            background: #ffd166;
            color: #0f172a;
        }

    .std-btn-outline {
        color: #fff;
        background: transparent;
        border: 1.5px solid #fff;
    }

        .std-btn-outline:hover {
            background: #fff;
            color: #1e3c72;
        }

    @@media (max-width: 767px) {
        .std-btn-gold, .std-btn-outline {
            margin: 0 8px 8px 0;
        }
    }

    /* ===== Status pill (solid) ===== */
    .std-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 14px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        color: #fff;
        border: 1.5px solid rgba(255, 255, 255, .6);
    }

        .std-pill .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #fff;
        }

    .std-ok {
        background: #198754;
    }

    .std-wait {
        background: #d97706;
    }

    .std-note {
        background: #0d6efd;
    }

    .std-bad {
        background: #dc3545;
    }

    /* ===== Alert ===== */
    .std-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
        padding: 13px 18px;
        border-radius: 10px;
        font-size: .88rem;
        font-weight: 600;
        color: #7c2d12;
        background: #fff1d6;
        border: 1.5px solid #d97706;
    }

        .std-alert i {
            margin-top: 2px;
            font-size: 1.1rem;
            color: #d97706;
        }

    /* ===== Summary cards ===== */
    .std-info {
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #c9d3e0;
        border-left: 5px solid #1e3c72;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .10);
    }

    .std-info-icon {
        flex-shrink: 0;
        width: 54px;
        height: 54px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        background: #1e3c72;
    }

    .std-info-body {
        min-width: 0;
    }

    .std-info-label {
        margin-bottom: 2px;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #475569;
    }

    .std-info-value {
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
        word-break: break-word;
    }

        .std-info-value.roll {
            font-size: 1.2rem;
            color: #b02a37;
        }

            .std-info-value.roll.muted {
                font-size: 1rem;
                color: #64748b;
            }

    .std-info-sub {
        font-size: .8rem;
        font-weight: 600;
        color: #475569;
    }

    .std-chip {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 10px;
        border-radius: 6px;
        font-size: .78rem;
        font-weight: 700;
        color: #1e3c72;
        background: #e3ebf9;
        border: 1px solid #b9c8e0;
    }

    /* ===== Cards ===== */
    .std-card {
        height: 100%;
        background: #fff;
        border: 1px solid #c9d3e0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .10);
    }

    .std-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 13px 20px;
        background: #1e3c72;
    }

    .std-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
    }

        .std-title i {
            margin-right: 8px;
            color: #ffc53d;
        }

    .std-body {
        padding: 16px;
    }

    .std-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 13px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        border: 1.5px solid rgba(255, 255, 255, .7);
        transition: background .15s ease, color .15s ease;
    }

        .std-btn-ghost:hover {
            background: #fff;
            color: #1e3c72;
        }

        .std-btn-ghost i {
            font-size: .7rem;
        }

    .std-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        background: #1e3c72;
        transition: background .15s ease;
    }

        .std-btn-primary:hover {
            background: #162d57;
            color: #fff;
        }

    /* ===== Exam item ===== */
    .std-exam {
        margin-bottom: 14px;
        padding: 14px 16px;
        border: 1.5px solid #c9d3e0;
        border-radius: 10px;
        background: #fff;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .std-exam:last-child {
            margin-bottom: 0;
        }

        .std-exam:hover {
            border-color: #1e3c72;
            box-shadow: 0 2px 8px rgba(30, 60, 114, .15);
        }

    .std-exam-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

    .std-status {
        padding: 3px 12px;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
        color: #fff;
        background: #dc3545;
    }

    .std-deadline {
        font-size: .8rem;
        font-weight: 700;
        color: #b02a37;
    }

        .std-deadline i {
            margin-right: 4px;
        }

    .std-exam-name {
        margin: 0 0 4px;
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
    }

    .std-exam-date {
        margin-bottom: 12px;
        font-size: .84rem;
        font-weight: 600;
        color: #475569;
    }

        .std-exam-date i {
            margin-right: 5px;
        }

    .std-exam-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding-top: 12px;
        border-top: 1px solid #d5dde8;
    }

    .std-fee {
        font-size: .92rem;
        font-weight: 800;
        color: #146c43;
    }

    /* ===== Notices ===== */
    .std-notice {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 14px 20px;
        border-bottom: 1px solid #d5dde8;
        transition: background .15s ease;
    }

        .std-notice:last-child {
            border-bottom: 0;
        }

        .std-notice:hover {
            background: #f3f7fd;
        }

    .std-date {
        flex-shrink: 0;
        width: 54px;
        text-align: center;
        overflow: hidden;
        border-radius: 8px;
        border: 1.5px solid #1e3c72;
        background: #fff;
    }

        .std-date .day {
            padding: 4px 0 0;
            font-size: 1.25rem;
            font-weight: 800;
            line-height: 1.2;
            color: #0f172a;
        }

        .std-date .month {
            padding: 2px 0;
            font-size: .7rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #fff;
            background: #1e3c72;
        }

    .std-notice-body {
        flex: 1;
        min-width: 0;
    }

    .std-cat {
        display: inline-block;
        margin-bottom: 4px;
        padding: 2px 10px;
        border-radius: 6px;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #1e3c72;
        background: #e3ebf9;
        border: 1px solid #b9c8e0;
    }

    .std-notice-title {
        display: block;
        font-size: .92rem;
        font-weight: 700;
        line-height: 1.35;
        color: #0f172a;
        text-decoration: none;
    }

        .std-notice-title:hover {
            color: #1e3c72;
            text-decoration: underline;
        }

    .std-attach {
        display: inline-block;
        margin-top: 4px;
        font-size: .8rem;
        font-weight: 700;
        color: #b02a37;
        text-decoration: none;
    }

        .std-attach:hover {
            text-decoration: underline;
        }

        .std-attach i {
            margin-right: 4px;
        }

    /* ===== Empty ===== */
    .std-empty {
        text-align: center;
        padding: 36px 16px;
        font-size: .92rem;
        font-weight: 600;
        color: #64748b;
    }

        .std-empty i {
            display: block;
            margin-bottom: 8px;
            font-size: 2rem;
        }
</style>