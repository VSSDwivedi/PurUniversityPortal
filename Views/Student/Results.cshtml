@model List<Result>
@{
    ViewData["Title"] = "My Semester Results";
    Layout = "_StudentLayout";
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-award text-warning"></i> Academic Results & Performance History</h5>
        <a asp-controller="Results" asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">Public Results Search</a>
    </div>

    <div class="p-4">
        @if (Model.Any())
        {
            foreach (var r in Model)
            {
                <div class="border rounded-3 p-4 mb-4 bg-light shadow-sm">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 border-bottom pb-3">
                        <div>
                            <h5 class="fw-bold text-primary mb-1">@r.ExamName</h5>
                            <span class="text-muted small">Program: @r.ProgramName &bull; Semester: @r.SemesterName &bull; Roll No: <strong>@r.RollNumber</strong></span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(r.ResultStatus == "Passed" ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                @r.ResultStatus
                            </span>
                            <a asp-controller="Results" asp-action="GradeSheet" asp-route-id="@r.ResultId" target="_blank" class="btn btn-primary btn-sm fw-bold">
                                <i class="fa-solid fa-print me-1"></i> Print Grade Sheet (A4)
                            </a>
                        </div>
                    </div>

                    <!-- Subject Breakdown -->
                    <div class="table-responsive bg-white rounded border mb-3">
                        <table class="table table-bordered table-sm align-middle mb-0 text-center">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-start">Subject</th>
                                    <th>Credit</th>
                                    <th>Internal</th>
                                    <th>External</th>
                                    <th>Practical</th>
                                    <th>Total</th>
                                    <th>Grade</th>
                                    <th>Grade Point</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in r.Details)
                                {
                                    <tr>
                                        <td class="text-start">
                                            <strong>@sub.SubjectCode</strong>: @sub.SubjectName
                                        </td>
                                        <td>@sub.CreditHours</td>
                                        <td>@sub.InternalMarks.ToString("F1")</td>
                                        <td>@sub.ExternalMarks.ToString("F1")</td>
                                        <td>@(sub.PracticalMarks > 0 ? sub.PracticalMarks.ToString("F1") : "-")</td>
                                        <td class="fw-bold">@sub.TotalMarks.ToString("F1")</td>
                                        <td><span class="badge @(sub.Grade == "F" ? "bg-danger" : "bg-success")">@sub.Grade</span></td>
                                        <td>@sub.GradePoint.ToString("F2")</td>
                                        <td><span class="@(sub.IsPass ? "text-success fw-bold" : "text-danger fw-bold")">@(sub.IsPass ? "Pass" : "Back")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- GPA Summary Banner -->
                    <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded border">
                        <div>
                            <span class="me-4">Total Credits: <strong>@r.TotalCreditHours</strong></span>
                            <span class="me-4">Total Marks: <strong>@r.TotalMarksObtained.ToString("F1") / @r.TotalFullMarks.ToString("F0")</strong></span>
                            <span>Percentage: <strong class="text-primary">@r.Percentage.ToString("F2")%</strong></span>
                        </div>
                        <div>
                            <span class="me-3">SGPA: <strong class="text-success fs-5">@r.SGPA.ToString("F2")</strong></span>
                            <span>CGPA: <strong class="text-primary fs-5">@r.CGPA.ToString("F2")</strong></span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-graduation-cap fa-3x mb-2 text-secondary"></i>
                <h5>No Published Results Available</h5>
                <p>Your examination results will appear here once officially approved and published by the Office of the Controller of Examinations.</p>
            </div>
        }
    </div>
</div>
