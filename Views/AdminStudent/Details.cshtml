@model Student
@{
    ViewData["Title"] = "Student Dossier - " + Model.FullName;
    Layout = "_AdminLayout";
    var docs = ViewBag.Documents as List<StudentDocument> ?? new List<StudentDocument>();
}

<div class="row g-4">
    <!-- Student Overview Card Left -->
    <div class="col-lg-4">
        <div class="card shadow-sm border p-4 text-center mb-4">
            <div class="mx-auto mb-3" style="width: 140px; height: 140px; border-radius: 50%; overflow: hidden; border: 4px solid #f1f5f9;">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="Student Photo" class="w-100 h-100 object-fit-cover" />
                }
                else
                {
                    <div class="w-100 h-100 bg-secondary text-white d-flex align-items-center justify-content-center fs-1">
                        <i class="fa-solid fa-user"></i>
                    </div>
                }
            </div>

            <h4 class="fw-bold text-primary mb-1">@Model.FullName</h4>
            <div class="text-danger fw-semibold small mb-2">Student ID: @Model.StudentUniqueId</div>
            <div>
                <span class="badge @(Model.RegistrationStatus == "Approved" ? "bg-success" : Model.RegistrationStatus == "Pending" ? "bg-warning text-dark" : "bg-danger") px-3 py-2 fs-6">
                    Registration: @Model.RegistrationStatus
                </span>
            </div>

            <hr/>

            <div class="text-start small">
                <div class="mb-2"><strong>Registration Number:</strong> <span class="text-danger fw-bold">@(Model.RegistrationNumber ?? "Pending Approval")</span></div>
                <div class="mb-2"><strong>Assigned Roll Number:</strong> @(Model.RollNumber ?? "Not Allocated")</div>
                <div class="mb-2"><strong>Application Number:</strong> @(Model.ApplicationNumber ?? "N/A")</div>
                <div class="mb-2"><strong>College:</strong> @Model.CollegeName</div>
                <div class="mb-2"><strong>Program:</strong> @Model.ProgramName</div>
                <div class="mb-2"><strong>Current Semester:</strong> @Model.CurrentSemester</div>
                <div><strong>Submission Date:</strong> @Model.CreatedDate.ToString("MMMM dd, yyyy")</div>
            </div>
        </div>

        <!-- Verification Action Panel -->
        <div class="card shadow-sm border p-4">
            <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-shield-halved text-warning me-2"></i> Registration Verification</h5>

            <form asp-action="Verify" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="studentId" value="@Model.StudentId" />

                <div class="mb-3">
                    <label class="form-label small fw-bold">Verification Decision *</label>
                    <select name="status" class="form-select" required>
                        <option value="Approved" selected="@(Model.RegistrationStatus == "Approved")">Approve Registration</option>
                        <option value="Pending" selected="@(Model.RegistrationStatus == "Pending")">Keep Pending</option>
                        <option value="CorrectionRequired" selected="@(Model.RegistrationStatus == "CorrectionRequired")">Request Corrections</option>
                        <option value="Rejected" selected="@(Model.RegistrationStatus == "Rejected")">Reject Registration</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Official Remarks / Notes</label>
                    <textarea name="remarks" rows="3" class="form-control" placeholder="e.g. Verified with original citizenship and academic transcripts.">@Model.VerificationRemarks</textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                    <i class="fa-solid fa-check-double me-1"></i> Update Verification Status
                </button>
            </form>
        </div>
    </div>

    <!-- Student Full Dossier & Credentials Right -->
    <div class="col-lg-8">
        <div class="custom-card shadow-sm mb-4">
            <div class="card-header-custom">
                <h5><i class="fa-solid fa-id-badge text-primary"></i> Academic & Personal Records</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block fw-bold">FULL NAME</small>
                        <span class="fs-6 fw-bold text-dark">@Model.FullName</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block fw-bold">DATE OF BIRTH</small>
                        <span class="text-dark">@Model.DateOfBirth.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted d-block fw-bold">GENDER</small>
                        <span class="text-dark">@Model.Gender</span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block fw-bold">EMAIL ADDRESS</small>
                        <span class="text-dark">@Model.Email</span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block fw-bold">MOBILE PHONE</small>
                        <span class="text-dark">@Model.MobileNumber</span>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block fw-bold">PERMANENT RESIDENCE</small>
                        <span class="text-dark">@Model.Address</span>
                    </div>
                    <div class="col-12 border-top pt-3">
                        <small class="text-muted d-block fw-bold">PREVIOUS QUALIFICATION</small>
                        <span class="text-dark">@(Model.PreviousQualification ?? "Not Specified")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document Attachments Preview -->
        <div class="custom-card shadow-sm">
            <div class="card-header-custom">
                <h5><i class="fa-solid fa-folder-closed text-danger"></i> Attached Documents & Identity Proofs</h5>
            </div>
            <div class="p-4">
                @if (docs.Any() || !string.IsNullOrEmpty(Model.IdentityDocumentUrl))
                {
                    <div class="row g-3">
                        @if (!string.IsNullOrEmpty(Model.IdentityDocumentUrl))
                        {
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fa-solid fa-file-pdf fa-2x text-danger me-2"></i>
                                        <strong>Identity / Citizenship</strong>
                                    </div>
                                    <a href="@Model.IdentityDocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-eye me-1"></i> Preview
                                    </a>
                                </div>
                            </div>
                        }
                        @foreach (var doc in docs)
                        {
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fa-solid fa-file-lines fa-2x text-primary me-2"></i>
                                        <div>
                                            <strong>@doc.DocumentType</strong>
                                            <div class="text-muted small">@doc.DocumentName</div>
                                        </div>
                                    </div>
                                    <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-eye me-1"></i> Preview
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No physical documents uploaded for this candidate.</p>
                }
            </div>
        </div>
    </div>
</div>
