@model List<Examination>
@{
    ViewData["Title"] = "Examination Sessions";
    Layout = "_AdminLayout";
}

<style>
    .pu-exams {
        --pu-navy: #0b2a5b;
        --pu-blue: #003980;
        --pu-gold: #f2b705;
        --pu-paper: #f4f6fb;
        --pu-ink: #1b2430;
        --pu-muted: #5b6678;
        --pu-line: #dde3ee;
        --pu-ok: #1a7f4b;
        --pu-warn: #a86a00;
        --pu-info: #0b5cc4;
        color: var(--pu-ink);
        font-feature-settings: "tnum" 1;
    }

        .pu-exams.custom-card {
            background: #fff;
            border: 1px solid var(--pu-line);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(11, 42, 91, .06) !important;
        }

        .pu-exams .card-header-custom {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: .75rem 1rem;
            padding: 1rem 1.25rem;
            background: var(--pu-navy);
            border-bottom: 0;
        }

            .pu-exams .card-header-custom h5 {
                margin: 0;
                color: #fff;
                font-size: 1.05rem;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: .6rem;
            }

                .pu-exams .card-header-custom h5 i {
                    color: var(--pu-gold) !important;
                }

            .pu-exams .card-header-custom .btn-outline-secondary {
                color: #fff;
                border-color: rgba(255, 255, 255, .45);
                background: transparent;
            }

                .pu-exams .card-header-custom .btn-outline-secondary:hover {
                    background: rgba(255, 255, 255, .12);
                    border-color: #fff;
                    color: #fff;
                }

            .pu-exams .card-header-custom .btn-primary {
                background: var(--pu-gold);
                border-color: var(--pu-gold);
                color: var(--pu-navy);
            }

                .pu-exams .card-header-custom .btn-primary:hover {
                    background: #d9a200;
                    border-color: #d9a200;
                    color: var(--pu-navy);
                }

            .pu-exams .card-header-custom .btn {
                border-radius: 8px;
                padding: .5rem .9rem;
            }

        .pu-exams .btn:focus-visible {
            outline: 3px solid var(--pu-blue);
            outline-offset: 2px;
        }

        .pu-exams .pu-table thead th {
            background: var(--pu-paper);
            color: var(--pu-muted);
            font-size: .8rem;
            font-weight: 700;
            letter-spacing: .02em;
            white-space: nowrap;
            padding: .85rem 1rem;
            border-bottom: 2px solid var(--pu-line);
        }

        .pu-exams .pu-table tbody td {
            padding: 1rem;
            font-size: .92rem;
            border-color: var(--pu-line);
            vertical-align: middle;
        }

        .pu-exams .pu-table tbody tr:nth-child(even) {
            background: #fbfcfe;
        }

        .pu-exams .pu-table.table-hover > tbody > tr:hover > * {
            background-color: #eef3fb;
            --bs-table-accent-bg: transparent;
        }

        .pu-exams .pu-code {
            display: inline-block;
            font-weight: 700;
            color: var(--pu-blue) !important;
            background: #e8effa;
            border-radius: 4px;
            padding: .2rem .5rem;
            font-size: .82rem;
            white-space: nowrap;
        }

        .pu-exams .pu-title {
            font-weight: 700;
            color: var(--pu-ink) !important;
            line-height: 1.3;
        }

        .pu-exams .pu-sub {
            color: var(--pu-muted) !important;
            font-size: .8rem;
        }

        .pu-exams .pu-nowrap {
            white-space: nowrap;
        }

        .pu-exams .pu-deadline.badge {
            background: #fff6d6 !important;
            color: #6b4a00 !important;
            border: 1px solid #f0d77a;
            font-weight: 600;
            border-radius: 4px;
            padding: .4em .65em;
            white-space: nowrap;
        }

        .pu-exams .pu-fee {
            color: var(--pu-ok) !important;
            font-weight: 700;
            white-space: nowrap;
        }

        .pu-exams .pu-count.badge {
            background: var(--pu-paper) !important;
            color: var(--pu-ink) !important;
            border: 1px solid var(--pu-line);
            font-size: .9rem !important;
            font-weight: 700;
            min-width: 2.4rem;
            border-radius: 999px;
        }

        .pu-exams .pu-status.badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: #eceff4 !important;
            color: var(--pu-ink) !important;
            font-weight: 600;
            font-size: .8rem;
            border-radius: 999px;
            padding: .4em .8em !important;
            white-space: nowrap;
        }

            .pu-exams .pu-status.badge::before {
                content: "";
                width: .5rem;
                height: .5rem;
                border-radius: 50%;
                background: #6b7280;
            }

        .pu-exams .pu-status[data-status="Ongoing"].badge {
            background: #e3edfb !important;
            color: var(--pu-info) !important;
        }

            .pu-exams .pu-status[data-status="Ongoing"].badge::before {
                background: var(--pu-info);
            }

        .pu-exams .pu-status[data-status="Upcoming"].badge {
            background: #fff1d1 !important;
            color: var(--pu-warn) !important;
        }

            .pu-exams .pu-status[data-status="Upcoming"].badge::before {
                background: #e59a00;
            }

        .pu-exams .pu-status[data-status="ResultPublished"].badge {
            background: #dff3e8 !important;
            color: var(--pu-ok) !important;
        }

            .pu-exams .pu-status[data-status="ResultPublished"].badge::before {
                background: var(--pu-ok);
            }

        .pu-exams .pu-actions-cell {
            width: 1%;
            white-space: nowrap;
        }

        .pu-exams .pu-actions {
            display: inline-flex;
            flex-wrap: nowrap;
            align-items: center;
            justify-content: flex-end;
            gap: .4rem;
        }

            .pu-exams .pu-actions .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin: 0 !important;
                min-width: 2.2rem;
                height: 2.2rem;
                padding: 0 .65rem;
                border-radius: 6px;
                white-space: nowrap;
                font-size: .8rem;
                line-height: 1;
                background: #fff;
            }

                .pu-exams .pu-actions .btn i {
                    margin: 0 !important;
                }

            .pu-exams .pu-actions .pu-btn-label {
                margin-left: .4rem;
            }

            .pu-exams .pu-actions .btn-outline-primary {
                color: var(--pu-blue);
                border-color: var(--pu-blue);
            }

                .pu-exams .pu-actions .btn-outline-primary:hover {
                    background: var(--pu-blue);
                    border-color: var(--pu-blue);
                    color: #fff;
                }

            .pu-exams .pu-actions .btn-outline-warning {
                color: #6b4a00 !important;
                border-color: #e0b100;
            }

                .pu-exams .pu-actions .btn-outline-warning:hover {
                    background: var(--pu-gold);
                    border-color: var(--pu-gold);
                    color: var(--pu-navy) !important;
                }

            .pu-exams .pu-actions .btn-outline-success {
                color: var(--pu-ok);
                border-color: var(--pu-ok);
            }

                .pu-exams .pu-actions .btn-outline-success:hover {
                    background: var(--pu-ok);
                    color: #fff;
                }

    @@media (min-width: 992px) and (max-width: 1399.98px) {
        .pu-exams .pu-actions .pu-btn-label {
            display: none;
        }

        .pu-exams .pu-actions .btn {
            padding: 0;
            width: 2.2rem;
        }
    }

    .pu-exams .pu-empty {
        text-align: center;
        padding: 3rem 1rem !important;
        color: var(--pu-muted);
    }

        .pu-exams .pu-empty i {
            display: block;
            font-size: 2rem;
            color: var(--pu-line);
            margin-bottom: .6rem;
        }

        .pu-exams .pu-empty strong {
            display: block;
            color: var(--pu-ink);
            margin-bottom: .2rem;
        }

    @@media (max-width: 991.98px) {
        .pu-exams .pu-table thead {
            display: none;
        }

        .pu-exams .pu-table,
        .pu-exams .pu-table tbody,
        .pu-exams .pu-table tr,
        .pu-exams .pu-table td {
            display: block;
            width: 100%;
        }

            .pu-exams .pu-table tbody tr {
                padding: .9rem 1rem;
                border-bottom: 1px solid var(--pu-line);
            }

            .pu-exams .pu-table tbody td {
                border: 0;
                padding: .3rem 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
                text-align: right;
            }

                .pu-exams .pu-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 auto;
                    color: var(--pu-muted);
                    font-size: .8rem;
                    font-weight: 600;
                    text-align: left;
                }

                .pu-exams .pu-table tbody td.pu-code-cell,
                .pu-exams .pu-table tbody td.pu-title-cell,
                .pu-exams .pu-table tbody td.pu-actions-cell,
                .pu-exams .pu-table tbody td.pu-empty {
                    display: block;
                    text-align: left;
                }

                    .pu-exams .pu-table tbody td.pu-code-cell::before,
                    .pu-exams .pu-table tbody td.pu-title-cell::before,
                    .pu-exams .pu-table tbody td.pu-actions-cell::before,
                    .pu-exams .pu-table tbody td.pu-empty::before {
                        content: none;
                    }

                .pu-exams .pu-table tbody td.pu-actions-cell {
                    padding-top: .7rem;
                    width: 100%;
                    white-space: normal;
                }

        .pu-exams .pu-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start;
            width: 100%;
        }

            .pu-exams .pu-actions .btn {
                flex: 1 1 auto;
            }
    }
</style>

<div class="custom-card shadow-sm mb-4 pu-exams">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-calendar-check text-primary"></i> University Examination Sessions</h5>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Centers" class="btn btn-outline-secondary btn-sm fw-bold">
                <i class="fa-solid fa-building-flag me-1"></i> Exam Centers
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm fw-bold">
                <i class="fa-solid fa-plus me-1"></i> Create Examination Session
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 pu-table">
            <thead class="table-light">
                <tr>
                    <th>Exam Code</th>
                    <th>Examination Title</th>
                    <th>Academic Session</th>
                    <th>Exam Period</th>
                    <th>Application Deadline</th>
                    <th>Fee</th>
                    <th>Applicants</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ex in Model)
                {
                    <tr>
                        <td class="pu-code-cell"><strong class="text-primary pu-code">@ex.ExamCode</strong></td>
                        <td class="pu-title-cell">
                            <div class="fw-bold text-dark pu-title">@ex.ExamName</div>
                            <small class="text-muted pu-sub">Type: @ex.ExamType</small>
                        </td>
                        <td data-label="Academic session">@ex.AcademicYearName &bull; @ex.SemesterName</td>
                        <td data-label="Exam period" class="pu-nowrap">
                            <div>@ex.StartDate.ToString("MMM dd") - @ex.EndDate.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td data-label="Application deadline">
                            <span class="badge bg-warning text-dark pu-deadline">@ex.ApplicationDeadline.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td data-label="Fee" class="fw-bold text-success pu-fee">NPR @ex.FeeAmount.ToString("N0")</td>
                        <td data-label="Applicants">
                            <span class="badge bg-secondary fs-6 pu-count">@ex.TotalApplicants</span>
                        </td>
                        <td data-label="Status">
                            <span data-status="@ex.Status" class="badge pu-status @(ex.Status == "Ongoing" ? "bg-primary" : ex.Status == "ResultPublished" ? "bg-success" : ex.Status == "Upcoming" ? "bg-warning text-dark" : "bg-dark") px-2 py-1">
                                @System.Text.RegularExpressions.Regex.Replace(ex.Status ?? "", "(?<=[a-z])(?=[A-Z])", " ")
                            </span>
                        </td>
                        <td class="text-end pu-actions-cell">
                            <div class="pu-actions">
                                <a asp-action="Applications" asp-route-examId="@ex.ExaminationId" title="Applications" aria-label="Applications" class="btn btn-sm btn-outline-primary fw-bold me-1">
                                    <i class="fa-solid fa-id-card"></i><span class="pu-btn-label">Applications</span>
                                </a>
                                <a asp-controller="AdminMarks" asp-action="Index" asp-route-examId="@ex.ExaminationId" title="Marks" aria-label="Marks" class="btn btn-sm btn-outline-warning text-dark fw-bold me-1">
                                    <i class="fa-solid fa-marker"></i><span class="pu-btn-label">Marks</span>
                                </a>
                                <a asp-controller="AdminResult" asp-action="ViewLedger" asp-route-examId="@ex.ExaminationId" title="Results" aria-label="Results" class="btn btn-sm btn-outline-success fw-bold">
                                    <i class="fa-solid fa-square-poll-vertical"></i><span class="pu-btn-label">Results</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="pu-empty">
                            <i class="fa-regular fa-calendar-xmark"></i>
                            <strong>No examination sessions yet</strong>
                            Use "Create Examination Session" to add the first one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>