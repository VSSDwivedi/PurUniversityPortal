@model List<ExaminationApplication>
@{
    ViewData["Title"] = "Examination Applications & Admit Cards";
    Layout = "_AdminLayout";
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
    var colleges = ViewBag.Colleges as List<College> ?? new List<College>();
    var centers = ViewBag.Centers as List<ExaminationCenter> ?? new List<ExaminationCenter>();
    int? selExam = ViewBag.SelectedExam;
    int? selCol = ViewBag.SelectedCollege;
    string? selStatus = ViewBag.SelectedStatus; bool isCollegeAdmin = ViewBag.IsCollegeAdmin ?? false;
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-id-card text-primary"></i> Examination Applications & Admit Card Console</h5>
        <div class="d-flex gap-2">
            @if (selExam.HasValue)
            {
                <form asp-action="BulkGenerateAdmitCards" method="post" class="d-inline" onsubmit="return confirm('Generate official admit cards and assign sequential roll numbers to all approved candidates?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@selExam.Value" />
                    <input type="hidden" name="collegeId" value="@selCol" />
                    <button type="submit" class="btn btn-warning btn-sm fw-bold shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Bulk Generate Admit Cards
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- Filter Form -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="examId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Examinations --</option>
                    @foreach (var ex in exams)
                    {
                        <option value="@ex.ExaminationId" selected="@(selExam == ex.ExaminationId)">@ex.ExamName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                @if (isCollegeAdmin)
                {
                    <select class="form-select form-select-sm" disabled>
                        @foreach (var c in colleges)
                        {
                            <option value="@c.CollegeId" selected="@(selCol == c.CollegeId)">@c.CollegeName</option>
                        }
                    </select>
                    <input type="hidden" name="collegeId" value="@selCol" />
                }
                else
                {
                    <select name="collegeId" class="form-select form-select-sm">
                        <option value="">-- All Colleges --</option>
                        @foreach (var c in colleges)
                        {
                            <option value="@c.CollegeId" selected="@(selCol == c.CollegeId)">@c.CollegeName</option>
                        }
                    </select>
                }
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Statuses --</option>
                    <option value="Approved" selected="@(selStatus == "Approved")">Approved</option>
                    <option value="Pending" selected="@(selStatus == "Pending")">Pending</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <a asp-action="Applications" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    <!-- Applications Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Application No</th>
                    <th>Candidate</th>
                    <th>Reg No</th>
                    <th>Exam / Session</th>
                    <th>College</th>
                    <th>Assigned Roll No</th>
                    <th>Center</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var a in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@a.ApplicationNumber</strong></td>
                            <td>
                                <div class="fw-bold text-dark">@a.StudentName</div>
                                <small class="text-muted">Type: @a.ExamType</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.RegistrationNumber))
                                {
                                    <span class="badge bg-secondary">@a.RegistrationNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Pending Reg</span>
                                }
                            </td>
                            <td>
                                <div>@a.ExamName</div>
                                <small class="text-muted">@a.ProgramName &bull; @a.SemesterName</small>
                            </td>
                            <td><small>@a.CollegeName</small></td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.AssignedRollNumber))
                                {
                                    <span class="badge bg-danger fs-6">@a.AssignedRollNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Unassigned</span>
                                }
                            </td>
                            <td><small>@(a.CenterName ?? "Not Assigned")</small></td>
                            <td>
                                <span class="badge @(a.Status == "Approved" ? "bg-success" : a.Status == "Pending" ? "bg-warning text-dark" : "bg-danger") px-2 py-1">
                                    @a.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#admitModal-@a.ApplicationId">
                                    <i class="fa-solid fa-id-card me-1"></i> Admit Card
                                </button>
                            </td>
                        </tr>
                        <div class="modal fade" id="admitModal-@a.ApplicationId" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <form asp-action="GenerateAdmitCard" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="applicationId" value="@a.ApplicationId" />
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold">Admit Card & Roll Number Allocation</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Candidate</label>
                                                <input type="text" class="form-control" value="@a.StudentName" disabled />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Assigned Roll Number *</label>
                                                <input type="text" name="rollNumber" value="@(string.IsNullOrEmpty(a.AssignedRollNumber) ? $"24{a.ExaminationId}{a.StudentId:D4}" : a.AssignedRollNumber)" class="form-control" required />
                                                <small class="text-muted">Unique roll number printed on answer scripts and admit card</small>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-bold">Examination Test Center *</label>
                                                <select name="centerId" class="form-select" required>
                                                    @foreach (var ctr in centers)
                                                    {
                                                        <option value="@ctr.CenterId" selected="@(a.ExaminationCenterId == ctr.CenterId)">
                                                            @ctr.CenterName (@ctr.Location)
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                            @if (!string.IsNullOrEmpty(a.PaymentVoucherUrl))
                                            {
                                                <div class="mb-3">
                                                    <label class="form-label small fw-bold">Payment Voucher</label>
                                                    <div>
                                                        <a href="@a.PaymentVoucherUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                                            <i class="fa-solid fa-eye me-1"></i> View Deposited Voucher
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary btn-sm fw-bold">
                                                <i class="fa-solid fa-check me-1"></i> Approve & Generate Card
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">No examination applications matching the criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
