@model List<ExaminationCenter>
@{
    ViewData["Title"] = "Examination Test Centers";
    Layout = "_AdminLayout";
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-building-flag text-primary"></i> University Examination Test Centers</h5>
        <button class="btn btn-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addCenterModal">
            <i class="fa-solid fa-plus me-1"></i> Add Test Center
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Center Code</th>
                    <th>Center Name</th>
                    <th>Location / Campus</th>
                    <th>Capacity</th>
                    <th>Superintendent</th>
                    <th>Contact Phone</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@c.CenterCode</strong></td>
                        <td class="fw-bold text-dark">@c.CenterName</td>
                        <td><i class="fa-solid fa-location-dot text-danger me-1"></i> @c.Location</td>
                        <td><span class="badge bg-secondary">@c.Capacity Seats</span></td>
                        <td>@(c.SuperintendentName ?? "-")</td>
                        <td>@(c.ContactNumber ?? "-")</td>
                        <td>
                            <span class="badge @(c.IsActive ? "bg-success" : "bg-danger")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Center Modal -->
<div class="modal fade" id="addCenterModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddCenter" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Examination Center</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Center Code (e.g. CTR-05) *</label>
                        <input type="text" name="CenterCode" class="form-control" placeholder="e.g. CTR-05" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Center Name *</label>
                        <input type="text" name="CenterName" class="form-control" placeholder="e.g. Western Regional Hall" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Location *</label>
                        <input type="text" name="Location" class="form-control" placeholder="e.g. Pokhara-15" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Seat Capacity</label>
                            <input type="number" name="Capacity" value="500" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Contact Phone</label>
                            <input type="text" name="ContactNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Center Superintendent</label>
                        <input type="text" name="SuperintendentName" class="form-control" placeholder="Dr. / Er. Name" />
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Create Center</button>
                </div>
            </form>
        </div>
    </div>
</div>
