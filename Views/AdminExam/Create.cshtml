@model Examination
@{
    ViewData["Title"] = "Create Examination Session";
    Layout = "_AdminLayout";
    var academicYears = ViewBag.AcademicYears as List<AcademicYear> ?? new List<AcademicYear>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    var faculties = ViewBag.Faculties as List<Faculty> ?? new List<Faculty>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var centers = ViewBag.Centers as List<ExaminationCenter> ?? new List<ExaminationCenter>();
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="custom-card shadow-sm">
            <div class="card-header-custom">
                <h5><i class="fa-solid fa-calendar-plus text-primary"></i> Create University Examination Session</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </div>

            <div class="p-4 p-md-5">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-4"></div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">1. Examination Identification</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="ExamCode" class="form-label small fw-bold">Exam Code (e.g. EXAM-SPRING-2026) *</label>
                            <input asp-for="ExamCode" class="form-control" placeholder="e.g. EXAM-SPRING-2026" required />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="ExamName" class="form-label small fw-bold">Official Examination Title *</label>
                            <input asp-for="ExamName" class="form-control" placeholder="e.g. Spring 2026 Semester End Examination" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AcademicYearId" class="form-label small fw-bold">Academic Session *</label>
                            <select asp-for="AcademicYearId" class="form-select" required>
                                @foreach (var ay in academicYears)
                                {
                                    <option value="@ay.AcademicYearId" selected="@ay.IsCurrent">@ay.YearName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SemesterId" class="form-label small fw-bold">Target Semester *</label>
                            <select asp-for="SemesterId" class="form-select" required>
                                @foreach (var sem in semesters)
                                {
                                    <option value="@sem.SemesterId">@sem.SemesterName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExamType" class="form-label small fw-bold">Exam Category *</label>
                            <select asp-for="ExamType" class="form-select" required>
                                <option value="Regular">Regular Examination</option>
                                <option value="Back">Backlog / Retake</option>
                                <option value="Chance">Chance / Make-up</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">2. Important Dates & Deadlines</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label small fw-bold">Examination Start Date *</label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label small fw-bold">Examination Concluding Date *</label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ApplicationDeadline" class="form-label small fw-bold">Online Application Deadline *</label>
                            <input asp-for="ApplicationDeadline" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LateFeeDeadline" class="form-label small fw-bold">Late Fee Application Deadline</label>
                            <input asp-for="LateFeeDeadline" type="date" class="form-control" />
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">3. Fees & Default Center Allocation</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="FeeAmount" class="form-label small fw-bold">Examination Regular Fee (NPR) *</label>
                            <input asp-for="FeeAmount" type="number" step="50" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LateFeeAmount" class="form-label small fw-bold">Late Penalty Fee (NPR)</label>
                            <input asp-for="LateFeeAmount" type="number" step="50" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DefaultCenterId" class="form-label small fw-bold">Default Center Allocation</label>
                            <select asp-for="DefaultCenterId" class="form-select">
                                <option value="">-- Allocated by Student/College --</option>
                                @foreach (var ctr in centers)
                                {
                                    <option value="@ctr.CenterId">@ctr.CenterName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Status" value="Upcoming" />
                    <input type="hidden" asp-for="IsActive" value="true" />

                    <div class="text-end border-top pt-4">
                        <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                            <i class="fa-solid fa-check me-1"></i> Launch Examination Session
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
