@model MarksEntryViewModel
@{
    ViewData["Title"] = "Marks Entry & Evaluation Console";
    Layout = "_AdminLayout";
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    var subjects = ViewBag.Subjects as List<Subject> ?? new List<Subject>();
    var colleges = ViewBag.Colleges as List<College> ?? new List<College>();
    int? selExam = ViewBag.SelectedExam;
    int? selProg = ViewBag.SelectedProgram;
    int? selSem = ViewBag.SelectedSemester;
    int? selSub = ViewBag.SelectedSubject;
    int? selCol = ViewBag.SelectedCollege;
}

<!-- Selection Header Card -->
<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-marker text-primary"></i> Examination Marks Entry & Assessment</h5>
        <div class="d-flex gap-2">
            @if (selExam.HasValue && selSub.HasValue)
            {
                <a asp-action="ExportTemplate" asp-route-examId="@selExam.Value" asp-route-subjectId="@selSub.Value" asp-route-collegeId="@selCol" class="btn btn-outline-success btn-sm fw-bold">
                    <i class="fa-solid fa-file-excel me-1"></i> Download Excel Template
                </a>
                <button type="button" class="btn btn-outline-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                    <i class="fa-solid fa-file-import me-1"></i> Bulk Excel Import
                </button>
            }
        </div>
    </div>

    <!-- Matrix Selector Form -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">EXAMINATION SESSION *</label>
                <select name="examId" class="form-select form-select-sm" required>
                    <option value="">-- Select Examination --</option>
                    @foreach (var ex in exams)
                    {
                        <option value="@ex.ExaminationId" selected="@(selExam == ex.ExaminationId)">@ex.ExamName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">PROGRAM *</label>
                <select name="programId" class="form-select form-select-sm" required onchange="this.form.submit()">
                    <option value="">-- Select Program --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p.ProgramId" selected="@(selProg == p.ProgramId)">@p.ProgramName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">SEMESTER *</label>
                <select name="semesterId" class="form-select form-select-sm" required onchange="this.form.submit()">
                    <option value="">-- Semester --</option>
                    @foreach (var s in semesters)
                    {
                        <option value="@s.SemesterId" selected="@(selSem == s.SemesterId)">@s.SemesterName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">SUBJECT / PAPER *</label>
                <select name="subjectId" class="form-select form-select-sm" required>
                    <option value="">-- Select Subject --</option>
                    @foreach (var sub in subjects)
                    {
                        <option value="@sub.SubjectId" selected="@(selSub == sub.SubjectId)">@sub.SubjectCode - @sub.SubjectName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">&nbsp;</label>
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="fa-solid fa-list-check me-1"></i> Load Students
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Subject != null && Model.Rows.Any())
{
    var isLocked = Model.Rows.All(r => r.Status == "Locked");
    <div class="custom-card shadow-sm">
        <div class="card-header-custom">
            <div>
                <h5 class="mb-0 text-primary">
                    Marks Sheet: @Model.Subject.SubjectCode &bull; @Model.Subject.SubjectName
                </h5>
                <small class="text-muted">
                    Full Marks: @Model.Subject.FullMarks &bull;
                    Pass Marks: @Model.Subject.PassMarks &bull;
                    Theory Internal: @Model.Subject.InternalMarks &bull;
                    Theory External: @Model.Subject.ExternalMarks &bull;
                    Practical: @Model.Subject.PracticalMarks
                </small>
            </div>
            <div>
                @if (isLocked)
                {
                    <span class="badge bg-danger fs-6 px-3 py-2"><i class="fa-solid fa-lock me-1"></i> Marks Locked</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="fa-solid fa-pen-nib me-1"></i> Editable</span>
                }
            </div>
        </div>

        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ExaminationId" />
            <input type="hidden" asp-for="ProgramId" />
            <input type="hidden" asp-for="SemesterId" />
            <input type="hidden" asp-for="SubjectId" />
            <input type="hidden" asp-for="CollegeId" />

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">S.N.</th>
                            <th style="width: 130px;">Roll Number</th>
                            <th class="text-start">Candidate Name</th>
                            <th style="width: 80px;">Absent?</th>
                            <th style="width: 120px;">Internal (@Model.Subject.InternalMarks)</th>
                            <th style="width: 120px;">External (@Model.Subject.ExternalMarks)</th>
                            <th style="width: 120px;">Practical (@Model.Subject.PracticalMarks)</th>
                            <th style="width: 100px;">Total</th>
                            <th style="width: 80px;">Grade</th>
                            <th style="width: 90px;">Grade Pt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            <tr class="marks-row" data-index="@i">
                                <td>@(i + 1)</td>
                                <td class="fw-bold text-danger">
                                    <input type="hidden" name="Rows[@i].StudentId" value="@row.StudentId" />
                                    <input type="hidden" name="Rows[@i].RollNumber" value="@row.RollNumber" />
                                    <input type="hidden" name="Rows[@i].RegistrationNumber" value="@row.RegistrationNumber" />
                                    <input type="hidden" name="Rows[@i].StudentName" value="@row.StudentName" />
                                    <input type="hidden" name="Rows[@i].Status" value="@row.Status" />
                                    @row.RollNumber
                                </td>
                                <td class="text-start fw-bold text-dark">@row.StudentName</td>
                                <td>
                                    <input type="checkbox" name="Rows[@i].IsAbsent" value="true" class="form-check-input chk-absent"
                                           checked="@row.IsAbsent" @(isLocked ? "disabled" : "") />
                                </td>
                                <td>
                                    <input type="number" step="0.5" max="@Model.Subject.InternalMarks" min="0"
                                           name="Rows[@i].InternalMarks" value="@row.InternalMarks"
                                           class="form-control form-control-sm text-center inp-internal"
                                           @(isLocked ? "readonly" : "") />
                                </td>
                                <td>
                                    <input type="number" step="0.5" max="@Model.Subject.ExternalMarks" min="0"
                                           name="Rows[@i].ExternalMarks" value="@row.ExternalMarks"
                                           class="form-control form-control-sm text-center inp-external"
                                           @(isLocked ? "readonly" : "") />
                                </td>
                                <td>
                                    <input type="number" step="0.5" max="@Model.Subject.PracticalMarks" min="0"
                                           name="Rows[@i].PracticalMarks" value="@row.PracticalMarks"
                                           class="form-control form-control-sm text-center inp-practical"
                                           @(isLocked || Model.Subject.PracticalMarks == 0 ? "readonly" : "") />
                                </td>
                                <td class="fw-bold fs-6 text-primary total-marks-cell">@row.TotalMarks.ToString("F1")</td>
                                <td>
                                    <span class="badge @(row.Grade == "F" ? "bg-danger" : "bg-success") grade-badge">@row.Grade</span>
                                </td>
                                <td class="fw-bold grade-point-cell">@row.GradePoint.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!isLocked)
            {
                <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Total Candidates: <strong>@Model.Rows.Count</strong></span>
                    <div class="d-flex gap-2">
                        <button type="submit" name="actionType" value="Draft" class="btn btn-secondary fw-bold px-4">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save as Draft
                        </button>
                        <button type="submit" name="actionType" value="Submit" class="btn btn-primary fw-bold px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> Submit for Approval
                        </button>
                    </div>
                </div>
            }
        </form>

        @if (!isLocked)
        {
            <div class="p-3 bg-white border-top text-end">
                <form asp-action="ApproveAndLock" method="post" class="d-inline" onsubmit="return confirm('Locking marks will freeze all inputs permanently and allow final result calculation. Proceed?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@Model.ExaminationId" />
                    <input type="hidden" name="subjectId" value="@Model.SubjectId" />
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="fa-solid fa-lock me-1"></i> Final Approve & Lock Marks
                    </button>
                </form>
            </div>
        }
    </div>
}
else if (selExam.HasValue && selSub.HasValue)
{
    <div class="custom-card p-5 text-center text-muted">
        <i class="fa-solid fa-users-slash fa-3x mb-3 text-secondary"></i>
        <h5>No Candidates Enrolled for this Subject</h5>
        <p>No students have submitted approved examination applications for this subject in the selected exam session.</p>
    </div>
}

<!-- Bulk Import Modal -->
<div class="modal fade" id="importExcelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Import" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="examId" value="@(selExam ?? 0)" />
                <input type="hidden" name="subjectId" value="@(selSub ?? 0)" />
                <input type="hidden" name="collegeId" value="@selCol" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Import Marks from Spreadsheet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">Upload completed Excel workbook (.xlsx). You can download the pre-filled format template first.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Select Excel Spreadsheet (.xlsx) *</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold">Upload & Import</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Automatic Dynamic Grade and Total Marks Calculation in Browser
        function calculateGrade(total) {
            if (total >= 90) return { grade: 'A', pt: '4.00' };
            if (total >= 85) return { grade: 'A-', pt: '3.70' };
            if (total >= 80) return { grade: 'B+', pt: '3.30' };
            if (total >= 75) return { grade: 'B', pt: '3.00' };
            if (total >= 70) return { grade: 'B-', pt: '2.70' };
            if (total >= 65) return { grade: 'C+', pt: '2.30' };
            if (total >= 60) return { grade: 'C', pt: '2.00' };
            if (total >= 55) return { grade: 'C-', pt: '1.70' };
            if (total >= 50) return { grade: 'D+', pt: '1.30' };
            if (total >= 45) return { grade: 'D', pt: '1.00' };
            return { grade: 'F', pt: '0.00' };
        }

        $('.marks-row').each(function() {
            var row = $(this);
            var internalInp = row.find('.inp-internal');
            var externalInp = row.find('.inp-external');
            var practicalInp = row.find('.inp-practical');
            var absentChk = row.find('.chk-absent');
            var totalCell = row.find('.total-marks-cell');
            var gradeBadge = row.find('.grade-badge');
            var pointCell = row.find('.grade-point-cell');

            function updateRow() {
                if (absentChk.is(':checked')) {
                    totalCell.text('0.0');
                    gradeBadge.text('ABS').removeClass('bg-success').addClass('bg-danger');
                    pointCell.text('0.00');
                    return;
                }

                var internal = parseFloat(internalInp.val()) || 0;
                var external = parseFloat(externalInp.val()) || 0;
                var practical = parseFloat(practicalInp.val()) || 0;
                var total = internal + external + practical;

                totalCell.text(total.toFixed(1));
                var res = calculateGrade(total);
                gradeBadge.text(res.grade);
                if (res.grade === 'F') {
                    gradeBadge.removeClass('bg-success').addClass('bg-danger');
                } else {
                    gradeBadge.removeClass('bg-danger').addClass('bg-success');
                }
                pointCell.text(res.pt);
            }

            internalInp.on('input', updateRow);
            externalInp.on('input', updateRow);
            practicalInp.on('input', updateRow);
            absentChk.on('change', updateRow);
        });
    </script>
}
