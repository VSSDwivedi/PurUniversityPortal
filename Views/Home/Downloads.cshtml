@{
    ViewData["Title"] = "Downloads - Purbanchal University";
    ViewData["IsInnerPage"] = true;
}

<style>
    .ui-state-error {
        padding-left: 10px;
        display: none;
    }

    header#header {
        background: rgba(21, 34, 43, 0.85);
        padding: 10px 0;
    }

    .section-title {
        margin-top: 1%;
    }

    .list-group.small.mb-4.pb-1 {
        border-radius: 0px !important;
    }

    .dl-list {
        --dl-navy: #0b2a5b;
        --dl-blue: #003980;
        --dl-gold: #f2b705;
        --dl-paper: #f4f6fb;
        --dl-ink: #1b2430;
        --dl-muted: #5b6678;
        --dl-line: #dde3ee;
        --dl-pdf: #c0392b;
        font-feature-settings: "tnum" 1;
    }

        .dl-list.list-group {
            border: 1px solid var(--dl-line);
            border-top: 4px solid var(--dl-gold);
            border-radius: 10px !important;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 1px 2px rgba(11, 42, 91, .06);
        }

        .dl-list .dl-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border: 0;
            border-bottom: 1px solid var(--dl-line);
            border-radius: 0;
            background: #fff;
            transition: background-color .15s ease;
        }

            .dl-list .dl-item:last-child {
                border-bottom: 0;
            }

            .dl-list .dl-item:hover {
                background: #eef3fb;
            }

        .dl-list .dl-title {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: .85rem;
            margin: 0;
            font-size: .98rem;
            font-weight: 700;
            line-height: 1.35;
            letter-spacing: .01em;
            color: var(--dl-navy) !important;
            text-decoration: none;
        }

            .dl-list .dl-title:hover {
                color: var(--dl-blue) !important;
                text-decoration: underline;
            }

        .dl-list .dl-icon {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.4rem;
            height: 2.4rem;
            border-radius: 8px;
            background: #fdecea;
            color: var(--dl-pdf);
            font-size: 1.25rem;
        }

        .dl-list .dl-size {
            flex: 0 0 6.5rem;
            text-align: right;
            font-size: .85rem;
            font-weight: 600;
            color: var(--dl-muted) !important;
            white-space: nowrap;
        }

        .dl-list .dl-actions {
            flex: 0 0 auto;
            display: flex;
            gap: .5rem;
        }

            .dl-list .dl-actions .btn {
                display: inline-flex;
                align-items: center;
                gap: .4rem;
                margin: 0 !important;
                padding: .45rem .9rem;
                border-radius: 8px;
                font-weight: 600;
                font-size: .82rem;
                white-space: nowrap;
                transition: background-color .15s ease, color .15s ease, border-color .15s ease;
            }

            .dl-list .dl-actions .dl-view {
                background: #fff;
                color: var(--dl-blue);
                border: 1.5px solid var(--dl-blue);
            }

                .dl-list .dl-actions .dl-view:hover {
                    background: var(--dl-blue);
                    color: #fff;
                }

            .dl-list .dl-actions .dl-get {
                background: var(--dl-navy);
                color: #fff;
                border: 1.5px solid var(--dl-navy);
            }

                .dl-list .dl-actions .dl-get:hover {
                    background: var(--dl-gold);
                    border-color: var(--dl-gold);
                    color: var(--dl-navy);
                }

            .dl-list .dl-actions .btn:focus-visible,
            .dl-list .dl-title:focus-visible {
                outline: 3px solid var(--dl-blue);
                outline-offset: 2px;
            }

    .dl-pagination .page-link {
        color: #003980;
        border-color: #dde3ee;
        border-radius: 6px;
        margin: 0 .15rem;
        font-weight: 600;
    }

    .dl-pagination .page-item.active .page-link {
        background: #0b2a5b;
        border-color: #0b2a5b;
        color: #fff;
    }

    .dl-pagination .page-item.disabled .page-link {
        color: #8a94a6;
        background: #f4f6fb;
    }

    @@media (max-width: 767.98px) {
        .dl-list .dl-item {
            flex-wrap: wrap;
            gap: .6rem 1rem;
            padding: .9rem 1rem;
        }

        .dl-list .dl-title {
            flex: 1 1 100%;
        }

        .dl-list .dl-size {
            flex: 1 1 auto;
            text-align: left;
            padding-left: 3.25rem;
        }

        .dl-list .dl-actions {
            flex: 0 0 auto;
        }
    }
</style>

