@model UniversityExamSystem.Models.Notice
@{
    ViewData["Title"] = Model.Title + " - Purbanchal University";
    ViewData["IsInnerPage"] = true;
    var related = ViewBag.RelatedEvents as List<UniversityExamSystem.Models.Notice> ?? new List<UniversityExamSystem.Models.Notice>();
}

<style>
    header#header {
        background: rgba(21, 34, 43, 0.85);
        padding: 10px 0;
    }
    .section-title {
        margin-top: 1%;
    }
</style>

<main id="main">
    <section id="events" class="events">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Exam Event</h2>
            </div>

            <article class="notice-list mt-0 mb-5 p-4 bg-white shadow-sm border rounded">
                <div class="notice-list__inner">
                    <h3 class="fw-bold mb-3 text-dark">@Model.Title</h3>
                    <p class="lead text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Examination circular, routines, and official guidelines from Purbanchal University Office of Examination Management, Biratnagar." : Model.Description)</p>
                    <div class="meta-content small mt-3 pt-3 border-top d-flex gap-4">
                        <span class="text-muted"><i class="bi bi-calendar-check me-1 text-primary"></i> @Model.PublishDate.ToString("yyyy-MM-dd")</span>
                        <span class="text-muted"><i class="bi bi-tag me-1 text-success"></i> @(Model.CategoryName ?? "Examination")</span>
                        @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
                        {
                            <span>
                                <i class="bi bi-cloud-arrow-down text-danger me-1"></i>
                                <a href="@Model.AttachmentUrl" target="_blank" class="fw-bold text-danger">Download Attached Circular (PDF)</a>
                            </span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
                {
                    <div class="mt-4 border rounded p-2 bg-light">
                        <object data="@Model.AttachmentUrl" type="application/pdf" width="100%" height="600">
                            <p class="text-center py-3">
                                Your browser cannot display embedded PDFs.
                                <a href="@Model.AttachmentUrl" target="_blank" class="btn btn-sm btn-primary">Click to view/download PDF</a>
                            </p>
                        </object>
                    </div>
                }
            </article>

            <h3 class="mb-4 text-primary">Related Events</h3>

            <div class="row">
                @foreach (var item in related)
                {
                    <div class="col-md-4 mb-5">
                        <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
                            <div class="card-header bg-white fw-bold">@item.Title</div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <p class="card-text text-muted small">@item.PublishDate.ToString("yyyy-MM-dd")</p>
                                <a href="/exam-event-new/@item.NoticeId" class="btn btn-sm btn-primary mt-2">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</main>