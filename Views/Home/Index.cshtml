<script>
document.addEventListener('DOMContentLoaded', function () {
    var form       = document.getElementById('contactUsForm');
    var nameInput  = document.getElementById('name');
    var emailInput = document.getElementById('email');
    var nameError  = document.getElementById('nameError');
    var emailError = document.getElementById('emailError');

    var nameRegex  = /^[A-Za-z]+(?:[ .'\-][A-Za-z]+)*$/;
    var emailRegex = /^[a-z0-9._%+\-]+@@[a-z0-9\-]+(\.[a-z0-9\-]+)*\.[a-z]{2,}$/;

    function showError(input, errorEl, show) {
        errorEl.classList.toggle('d-none', !show);
        input.classList.toggle('is-invalid', show);
    }

    nameInput.addEventListener('input', function () {
        this.value = this.value
            .replace(/[^A-Za-z .'\-]/g, '')   
            .replace(/\s{2,}/g, ' ')
            .replace(/^[\s.'\-]+/, '');
        showError(this, nameError, false);
    });

    nameInput.addEventListener('blur', function () {
        this.value = this.value
            .trim()
            .toLowerCase()
            .replace(/(^|[ .'\-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
    });

    emailInput.addEventListener('input', function () {
        this.value = this.value
            .replace(/\s/g, '')
            .replace(/[^A-Za-z0-9._%+\-@@]/g, '')
            .toLowerCase();
        showError(this, emailError, false);
    });

    emailInput.addEventListener('blur', function () {
        this.value = this.value.trim().toLowerCase();
        if (this.value && !emailRegex.test(this.value)) {
            showError(this, emailError, true);
        }
    });

    form.addEventListener('submit', function (e) {
        var valid = true;
        var firstBad = null;

        nameInput.value  = nameInput.value.trim();
        emailInput.value = emailInput.value.trim().toLowerCase();

        if (nameInput.value.length < 2 || !nameRegex.test(nameInput.value)) {
            showError(nameInput, nameError, true);
            valid = false;
            firstBad = firstBad || nameInput;
        }

        if (!emailRegex.test(emailInput.value) || emailInput.value.indexOf('..') !== -1) {
            showError(emailInput, emailError, true);
            valid = false;
            firstBad = firstBad || emailInput;
        }

        if (!valid) {
            e.preventDefault();
            e.stopImmediatePropagation();
            firstBad.focus();
            return;
        }

        if (!form.checkValidity()) {   
            e.preventDefault();
            e.stopImmediatePropagation();
            form.reportValidity();
        }
    });
});
</script>
</main>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(document).off('click', '.notice-tab-section');
            $(".notice-tab-section").click(function () {
                var category = $(this).data('type');
                var posturl = '/home/getNoticeGroupBy/' + category + '?limit=10&off=0';
                $.post(posturl, {}, function (response) {
                    $('#' + category + '-list').html(response);
                });
            });
            $("#contactUsForm").on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                $.post(form.attr('action'), form.serialize(), function (res) {
                    Swal.fire({
                        icon: res.type || 'success',
                        title: 'Success',
                        text: res.message || 'Your inquiry has been submitted.'
                    });
                    form[0].reset();
                }).fail(function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred. Please try again.'
                    });
                });
            });
        });
    </script>
}
