                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <input type="text"
                                   name="name"
                                   class="form-control"
                                   id="name"
                                   placeholder="Your Name"
                                   minlength="2"
                                   maxlength="50"
                                   inputmode="text"
                                   autocomplete="name"
                                   autocapitalize="words"
                                   autocorrect="off"
                                   spellcheck="false"
                                   required>
                            <small class="text-danger d-none" id="nameError">Name can only contain letters (minimum 2 characters).</small>
                        </div>
                        <div class="col-md-6 form-group mt-3 mt-md-0">
                            <input type="email"
                                   class="form-control"
                                   name="email"
                                   id="email"
                                   placeholder="Your Email"
                                   maxlength="100"
                                   inputmode="email"
                                   autocomplete="email"
                                   autocapitalize="none"
                                   autocorrect="off"
                                   spellcheck="false"
                                   required>
                            <small class="text-danger d-none" id="emailError">Please enter a valid email address (e.g. name@example.com).</small>
                        </div>
