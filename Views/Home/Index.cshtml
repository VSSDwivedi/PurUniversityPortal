@section Scripts {
    <script>
        $(document).ready(function () {
            // Notice tabs AJAX
            $(document).off('click', '.notice-tab-section');
            $(".notice-tab-section").click(function () {
                var category = $(this).data('type');
                var posturl = '/home/getNoticeGroupBy/' + category + '?limit=10&off=0';
                $.post(posturl, {}, function (response) {
                    $('#' + category + '-list').html(response);
                });
            });

            // Contact Us AJAX
            $("#contactUsForm").on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                $.post(form.attr('action'), form.serialize(), function (res) {
                    Swal.fire({
                        icon: res.type || 'success',
                        title: 'Success',
                        text: res.message || 'Your inquiry has been submitted.'
                    });
                    form[0].reset();
                }).fail(function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred. Please try again.'
                    });
                });
            });
        });
    </script>
}