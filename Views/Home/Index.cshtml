<main id="main">
    <!-- ======= Notice Board Section ======= -->
    <section id="notices" class="notices" style="padding-bottom:0px;">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Notice</h2>
            </div>

            <ul class="notice-nav nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section active" id="all-notice" data-bs-toggle="tab" data-bs-target="#all-notice-pane" type="button" role="tab" aria-controls="all-notice-pane" data-type="all-notice" aria-selected="true"> ALL </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="exam-registration" data-bs-toggle="tab" data-bs-target="#exam-registration-pane" type="button" role="tab" aria-controls="exam-registration-pane" data-type="exam-registration" aria-selected="false">REGISTRATION</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="exam-form" data-bs-toggle="tab" data-bs-target="#exam-form-pane" type="button" role="tab" aria-controls="exam-form-pane" data-type="exam-form" aria-selected="false">EXAM FORM</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="exam-routine" data-bs-toggle="tab" data-bs-target="#exam-routine-pane" type="button" role="tab" aria-controls="exam-routine-pane" data-type="exam-routine" aria-selected="false">EXAM ROUTINE</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="exam-center" data-bs-toggle="tab" data-bs-target="#exam-center-pane" type="button" role="tab" aria-controls="exam-center-pane" data-type="exam-center" aria-selected="false">EXAM CENTER</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="internal" data-bs-toggle="tab" data-bs-target="#internal-pane" type="button" role="tab" aria-controls="internal-pane" data-type="internal" aria-selected="false">INTERNAL</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="result" data-bs-toggle="tab" data-bs-target="#result-pane" type="button" role="tab" aria-controls="result-pane" data-type="result" aria-selected="false">RESULT</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link notice-tab-section" id="retotaling" data-bs-toggle="tab" data-bs-target="#retotaling-pane" type="button" role="tab" aria-controls="retotaling-pane" data-type="retotaling" aria-selected="false">RETOTALING </button>
                </li>
            </ul>

            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="all-notice-pane" role="tabpanel" aria-labelledby="all-notice" tabindex="0">
                    <ol class="list-group list-group-numbered" id="all-notice-list">
                        @await Html.PartialAsync("_NoticeListItems", notices)
                    </ol>
                </div>

                <div class="tab-pane fade" id="exam-registration-pane" role="tabpanel" aria-labelledby="exam-registration" tabindex="0">
                    <ol class="list-group list-group-numbered" id="exam-registration-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "REGISTRATION" || x.Title.Contains("Registration", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="exam-form-pane" role="tabpanel" aria-labelledby="exam-form" tabindex="0">
                    <ol class="list-group list-group-numbered" id="exam-form-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "EXAM FORM" || x.Title.Contains("Form", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="exam-routine-pane" role="tabpanel" aria-labelledby="exam-routine" tabindex="0">
                    <ol class="list-group list-group-numbered" id="exam-routine-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "EXAM ROUTINE" || x.Title.Contains("Routine", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="exam-center-pane" role="tabpanel" aria-labelledby="exam-center" tabindex="0">
                    <ol class="list-group list-group-numbered" id="exam-center-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "EXAM CENTER" || x.Title.Contains("Center", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="internal-pane" role="tabpanel" aria-labelledby="internal" tabindex="0">
                    <ol class="list-group list-group-numbered" id="internal-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "INTERNAL" || x.Title.Contains("Internal", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="result-pane" role="tabpanel" aria-labelledby="result" tabindex="0">
                    <ol class="list-group list-group-numbered" id="result-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "RESULT" || x.Title.Contains("Result", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>

                <div class="tab-pane fade" id="retotaling-pane" role="tabpanel" aria-labelledby="retotaling" tabindex="0">
                    <ol class="list-group list-group-numbered" id="retotaling-list">
                        @await Html.PartialAsync("_NoticeListItems", notices.Where(x => x.CategoryName == "RETOTALING" || x.Title.Contains("Retotaling", StringComparison.OrdinalIgnoreCase)).ToList())
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- ======= About Section ======= -->
    <section id="about" class="about">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>About Us</h2>
            </div>
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <p class="lead">
                        Purbanchal University was established in 1993 (2050 B.S.) by an Act of Parliament as a public, autonomous institution with the mandate to conduct academic programs aligned with national socio-economic requirements.
                    </p>
                    <p>
                        The <strong>Office of the Examination Management (OEM)</strong> situated in Biratnagar operates with supreme administrative confidentiality and technological rigor. It administers all institutional examinations across 7 faculties, supervises curriculum assessment standards, coordinates with affiliated constituent campuses, and ensures secure result processing and issuance of official credentials.
                    </p>
                </div>
                <div class="col-lg-4 text-center">
                    <img src="/assets/img/college-logo.png" alt="Purbanchal University" class="img-fluid" style="max-height: 150px;">
                    <h5 class="fw-bold text-primary mt-2">PURBANCHAL UNIVERSITY</h5>
                    <small class="text-muted">Biratnagar, Nepal &bull; puexam.edu.np</small>
                </div>
            </div>
        </div>
