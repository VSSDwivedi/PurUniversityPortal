@model Notice
@{
    ViewData["Title"] = Model.Title;
    ViewData["IsInnerPage"] = true;
    var recent = ViewBag.RecentNotices as List<Notice> ?? new List<Notice>();
}

<div class="bg-light border-bottom py-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Notices" class="text-decoration-none">Notices</a></li>
                <li class="breadcrumb-item active text-truncate" style="max-width: 400px;">@Model.Title</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="@(Model.BadgeClass ?? "badge bg-primary")">@(Model.CategoryName ?? "General")</span>
                    @if (Model.IsPinned)
                    {
                        <span class="badge bg-danger"><i class="fa-solid fa-thumbtack me-1"></i> Pinned</span>
                    }
                </div>

                <h2 class="fw-bold text-primary mb-3">@Model.Title</h2>

                <div class="d-flex align-items-center gap-4 text-muted small border-top border-bottom py-2 mb-4">
                    <span><i class="fa-regular fa-calendar-check text-warning me-1"></i> Published: @Model.PublishDate.ToString("MMMM dd, yyyy")</span>
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <span><i class="fa-regular fa-clock text-danger me-1"></i> Valid Till: @Model.ExpiryDate.Value.ToString("MMMM dd, yyyy")</span>
                    }
                    <span><i class="fa-regular fa-eye me-1"></i> @Model.ViewCount Views</span>
                </div>

                <div class="notice-body mb-4" style="line-height: 1.8; font-size: 1.05rem;">
                    @Html.Raw(Model.Description.Replace("\n", "<br/>"))
                </div>

                @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
                {
                    <div class="alert alert-secondary p-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fa-solid fa-file-pdf fa-2x text-danger"></i>
                            <div>
                                <div class="fw-bold text-dark">@(Model.AttachmentFileName ?? "Official_Notice_Attachment.pdf")</div>
                                <small class="text-muted">Official Signed Document &bull; PDF</small>
                            </div>
                        </div>
                        <a href="@Model.AttachmentUrl" target="_blank" class="btn btn-danger fw-bold">
                            <i class="fa-solid fa-download me-1"></i> Download PDF
                        </a>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Notices" class="btn btn-outline-secondary btn-sm">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Notices
                    </a>
                    <button onclick="window.print()" class="btn btn-outline-dark btn-sm">
                        <i class="fa-solid fa-print me-1"></i> Print Notice
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border p-4 mb-4">
                <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-bell text-warning me-2"></i> Recent Notices</h5>
                <div class="list-group list-group-flush">
                    @foreach (var r in recent)
                    {
                        <a asp-action="NoticeDetails" asp-route-id="@r.NoticeId" class="list-group-item list-group-item-action px-0 py-2">
                            <small class="text-muted d-block">@r.PublishDate.ToString("MMM dd, yyyy")</small>
                            <div class="fw-semibold text-dark small">@r.Title</div>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
