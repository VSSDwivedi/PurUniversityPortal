@model List<UniversityExamSystem.Models.Notice>
@{
    ViewData["Title"] = "Result Events - Purbanchal University";
    ViewData["IsInnerPage"] = true;
}

<style>
    header#header {
        background: rgba(21, 34, 43, 0.85);
        padding: 10px 0;
    }
    .section-title {
        margin-top: 1%;
    }
</style>

<main id="main">
    <section id="events" class="events">
        <div class="container" data-aos="fade-up">
            <div class="section-title">
                <h2>Result Announcements</h2>
            </div>

            <h3 class="mb-4 text-primary">Related Events</h3>

            <div class="row">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 mb-5">
                            <div class="card h-100 shadow-sm border-0 border-top border-success border-3">
                                <div class="card-header bg-white fw-bold">@item.Title</div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <p class="card-text text-muted small">
                                        Published: @item.PublishDate.ToString("yyyy-MM-dd")<br />
                                        Official provisional result gazette published by Examination Controller.
                                    </p>
                                    <div class="mt-3">
                                        <a href="/result-event-new/@item.NoticeId" class="btn btn-sm btn-primary">View Details</a>
                                        <a href="/find-results_new" class="btn btn-sm btn-outline-success ms-1">Check Result</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">No result announcements available currently.</p>
                    </div>
                }
            </div>
        </div>
    </section>
</main>