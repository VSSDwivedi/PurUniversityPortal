@{
    ViewData["Title"] = "Registration Submitted";
    Layout = "_AdminLayout";
    var uid = TempData["StudentUniqueId"]?.ToString();
    var appNo = TempData["ApplicationNumber"]?.ToString();
    var name = TempData["StudentName"]?.ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow border-0 rounded-4 text-center p-5">
                <div class="mb-4">
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center shadow" style="width: 80px; height: 80px; font-size: 2.5rem;">
                        <i class="fa-solid fa-check"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-primary mb-2">Registration Submitted Successfully!</h3>
                <p class="text-muted mb-4">
                    Dear <strong>@name</strong>, your student registration application has been received by the Office of the Controller of Examinations.
                </p>

                <div class="bg-light border rounded-3 p-4 mb-4 text-start">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted fw-bold d-block">STUDENT ID</small>
                            <span class="fs-5 fw-bold text-primary">@uid</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted fw-bold d-block">APPLICATION NUMBER</small>
                            <span class="fs-5 fw-bold text-danger">@appNo</span>
                        </div>
                        <div class="col-12 border-top pt-2">
                            <small class="text-muted fw-bold d-block">REGISTRATION STATUS</small>
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6">Pending College & University Verification</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info small text-start mb-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    <strong>Next Steps:</strong> Please preserve your Student ID and Application Number. Your respective college administration will verify your original documents and approve your registration, which will generate your official University Registration Number.
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="TrackRegistration" asp-route-query="@appNo" class="btn btn-outline-primary fw-bold">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Track Status
                    </a>
                    <a asp-action="Login" class="btn btn-primary fw-bold">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Go to Student Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
