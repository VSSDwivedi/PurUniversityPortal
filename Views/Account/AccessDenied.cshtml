@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 p-5 rounded-4">
                <i class="fa-solid fa-ban fa-4x text-danger mb-3"></i>
                <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
                <p class="text-muted mb-4">
                    You do not have the required permissions or role privileges to view this resource.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-house me-1"></i> Public Home
                    </a>
                    <a asp-action="Login" class="btn btn-primary">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
