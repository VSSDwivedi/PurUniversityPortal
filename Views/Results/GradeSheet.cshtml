@model Result
@{
    ViewData["Title"] = "Provisional Grade Sheet - " + Model.RollNumber;
    Layout = null; // Standalone print-ready layout
    var gradeScales = ViewBag.GradeScales as List<GradeScale> ?? new List<GradeScale>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Provisional Grade Sheet - @Model.StudentName (@Model.RollNumber) - Purbanchal University</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: #f1f5f9; padding: 25px 0; font-family: 'Times New Roman', Times, serif; }
        .gradesheet-border {
            border: 3px double #003980;
            padding: 35px;
            position: relative;
            background: #ffffff;
            max-width: 920px;
            margin: 0 auto;
        }
        .gradesheet-title {
            text-transform: uppercase;
            font-size: 1.6rem;
            font-weight: 800;
            color: #003980;
            letter-spacing: 1.5px;
        }
        .gradesheet-subtitle {
            font-size: 1.15rem;
            font-weight: 700;
            color: #ff4a17;
            text-transform: uppercase;
            margin-top: 2px;
        }
        .meta-label { font-weight: bold; color: #333; font-size: 0.95rem; }
        .meta-val { font-weight: 600; color: #000; font-size: 0.95rem; }
        .print-watermark {
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 5rem;
            color: rgba(0, 57, 128, 0.04);
            font-weight: 900;
            pointer-events: none;
            white-space: nowrap;
            text-transform: uppercase;
        }
        @@media print {
            body { background: #ffffff; padding: 0; }
            .gradesheet-border { border: 2px solid #000; padding: 20px; max-width: 100%; box-shadow: none !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="container text-center mb-3 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold me-2 shadow">
            <i class="fa-solid fa-print me-1"></i> Print / Save as PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            Close Window
        </button>
    </div>

    <div class="gradesheet-border shadow">
        <!-- Security Watermark -->
        <div class="print-watermark">PURBANCHAL UNIVERSITY</div>

        <!-- Header -->
        <div class="text-center border-bottom pb-3 mb-3">
            <img src="~/images/pulogobg.png" alt="Purbanchal University" style="max-height: 110px;" class="mb-2" />
            <div class="gradesheet-title">PURBANCHAL UNIVERSITY</div>
            <div class="gradesheet-subtitle">Office of the Examination Management</div>
            <div class="small text-muted fw-bold">Biratnagar, Nepal &bull; puexam.edu.np</div>
            <div class="mt-2">
                <span class="badge bg-dark px-3 py-1 text-uppercase fs-6">Provisional Statement of Marks / Grade Sheet</span>
            </div>
        </div>

        <!-- Grade Sheet Issue Meta -->
        <div class="d-flex justify-content-between align-items-center mb-3 small">
            <div><strong>Grade Sheet No:</strong> @(Model.GradeSheetNumber ?? "PU-GS-2026-" + Model.RollNumber)</div>
            <div><strong>Date of Issue:</strong> @(Model.GradeSheetIssueDate?.ToString("MMMM dd, yyyy") ?? DateTime.Today.ToString("MMMM dd, yyyy"))</div>
        </div>

        <!-- Student Dossier Metadata -->
        <div class="border rounded p-3 mb-3 bg-light">
            <div class="row g-2">
                <div class="col-7">
                    <span class="meta-label">Name of Student:</span> <span class="meta-val text-uppercase text-primary fs-6">@Model.StudentName</span>
                </div>
                <div class="col-5">
                    <span class="meta-label">Roll / Symbol No:</span> <span class="meta-val text-danger fw-bold">@Model.RollNumber</span>
                </div>
                <div class="col-7">
                    <span class="meta-label">Registration No:</span> <span class="meta-val text-primary fw-bold">@Model.RegistrationNumber</span>
                </div>
                <div class="col-5">
                    <span class="meta-label">Semester / Level:</span> <span class="meta-val">@Model.SemesterName</span>
                </div>
                <div class="col-7">
                    <span class="meta-label">Academic Program:</span> <span class="meta-val">@Model.ProgramName (@Model.ProgramCode)</span>
                </div>
                <div class="col-5">
                    <span class="meta-label">Examination:</span> <span class="meta-val">@Model.ExamName</span>
                </div>
                <div class="col-12">
                    <span class="meta-label">Campus / College:</span> <span class="meta-val">@Model.CollegeName</span>
                </div>
            </div>
        </div>

        <!-- Detailed Marks & Grades Table -->
        <table class="table table-bordered table-sm align-middle text-center mb-3">
            <thead class="table-light border-dark">
                <tr>
                    <th style="width: 110px;">Course Code</th>
                    <th class="text-start">Course Title</th>
                    <th style="width: 65px;">Credit</th>
                    <th style="width: 75px;">Internal (40)</th>
                    <th style="width: 75px;">External (60)</th>
                    <th style="width: 75px;">Practical</th>
                    <th style="width: 75px;">Total (100)</th>
                    <th style="width: 65px;">Grade</th>
                    <th style="width: 75px;">Grade Point</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model.Details)
                {
                    <tr>
                        <td class="fw-bold">@sub.SubjectCode</td>
                        <td class="text-start">@sub.SubjectName</td>
                        <td>@sub.CreditHours</td>
                        <td>@sub.InternalMarks.ToString("F1")</td>
                        <td>@sub.ExternalMarks.ToString("F1")</td>
                        <td>@(sub.PracticalMarks > 0 ? sub.PracticalMarks.ToString("F1") : "-")</td>
                        <td class="fw-bold">@sub.TotalMarks.ToString("F1")</td>
                        <td class="fw-bold @(sub.Grade == "F" ? "text-danger" : "text-primary")">@sub.Grade</td>
                        <td>@sub.GradePoint.ToString("F2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="border-dark fw-bold">
                <tr>
                    <td colspan="2" class="text-start">TOTAL CREDITS & MARKS</td>
                    <td>@Model.TotalCreditHours</td>
                    <td colspan="3" class="text-end">Aggregate Obtained:</td>
                    <td>@Model.TotalMarksObtained.ToString("F1")</td>
                    <td colspan="2" class="text-start ps-2">Percentage: @Model.Percentage.ToString("F2")%</td>
                </tr>
            </tfoot>
        </table>

        <!-- Summary Performance Box -->
        <div class="border rounded p-3 mb-3 bg-light d-flex justify-content-between align-items-center">
            <div>
                <span class="me-4"><strong>Semester GPA (SGPA):</strong> <span class="fs-5 text-primary fw-bold">@Model.SGPA.ToString("F2")</span></span>
                <span class="me-4"><strong>Cumulative GPA (CGPA):</strong> <span class="fs-5 text-success fw-bold">@Model.CGPA.ToString("F2")</span></span>
            </div>
            <div>
                <strong>Final Result:</strong> <span class="badge @(Model.ResultStatus == "Passed" ? "bg-success" : "bg-danger") px-3 py-2 fs-6">@Model.ResultStatus.ToUpper()</span>
            </div>
        </div>

        <!-- Grading Legend -->
        <div class="mb-4">
            <small class="fw-bold text-muted d-block mb-1">PURBANCHAL UNIVERSITY 4.0 GRADING SCALE:</small>
            <div class="d-flex flex-wrap gap-2 small text-muted" style="font-size: 0.75rem;">
                @foreach (var g in gradeScales)
                {
                    <span class="border px-2 py-1 rounded bg-white">
                        <strong>@g.Grade</strong>: @g.MinPercentage.ToString("F0")-@g.MaxPercentage.ToString("F0")% (@g.GradePoint.ToString("F1"))
                    </span>
                }
            </div>
        </div>

        <!-- Signatures & QR Code Section -->
        <div class="row align-items-end pt-3">
            <div class="col-4 text-center">
                @if (!string.IsNullOrEmpty(Model.GradeSheetQrCodeBase64))
                {
                    <img src="@Model.GradeSheetQrCodeBase64" alt="Verification QR" style="width: 95px; height: 95px;" class="border p-1" />
                    <div class="text-muted" style="font-size: 0.65rem; margin-top: 2px;">Scan to verify on puexam.edu.np</div>
                }
            </div>
            <div class="col-4 text-center">
                <div class="signature-line" style="border-top: 1px solid #000; margin-bottom: 4px;"></div>
                <strong>Section Officer</strong>
                <div class="text-muted small">Computer & Records Desk</div>
            </div>
            <div class="col-4 text-center">
                <div style="font-family: 'Brush Script MT', cursive; font-size: 1.5rem; color: #003980;">
                    Prof. Dr. Suryanath Adhikari
                </div>
                <div class="signature-line" style="border-top: 1px solid #000; margin-bottom: 4px;"></div>
                <strong>Controller of Examinations</strong>
                <div class="text-muted small">Purbanchal University</div>
            </div>
        </div>
    </div>
</body>
</html>
