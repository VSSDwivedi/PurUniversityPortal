@model ResultSearchViewModel
@{
    ViewData["Title"] = "Find Result - Purbanchal University";
    ViewData["IsInnerPage"] = true;
    var faculties = ViewBag.Faculties as List<Faculty> ?? new List<Faculty>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
}

<!-- Breadcrumb bar -->
<div class="bg-light py-2 border-bottom no-print">
    <div class="container d-flex justify-content-between align-items-center">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Results" asp-action="Index">Results</a></li>
                <li class="breadcrumb-item active" aria-current="page">Find Result</li>
            </ol>
        </nav>
        <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold small text-decoration-none">
            <i class="fa-solid fa-building-columns me-1"></i> College Login
        </a>
    </div>
</div>

<main id="main" class="py-5">
    <div class="container">
        <!-- Section Title -->
        <div class="section-title text-center text-md-start mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h2>Purbanchal University Exam Results</h2>
                    <p class="lead text-muted mb-0">Select faculty, program, semester, exam year and enter your Registration Number or Symbol Number to view the result.</p>
                </div>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">
                    <i class="fa-solid fa-lock me-1"></i> College Login
                </a>
            </div>
        </div>

        <!-- Find Result Form Box (Directly replicating puexam.edu.np/find-results_new) -->
        <div class="result-form-wrapper no-print">
            <form asp-action="Search" method="post" id="find_result">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <!-- Faculty -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <select asp-for="FacultyId" class="form-select" id="facultySelect">
                                <option value="">Select Faculty</option>
                                @foreach (var f in faculties)
                                {
                                    <option value="@f.FacultyId">@f.FacultyName</option>
                                }
                            </select>
                            <label for="facultySelect">FACULTY</label>
                        </div>
                    </div>

                    <!-- Program -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <select asp-for="ProgramId" class="form-select" id="programSelect">
                                <option value="">Select Program</option>
                                @foreach (var p in programs)
                                {
                                    <option value="@p.ProgramId" data-faculty="@p.FacultyId">@p.ProgramName</option>
                                }
                            </select>
                            <label for="programSelect">PROGRAM</label>
                        </div>
                    </div>

                    <!-- Exam Type -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <select asp-for="ExamType" class="form-select" id="exam_type">
                                <option value="">---Select Exam Type---</option>
                                <option value="Regular">Regular</option>
                                <option value="Back">Back</option>
                                <option value="Chance">Chance</option>
                                <option value="Betterment">Betterment</option>
                            </select>
                            <label for="exam_type">EXAM TYPE</label>
                        </div>
                    </div>

                    <!-- Exam Year -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <select asp-for="ExamYear" class="form-select" id="exam_year">
                                <option value="">---Exam Year---</option>
                                <option value="2026" selected>2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                                <option value="2023">2023</option>
                                <option value="2022">2022</option>
                                <option value="2021">2021</option>
                                <option value="2020">2020</option>
                                <option value="2019">2019</option>
                            </select>
                            <label for="exam_year">EXAM YEAR</label>
                        </div>
                    </div>

                    <!-- Symbol Number -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <input asp-for="SymbolNumber" class="form-control" id="symbol_number" placeholder="Enter Symbol Number" />
                            <label for="symbol_number">SYMBOL NUMBER (e.g. 2410101)</label>
                        </div>
                    </div>

                    <!-- Semester / Year -->
                    <div class="col-lg-6">
                        <div class="form-floating">
                            <select asp-for="SemesterYearId" class="form-select" id="semesterYear">
                                <option value="">Semester/Year</option>
                                @foreach (var s in semesters)
                                {
                                    <option value="@s.SemesterId">@s.SemesterName</option>
                                }
                            </select>
                            <label for="semesterYear">SEMESTER / YEAR</label>
                        </div>
                    </div>

                    <!-- Registration Number (Formatted puexam Segmented inputs) -->
                    <div class="col-lg-8">
                        <div class="border rounded p-3 bg-light">
                            <label class="form-label small fw-bold text-uppercase mb-2 text-primary">
                                Registration Number <span class="text-muted fw-normal">[Format: xxx-x-x-xxxxx-xxxx]</span>
                            </label>
                            <div class="d-flex align-items-center gap-1 reg-boxes">
                                <input type="text" asp-for="Rn1" class="form-control reg-box-part" maxlength="3" style="width: 75px;" placeholder="024" />
                                <span class="fw-bold">-</span>
                                <input type="text" asp-for="Rn2" class="form-control reg-box-part" maxlength="1" style="width: 45px;" placeholder="1" />
                                <span class="fw-bold">-</span>
                                <input type="text" asp-for="Rn3" class="form-control reg-box-part" maxlength="2" style="width: 55px;" placeholder="01" />
                                <span class="fw-bold">-</span>
                                <input type="text" asp-for="Rn4" class="form-control reg-box-part" maxlength="5" style="width: 95px;" placeholder="00001" />
                                <span class="fw-bold">-</span>
                                <input type="text" asp-for="Rn5" class="form-control reg-box-part" maxlength="4" style="width: 85px;" placeholder="2024" />
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">Or search directly by Roll Number / Registration No: </small>
                                <input type="text" asp-for="SearchTerm" class="form-control form-control-sm mt-1" placeholder="e.g. 024-1-01-00001-2024 or 2410101" />
                            </div>
                        </div>
                    </div>

                    <!-- Exam Intake -->
                    <div class="col-lg-4">
                        <div class="form-floating mb-3">
                            <select asp-for="ExamIntake" class="form-select" id="exam_intake">
                                <option value="">---Intake---</option>
                                <option value="Spring" selected>Spring</option>
                                <option value="Fall">Fall</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                            <label for="exam_intake">EXAM INTAKE</label>
                        </div>
                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm" id="check_result">
                                <i class="fa-solid fa-magnifying-glass me-2"></i> Submit
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Result Display Section -->
        @if (Model.Searched)
        {
            if (Model.Result != null)
            {
                var r = Model.Result;
                <div class="gradesheet-container shadow" id="gradeSheetContent">
                    <!-- Grade Sheet Header -->
                    <div class="gradesheet-header">
                        <img src="~/images/pulogo.png" alt="Purbanchal University" class="img-fluid" style="max-height: 85px;" />
                        <h2>PURBANCHAL UNIVERSITY</h2>
                        <h3>Office of the Examination Management</h3>
                        <h4>Biratnagar, Nepal</h4>
                        <div class="gradesheet-title-badge">PROVISIONAL STATEMENT OF MARKS / GRADE SHEET</div>
                    </div>

                    <!-- Candidate Academic Info Table -->
                    <div class="gradesheet-student-info">
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td width="20%"><strong>Candidate Name:</strong></td>
                                    <td width="30%" class="text-primary fw-bold fs-6">@r.StudentName</td>
                                    <td width="20%"><strong>Examination:</strong></td>
                                    <td width="30%">@r.ExamName</td>
                                </tr>
                                <tr>
                                    <td><strong>Registration No.:</strong></td>
                                    <td class="fw-bold text-danger">@r.RegistrationNumber</td>
                                    <td><strong>Semester / Level:</strong></td>
                                    <td>@r.SemesterName</td>
                                </tr>
                                <tr>
                                    <td><strong>Roll / Symbol No.:</strong></td>
                                    <td class="fw-bold">@r.RollNumber</td>
                                    <td><strong>Academic Program:</strong></td>
                                    <td class="fw-bold">@r.ProgramName (@r.ProgramCode)</td>
                                </tr>
                                <tr>
                                    <td><strong>Campus / College:</strong></td>
                                    <td colspan="3">@r.CollegeName</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Grades and Marks Table -->
                    <table class="gradesheet-table">
                        <thead>
                            <tr>
                                <th width="12%">Course Code</th>
                                <th width="40%">Course Title</th>
                                <th width="10%">Credit Hours</th>
                                <th width="12%">Total Marks</th>
                                <th width="12%">Grade</th>
                                <th width="14%">Grade Point</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (r.Details != null && r.Details.Any())
                            {
                                @foreach (var item in r.Details)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@item.SubjectCode</td>
                                        <td>@item.SubjectName</td>
                                        <td class="text-center">@item.CreditHours</td>
                                        <td class="text-center">@item.TotalMarks.ToString("0.0")</td>
                                        <td class="text-center fw-bold @(item.Grade == "F" ? "text-danger" : "text-primary")">@item.Grade</td>
                                        <td class="text-center">@item.GradePoint.ToString("0.00")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted">No subject breakdown recorded for this result.</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Academic Summary Strip -->
                    <div class="gradesheet-summary">
                        <div class="row align-items-center text-center">
                            <div class="col-sm-3 col-6 mb-2 mb-sm-0 border-end">
                                <small class="text-muted d-block fw-bold">TOTAL CREDITS</small>
                                <span class="fs-5 fw-bold text-dark">@r.TotalCreditHours</span>
                            </div>
                            <div class="col-sm-3 col-6 mb-2 mb-sm-0 border-end">
                                <small class="text-muted d-block fw-bold">SEMESTER GPA (SGPA)</small>
                                <span class="fs-4 fw-bold text-primary">@r.SGPA.ToString("0.00")</span>
                            </div>
                            <div class="col-sm-3 col-6 border-end">
                                <small class="text-muted d-block fw-bold">CUMULATIVE GPA (CGPA)</small>
                                <span class="fs-4 fw-bold text-success">@r.CGPA.ToString("0.00")</span>
                            </div>
                            <div class="col-sm-3 col-6">
                                <small class="text-muted d-block fw-bold">FINAL RESULT</small>
                                <span class="badge @(r.ResultStatus == "Passed" ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                    @r.ResultStatus.ToUpper()
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Signatures & QR Code Section -->
                    <div class="gradesheet-signatures">
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(r.GradeSheetQrCodeBase64))
                            {
                                <img src="@r.GradeSheetQrCodeBase64" alt="Verification QR Code" style="width: 90px; height: 90px;" class="mb-1 border p-1" />
                                <div class="text-muted" style="font-size: 10px;">Official Online Verification</div>
                            }
                        </div>
                        <div class="signature-box align-self-end">
                            <div class="signature-line"></div>
                            <strong>Prepared & Verified By</strong>
                            <div class="text-muted small">Computer Section, OEM</div>
                        </div>
                        <div class="signature-box align-self-end">
                            <div class="signature-line"></div>
                            <strong>Prof. Dr. Suryanath Adhikari</strong>
                            <div class="text-muted small">Controller of Examinations</div>
                        </div>
                    </div>

                    <!-- Actions Strip (No Print) -->
                    <div class="text-end mt-4 pt-3 border-top no-print d-flex justify-content-between align-items-center">
                        <small class="text-muted">Issue Date: @(r.PublishedDate?.ToString("MMMM dd, yyyy") ?? DateTime.Now.ToString("MMMM dd, yyyy"))</small>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary" onclick="window.print();">
                                <i class="fa-solid fa-print me-1"></i> Print Grade Sheet
                            </button>
                            <a asp-action="GradeSheet" asp-route-id="@r.ResultId" target="_blank" class="btn btn-primary">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Fullscreen Sheet
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center p-4 shadow-sm border border-warning rounded">
                    <i class="fa-solid fa-circle-exclamation text-warning fa-3x mb-3 d-block"></i>
                    <h5 class="fw-bold">Result Not Found</h5>
                    <p class="mb-0">@(Model.Message ?? "No published result matches the requested criteria. Please check your Symbol Number or Registration Number.")</p>
                </div>
            }
        }
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Dynamic filtering of programs based on selected faculty
            $('#facultySelect').on('change', function() {
                var facultyId = $(this).val();
                if (facultyId) {
                    $('#programSelect option').each(function() {
                        var pFac = $(this).data('faculty');
                        if (!pFac || pFac == facultyId) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                } else {
                    $('#programSelect option').show();
                }
            });
        });
    </script>
}
