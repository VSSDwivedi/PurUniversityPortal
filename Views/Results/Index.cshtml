@model ResultSearchViewModel
@{
    ViewData["Title"] = "Find Result - Purbanchal University";
    ViewData["IsInnerPage"] = true;
    var faculties = ViewBag.Faculties as List<Faculty> ?? new List<Faculty>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />

<style>
    .fr {
        --ink: #0f1b3d;
        --ink-2: #4a5878;
        --ink-3: #8592ad;
        --line: #e4e9f2;
        --wash: #f3f6fb;
        --blue: #2150d9;
        --gold: #c8963e;
        --gold-soft: #fbf1dc;
        --red: #b4232c;
        --green: #138a5b;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
        padding: 1.5rem 0 3rem;
    }
        .fr .section-title {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            padding: 2rem 2rem 5.2rem;
            margin-bottom: 0 !important;
            color: #fff;
            background: radial-gradient(900px 300px at 100% 0%, rgba(200,150,62,.28), transparent 60%), repeating-linear-gradient(135deg, rgba(255,255,255,.035) 0 2px, transparent 2px 18px), linear-gradient(115deg, #0b1533 0%, #14265c 55%, #1d3a8c 100%);
        }

            .fr .section-title::after {
                content: "";
                position: absolute;
                right: -70px;
                top: -70px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,.12);
                box-shadow: 0 0 0 34px rgba(255,255,255,.03), 0 0 0 68px rgba(255,255,255,.02);
                pointer-events: none;
            }

            .fr .section-title > * {
                position: relative;
                z-index: 1;
            }

            .fr .section-title h2 {
                font-family: 'Fraunces', Georgia, serif;
                font-weight: 700;
                font-size: clamp(1.55rem, 3vw, 2.3rem);
                letter-spacing: -.01em;
                color: #fff;
                margin-bottom: .6rem;
            }

                .fr .section-title h2::before {
                    content: "";
                    display: block;
                    width: 46px;
                    height: 3px;
                    border-radius: 3px;
                    background: var(--gold);
                    margin-bottom: .9rem;
                }

            .fr .section-title .lead {
                font-size: .95rem;
                line-height: 1.6;
                max-width: 640px;
                color: rgba(255,255,255,.8) !important;
            }

        .fr .result-form-wrapper {
            position: relative;
            z-index: 2;
            margin: -3.2rem 1.25rem 2rem;
            padding: 0;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            box-shadow: 0 24px 48px -24px rgba(15,27,61,.35);
            overflow: hidden;
        }

        .fr .form-head {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: 1.1rem 1.75rem;
            background: linear-gradient(180deg, #fafbfe, #fff);
            border-bottom: 1px solid var(--line);
        }

            .fr .form-head .ico {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                background: #e7edff;
                color: var(--blue);
            }

            .fr .form-head h5 {
                margin: 0;
                font-size: 1.02rem;
                font-weight: 700;
            }

            .fr .form-head p {
                margin: 0;
                font-size: .78rem;
                color: var(--ink-3);
            }

        .fr .result-form-wrapper form {
            padding: 1.5rem 1.75rem 1.75rem;
        }

        .fr .form-floating > .form-control,
        .fr .form-floating > .form-select {
            border: 1.5px solid #d6deec;
            border-radius: 12px;
            font-family: inherit;
            font-size: .93rem;
            font-weight: 500;
            transition: border-color .15s, box-shadow .15s;
        }

        .fr .form-floating > label {
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .02em;
            color: var(--ink-3);
        }

        .fr .form-control:focus,
        .fr .form-select:focus {
            border-color: var(--blue);
            box-shadow: 0 0 0 4px rgba(33,80,217,.12);
        }

        .fr .form-floating > .form-select:focus ~ label,
        .fr .form-floating > .form-control:focus ~ label {
            color: var(--blue);
        }

        .fr .reg-card {
            background: var(--wash) !important;
            border: 1.5px dashed #c5d1ea !important;
            border-radius: 14px !important;
            height: 100%;
        }

            .fr .reg-card > label {
                color: var(--blue) !important;
                letter-spacing: .03em;
            }

        .fr .reg-boxes {
            flex-wrap: wrap;
            row-gap: .5rem;
        }

        .fr .reg-box-part {
            text-align: center;
            font-weight: 700;
            letter-spacing: .08em;
            font-variant-numeric: tabular-nums;
            border: 1.5px solid #d6deec;
            border-radius: 10px;
            background: #fff;
        }

        .fr .reg-boxes .fw-bold {
            color: var(--ink-3);
        }

        .fr .reg-card .form-control-sm {
            border: 1.5px solid #d6deec;
            border-radius: 10px;
            padding: .5rem .8rem;
            background: #fff;
        }

        .fr #check_result {
            border: 0;
            border-radius: 13px;
            padding: .9rem 1.2rem;
            font-size: 1rem;
            background: linear-gradient(135deg, #2150d9, #173fb0);
            box-shadow: 0 12px 22px -10px rgba(33,80,217,.75) !important;
            transition: transform .15s, box-shadow .15s;
        }

            .fr #check_result:hover {
                transform: translateY(-1px);
            }

            .fr #check_result:focus-visible {
                outline: 3px solid rgba(33,80,217,.35);
                outline-offset: 2px;
            }

        .fr .gradesheet-container {
            position: relative;
            background: #fff;
            border: 1px solid var(--line);
            border-top: 6px solid var(--gold);
            border-radius: 18px;
            padding: 2.25rem 2.25rem 1.75rem;
            box-shadow: 0 24px 48px -28px rgba(15,27,61,.4) !important;
        }

        .fr .gradesheet-header {
            text-align: center;
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px double #d9c08a;
        }

            .fr .gradesheet-header h2 {
                font-family: 'Fraunces', Georgia, serif;
                font-weight: 700;
                font-size: 1.7rem;
                letter-spacing: .04em;
                color: var(--ink);
                margin: .75rem 0 .2rem;
            }

            .fr .gradesheet-header h3 {
                font-size: 1rem;
                font-weight: 600;
                color: var(--ink-2);
                margin: 0 0 .1rem;
            }

            .fr .gradesheet-header h4 {
                font-size: .85rem;
                font-weight: 500;
                color: var(--ink-3);
                margin: 0 0 1rem;
            }

        .fr .gradesheet-title-badge {
            display: inline-block;
            padding: .5rem 1.4rem;
            border-radius: 999px;
            background: var(--ink);
            color: #f3d79c;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .08em;
        }

        .fr .gradesheet-student-info {
            background: var(--wash);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: .9rem 1.1rem;
            margin-bottom: 1.5rem;
        }

            .fr .gradesheet-student-info td {
                padding: .4rem .5rem;
                font-size: .88rem;
                background: transparent;
            }

        .fr .gradesheet-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            font-size: .88rem;
        }

            .fr .gradesheet-table thead th {
                background: var(--ink);
                color: #fff;
                font-size: .76rem;
                font-weight: 600;
                letter-spacing: .04em;
                text-align: center;
                padding: .8rem .6rem;
                border: 0;
            }

            .fr .gradesheet-table tbody td {
                padding: .75rem .6rem;
                border-bottom: 1px solid var(--line);
                vertical-align: middle;
            }

            .fr .gradesheet-table tbody tr:nth-child(even) td {
                background: #fafbfe;
            }

            .fr .gradesheet-table tbody tr:last-child td {
                border-bottom: 0;
            }

        .fr .gradesheet-summary {
            margin-top: 1.5rem;
            padding: 1.1rem .5rem;
            border-radius: 14px;
            background: linear-gradient(180deg, var(--gold-soft), #fff);
            border: 1px solid #ecd9ad;
        }

            .fr .gradesheet-summary small {
                font-size: .68rem;
                letter-spacing: .06em;
            }

        .fr .gradesheet-signatures {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1.5rem;
            flex-wrap: wrap;
            margin-top: 2.25rem;
        }

        .fr .signature-box {
            text-align: center;
            min-width: 200px;
        }

        .fr .signature-line {
            border-top: 1.5px solid var(--ink);
            margin-bottom: .4rem;
            width: 100%;
        }

        .fr .btn-outline-primary,
        .fr .gradesheet-container .btn-primary {
            border-radius: 11px;
            font-weight: 600;
        }

        .fr .alert-warning {
            background: linear-gradient(180deg, var(--gold-soft), #fff) !important;
            border: 1px solid #ecd9ad !important;
            border-radius: 18px !important;
            color: var(--ink);
        }

    @@media (max-width: 575.98px) {
        .fr .section-title {
            padding: 1.5rem 1.25rem 4.8rem;
        }

        .fr .result-form-wrapper {
            margin-left: .4rem;
            margin-right: .4rem;
        }

            .fr .result-form-wrapper form {
                padding: 1.1rem;
            }

        .fr .form-head {
            padding: 1rem 1.1rem;
        }

        .fr .gradesheet-container {
            padding: 1.25rem 1rem;
        }

        .fr .gradesheet-table {
            font-size: .78rem;
        }

        .fr .signature-box {
            min-width: 100%;
        }
    }

    @@media print {
        .fr {
            padding: 0;
        }

            .fr .no-print {
                display: none !important;
            }

            .fr .gradesheet-container {
                border: 0;
                border-radius: 0;
                box-shadow: none !important;
                padding: 0;
            }

            .fr .gradesheet-table thead th,
            .fr .gradesheet-title-badge,
            .fr .gradesheet-summary,
            .fr .gradesheet-student-info {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
    }
</style>

