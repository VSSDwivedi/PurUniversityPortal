@{
    ViewData["Title"] = "College Administration Portal";
    Layout = "_AdminLayout";
    var college = ViewBag.College as College;
    var students = ViewBag.Students as List<Student> ?? new List<Student>();
    var applications = ViewBag.Applications as List<ExaminationApplication> ?? new List<ExaminationApplication>();
    var activeExams = ViewBag.ActiveExams as List<Examination> ?? new List<Examination>();
}
<style>
    .kpi-card {
        --accent: #0d6efd;
        --accent-soft: rgba(13, 110, 253, .12);
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 22px;
        background: #fff;
        border: 1px solid #e9eef5;
        border-left: 5px solid var(--accent);
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(11, 37, 69, .06);
        transition: transform .2s ease, box-shadow .2s ease;
        height: 100%;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(11, 37, 69, .12);
        }

    .kpi-icon {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--accent);
        background: var(--accent-soft);
    }

    .kpi-info {
        min-width: 0;
    }

    .kpi-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        color: #0b2545;
    }

    .kpi-title {
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #6c7a8c;
        margin-bottom: 4px;
    }

    .kpi-blue {
        --accent: #0d6efd;
        --accent-soft: rgba(13,110,253,.12);
    }

    .kpi-green {
        --accent: #198754;
        --accent-soft: rgba(25,135,84,.12);
    }

    .kpi-orange {
        --accent: #f59f00;
        --accent-soft: rgba(245,159,0,.15);
    }

    .kpi-red {
        --accent: #dc3545;
        --accent-soft: rgba(220,53,69,.12);
    }

    .module-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        height: 100%;
        padding: 28px 24px;
        background: #fff;
        border: 1px solid #e9eef5;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(11, 37, 69, .06);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .module-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(11, 37, 69, .12);
        }

    .module-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
        margin-bottom: 16px;
    }

    .module-card h5 {
        font-weight: 700;
        color: #0b2545;
        margin-bottom: 8px;
    }

    .module-card p {
        color: #6c7a8c;
        font-size: .875rem;
        margin-bottom: 20px;
    }
    
    .app-card {
        background: #fff;
        border: 1px solid #c9d3e0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .10);
    }

    .app-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 13px 20px;
        background: #1e3c72;
    }

    .app-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
    }

        .app-title i {
            margin-right: 8px;
            color: #ffc53d;
        }

    .app-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        white-space: nowrap;
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, .7);
        transition: background .15s ease, color .15s ease;
    }

        .app-btn-ghost:hover {
            background: #fff;
            color: #1e3c72;
        }

        .app-btn-ghost i {
            font-size: .7rem;
        }

    .app-table thead th {
        background: #eef3fb;
        color: #334155;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .6px;
        padding: 12px 16px;
        white-space: nowrap;
        border-bottom: 2px solid #c9d3e0;
    }

    .app-table tbody td {
        padding: 13px 16px;
        font-size: .88rem;
        font-weight: 600;
        color: #0f172a;
        border-bottom: 1px solid #d5dde8;
    }

    .app-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .app-table tbody tr:hover td {
        background: #f3f7fd;
    }

    .app-no {
        font-weight: 800;
        color: #1e3c72;
    }

    .app-name {
        font-weight: 700;
    }

    .app-fee {
        font-weight: 800;
        color: #146c43;
        white-space: nowrap;
    }

    .app-muted {
        color: #64748b;
        font-weight: 600;
    }

    .app-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 700;
        color: #fff;
    }

        .app-pill .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #fff;
        }

    .app-ok {
        background: #198754;
    }

    .app-wait {
        background: #d97706;
    }

    .app-bad {
        background: #dc3545;
    }

    .app-table td.app-empty {
        text-align: center;
        padding: 36px 16px;
        color: #64748b;
        font-size: .92rem;
        font-weight: 600;
    }

    .app-empty i {
        display: block;
        font-size: 2rem;
        margin-bottom: 8px;
    }</style>
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" style="background: linear-gradient(135deg, #133b5c 0%, #0b2545 100%);">
    <div class="card-body p-4 text-white">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold mb-2">College Administration Portal</span>
                <h2 class="fw-bold mb-1">@(college?.CollegeName ?? "Affiliated Campus")</h2>
                <p class="text-white-50 mb-0">
                    College Code: <strong class="text-warning">@(college?.CollegeCode ?? "COL")</strong> &bull;
                    Address: @(college?.Address ?? "Nepal") &bull;
                    Principal: @(college?.PrincipalName ?? "Campus Chief")
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="AdminStudent" class="btn btn-warning fw-bold me-2 shadow-sm">
                    <i class="fa-solid fa-user-plus me-1"></i> Register Student
                </a>
                <a asp-action="Applications" class="btn btn-outline-light fw-bold">
                    <i class="fa-solid fa-file-pen me-1"></i> Applications
                </a>
            </div>
        </div>
    </div>
</div>
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon"><i class="fa-solid fa-user-graduate"></i></div>
            <div class="kpi-info">
                <div class="kpi-title">Total Enrolled Students</div>
                <div class="kpi-value">@students.Count</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card kpi-green">
            <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="kpi-info">
                <div class="kpi-title">Approved Registrations</div>
                <div class="kpi-value">@students.Count(s => s.RegistrationStatus == "Approved")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card kpi-orange">
            <div class="kpi-icon"><i class="fa-solid fa-user-clock"></i></div>
            <div class="kpi-info">
                <div class="kpi-title">Pending Verifications</div>
                <div class="kpi-value">@students.Count(s => s.RegistrationStatus == "Pending")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card kpi-red">
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
            <div class="kpi-info">
                <div class="kpi-title">Exam Applications</div>
                <div class="kpi-value">@applications.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="module-card">
            <div class="module-icon bg-primary-subtle text-primary"><i class="fa-solid fa-users"></i></div>
            <h5>Student Directory</h5>
            <p>Search, filter, and review profiles of all students registered in your institution.</p>
            <a asp-action="Students" class="btn btn-outline-primary fw-bold mt-auto">View Students</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="module-card">
            <div class="module-icon bg-warning-subtle text-warning"><i class="fa-solid fa-id-card"></i></div>
            <h5>Batch Admit Cards</h5>
            <p>Download and print authorized examination admit cards in bulk for your college students.</p>
            <a asp-action="AdmitCards" class="btn btn-outline-warning text-dark fw-bold mt-auto">Batch Admit Cards</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="module-card">
            <div class="module-icon bg-success-subtle text-success"><i class="fa-solid fa-square-poll-vertical"></i></div>
            <h5>College Results</h5>
            <p>Review official published semester results and performance analytics for your college.</p>
            <a asp-action="Results" class="btn btn-outline-success fw-bold mt-auto">Examine Results</a>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="app-head">
        <h5 class="app-title"><i class="fa-solid fa-clock-rotate-left"></i> Recent Examination Applications from Your College</h5>
        <a asp-action="Applications" class="app-btn-ghost">View All Applications <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="table-responsive">
        <table class="table app-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Application No</th>
                    <th>Student Name</th>
                    <th>Registration No</th>
                    <th>Exam Title</th>
                    <th>Semester</th>
                    <th class="text-end">Fee</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (applications.Any())
                {
                    foreach (var a in applications.Take(5))
                    {
                        <tr>
                            <td><span class="app-no">@a.ApplicationNumber</span></td>
                            <td class="app-name">@a.StudentName</td>
                            <td class="@(string.IsNullOrEmpty(a.RegistrationNumber) ? "app-muted" : "")">@(string.IsNullOrEmpty(a.RegistrationNumber) ? "Pending" : a.RegistrationNumber)</td>
                            <td>@a.ExamName</td>
                            <td>@a.SemesterName</td>
                            <td class="text-end app-fee">NPR @a.FeePaid.ToString("N0")</td>
                            <td class="text-center">
                                <span class="app-pill @(a.Status == "Approved" ? "app-ok" : a.Status == "Pending" ? "app-wait" : "app-bad")">
                                    <span class="dot"></span>@a.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="app-empty">
                            <i class="fa-solid fa-inbox"></i>
                            <div>No examination applications submitted yet.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
