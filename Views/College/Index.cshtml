@{
    ViewData["Title"] = "College Administration Portal";
    Layout = "_AdminLayout";
    var college = ViewBag.College as College;
    var students = ViewBag.Students as List<Student> ?? new List<Student>();
    var applications = ViewBag.Applications as List<ExaminationApplication> ?? new List<ExaminationApplication>();
    var activeExams = ViewBag.ActiveExams as List<Examination> ?? new List<Examination>();
}

<!-- College Welcome Header -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" style="background: linear-gradient(135deg, #133b5c 0%, #0b2545 100%);">
    <div class="card-body p-4 text-white">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark px-3 py-1 fw-bold mb-2">College Administration Portal</span>
                <h2 class="fw-bold mb-1">@(college?.CollegeName ?? "Affiliated Campus")</h2>
                <p class="text-white-50 mb-0">
                    College Code: <strong class="text-warning">@(college?.CollegeCode ?? "COL")</strong> &bull;
                    Address: @(college?.Address ?? "Nepal") &bull;
                    Principal: @(college?.PrincipalName ?? "Campus Chief")
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="RegisterStudent" class="btn btn-warning fw-bold me-2 shadow-sm">
                    <i class="fa-solid fa-user-plus me-1"></i> Register Student
                </a>
                <a asp-action="Applications" class="btn btn-outline-light fw-bold">
                    <i class="fa-solid fa-file-pen me-1"></i> Applications
                </a>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-lg-3 col-sm-6">
        <div class="kpi-card blue">
            <div>
                <div class="kpi-value">@students.Count</div>
                <div class="kpi-title">Total Enrolled Students</div>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-user-graduate"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="kpi-card green">
            <div>
                <div class="kpi-value">@students.Count(s => s.RegistrationStatus == "Approved")</div>
                <div class="kpi-title">Approved Registrations</div>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="kpi-card orange">
            <div>
                <div class="kpi-value">@students.Count(s => s.RegistrationStatus == "Pending")</div>
                <div class="kpi-title">Pending Verifications</div>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-user-clock"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6">
        <div class="kpi-card red">
            <div>
                <div class="kpi-value">@applications.Count</div>
                <div class="kpi-title">Exam Applications</div>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
        </div>
    </div>
</div>

<!-- College Quick Modules -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border p-4 text-center">
            <i class="fa-solid fa-users fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold text-dark">Student Directory</h5>
            <p class="text-muted small">Search, filter, and review profiles of all students registered in your institution.</p>
            <a asp-action="Students" class="btn btn-outline-primary fw-bold mt-auto">View Students</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border p-4 text-center">
            <i class="fa-solid fa-id-card fa-3x text-warning mb-3"></i>
            <h5 class="fw-bold text-dark">Batch Admit Cards</h5>
            <p class="text-muted small">Download and print authorized examination admit cards in bulk for your college students.</p>
            <a asp-action="AdmitCards" class="btn btn-outline-warning text-dark fw-bold mt-auto">Batch Admit Cards</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border p-4 text-center">
            <i class="fa-solid fa-square-poll-vertical fa-3x text-success mb-3"></i>
            <h5 class="fw-bold text-dark">College Results</h5>
            <p class="text-muted small">Review official published semester results and performance analytics for your college.</p>
            <a asp-action="Results" class="btn btn-outline-success fw-bold mt-auto">Examine Results</a>
        </div>
    </div>
</div>

<!-- Recent Applications Table -->
<div class="custom-card shadow-sm">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-clock-rotate-left text-primary"></i> Recent Examination Applications from Your College</h5>
        <a asp-action="Applications" class="btn btn-sm btn-outline-primary fw-bold">View All Applications</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Application No</th>
                    <th>Student Name</th>
                    <th>Registration No</th>
                    <th>Exam Title</th>
                    <th>Semester</th>
                    <th>Fee</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (applications.Any())
                {
                    foreach (var a in applications.Take(5))
                    {
                        <tr>
                            <td><strong class="text-primary">@a.ApplicationNumber</strong></td>
                            <td class="fw-bold text-dark">@a.StudentName</td>
                            <td>@(a.RegistrationNumber ?? "Pending")</td>
                            <td>@a.ExamName</td>
                            <td>@a.SemesterName</td>
                            <td class="fw-bold text-success">NPR @a.FeePaid.ToString("N0")</td>
                            <td>
                                <span class="badge @(a.Status == "Approved" ? "bg-success" : a.Status == "Pending" ? "bg-warning text-dark" : "bg-danger") px-3 py-1">
                                    @a.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No examination applications submitted yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
