@model List<Result>
@{
    ViewData["Title"] = "College Results Ledger";
    Layout = "_AdminLayout";
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    int selectedExamId = ViewBag.SelectedExamId;
    int? selectedProgramId = ViewBag.SelectedProgramId;
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-square-poll-vertical text-success"></i> Published Examination Results</h5>
        <div>
            <span class="badge bg-success fs-6">Examinees: @Model.Count</span>
            <span class="badge bg-primary fs-6 ms-2">Passed: @Model.Count(r => r.ResultStatus == "Passed")</span>
            <span class="badge bg-danger fs-6 ms-2">Back/Failed: @Model.Count(r => r.ResultStatus != "Passed")</span>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <select name="examId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var ex in exams)
                    {
                        <option value="@ex.ExaminationId" selected="@(selectedExamId == ex.ExaminationId)">
                            @ex.ExamName (@ex.Status)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Programs --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p.ProgramId" selected="@(selectedProgramId == p.ProgramId)">@p.ProgramName</option>
                    }
                </select>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Roll Number</th>
                    <th>Candidate Name</th>
                    <th>Registration No</th>
                    <th>Program</th>
                    <th>Semester</th>
                    <th>Marks</th>
                    <th>Percentage</th>
                    <th>SGPA</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var r in Model)
                    {
                        <tr>
                            <td><strong class="text-danger fs-6">@r.RollNumber</strong></td>
                            <td class="fw-bold text-dark">@r.StudentName</td>
                            <td><span class="badge bg-secondary">@r.RegistrationNumber</span></td>
                            <td>@r.ProgramName</td>
                            <td>@r.SemesterName</td>
                            <td>@r.TotalMarksObtained.ToString("F1") / @r.TotalFullMarks.ToString("F0")</td>
                            <td class="fw-bold text-primary">@r.Percentage.ToString("F1")%</td>
                            <td><strong class="text-success fs-6">@r.SGPA.ToString("F2")</strong></td>
                            <td>
                                <span class="badge @(r.ResultStatus == "Passed" ? "bg-success" : "bg-danger") px-3 py-1">
                                    @r.ResultStatus
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Results" asp-action="GradeSheet" asp-route-id="@r.ResultId" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-print me-1"></i> Grade Sheet
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">No published examination results available for this session yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
