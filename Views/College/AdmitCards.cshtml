@model List<AdmitCard>
@{
    ViewData["Title"] = "College Bulk Admit Cards";
    Layout = "_AdminLayout";
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
    int selectedExamId = ViewBag.SelectedExamId;
}

<div class="adm-card mb-4 no-print">
    <div class="adm-head">
        <h5 class="adm-title"><i class="fa-solid fa-id-card"></i> College Examinee Admit Cards</h5>
        <button type="button" onclick="window.print()" class="adm-btn-ghost">
            <i class="fa-solid fa-print"></i> Print All Admit Cards
        </button>
    </div>

    <div class="adm-toolbar">
        <form method="get" class="adm-form">
            <div class="adm-field">
                <label class="adm-label" for="examId">Examination</label>
                <select id="examId" name="examId" class="form-select adm-input" onchange="this.form.submit()">
                    @foreach (var ex in exams)
                    {
                        <option value="@ex.ExaminationId" selected="@(selectedExamId == ex.ExaminationId)">
                            @ex.ExamName (@ex.ExamCode)
                        </option>
                    }
                </select>
            </div>
            <div class="adm-count">
                <i class="fa-solid fa-id-card-clip"></i>
                Total Generated Cards: <strong>@Model.Count</strong>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="adm-sheets">
        @foreach (var card in Model)
        {
            <div class="adm-paper">
                <div class="adm-watermark">PURBANCHAL UNIVERSITY</div>

                <div class="adm-paper-head">
                    <div class="adm-crest"><i class="fa-solid fa-graduation-cap"></i></div>
                    <div class="adm-uni">PURBANCHAL UNIVERSITY</div>
                    <div class="adm-office">Office of the Controller of Examinations</div>
                    <div class="adm-badge-title">ADMIT CARD</div>
                </div>

                <div class="adm-main">
                    <table class="adm-table">
                        <tr><th>Examination</th><td class="exam">@card.ExamName</td></tr>
                        <tr><th>Candidate</th><td class="cand">@card.StudentName</td></tr>
                        <tr><th>Roll Number</th><td class="roll">@card.RollNumber</td></tr>
                        <tr><th>Registration</th><td>@card.RegistrationNumber</td></tr>
                        <tr><th>Program &amp; Sem</th><td>@card.ProgramName &bull; @card.SemesterName</td></tr>
                        <tr><th>College</th><td>@card.CollegeName</td></tr>
                        <tr><th>Exam Center</th><td>@card.CenterName (@card.CenterLocation)</td></tr>
                    </table>

                    <div class="adm-photo-col">
                        @if (!string.IsNullOrEmpty(card.PhotoUrl))
                        {
                            <img src="@card.PhotoUrl" alt="Student Photo" class="adm-photo" />
                        }
                        else
                        {
                            <div class="adm-photo adm-photo-empty"><i class="fa-solid fa-user"></i></div>
                        }
                        <div class="adm-sign-line"></div>
                        <div class="adm-sign-label">Candidate Signature</div>
                    </div>
                </div>

                <div class="adm-foot">
                    <div class="adm-foot-col">
                        @if (!string.IsNullOrEmpty(card.QrCodeBase64))
                        {
                            <img src="@card.QrCodeBase64" alt="QR" class="adm-qr" />
                        }
                        <div class="adm-small">Admit Card No: @card.AdmitCardNumber</div>
                    </div>
                    <div class="adm-foot-col">
                        <div class="adm-small mb-1">Issued: @card.GeneratedDate.ToString("yyyy-MM-dd")</div>
                        <span class="adm-verified"><i class="fa-solid fa-circle-check"></i> Verified Official</span>
                    </div>
                    <div class="adm-foot-col">
                        <div class="adm-signature">Prof. Dr. Rajesh Sharma</div>
                        <div class="adm-sig-line">Controller of Examinations</div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="adm-card no-print">
        <div class="adm-empty">
            <i class="fa-solid fa-id-card"></i>
            <h5>No Admit Cards Found</h5>
            <p>No approved admit cards generated for this examination session yet.</p>
        </div>
    </div>
}

<style>
    .adm-card {
        background: #fff;
        border: 1px solid #c9d3e0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .10);
    }

    .adm-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 13px 20px;
        background: #1e3c72;
    }

    .adm-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
    }

        .adm-title i {
            margin-right: 8px;
            color: #ffc53d;
        }

    .adm-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 16px;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 700;
        color: #1e3c72;
        background: #fff;
        border: 1.5px solid #fff;
        transition: background .15s ease, color .15s ease;
    }

        .adm-btn-ghost:hover {
            background: #ffc53d;
            border-color: #ffc53d;
            color: #0f172a;
        }

    .adm-toolbar {
        padding: 16px 20px;
        background: #eef3fb;
    }

    .adm-form {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 16px;
        margin: 0;
    }

    .adm-field {
        flex: 1 1 320px;
        max-width: 520px;
    }

    .adm-label {
        display: block;
        margin-bottom: 6px;
        font-size: .8rem;
        font-weight: 700;
        color: #0f172a;
    }

    .adm-input {
        border: 1.5px solid #94a3b8;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: .92rem;
        color: #0f172a;
    }

        .adm-input:focus {
            border-color: #1e3c72;
            box-shadow: 0 0 0 3px rgba(30, 60, 114, .20);
        }

    .adm-count {
        padding: 9px 16px;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 600;
        color: #fff;
        background: #1e3c72;
    }

        .adm-count i {
            margin-right: 6px;
            color: #ffc53d;
        }

        .adm-count strong {
            font-weight: 800;
        }

    .adm-empty {
        text-align: center;
        padding: 48px 16px;
        color: #475569;
    }

        .adm-empty i {
            font-size: 3rem;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .adm-empty h5 {
            font-weight: 800;
            color: #0f172a;
        }

        .adm-empty p {
            margin: 0;
            font-weight: 600;
        }

    .adm-sheets {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 28px;
    }

    .adm-paper {
        position: relative;
        overflow: hidden;
        width: 100%;
        max-width: 780px;
        padding: 26px 30px 22px;
        background: #fff;
        border: 3px double #1e3c72;
        border-radius: 6px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, .18);
    }

    .adm-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 3.4rem;
        font-weight: 900;
        letter-spacing: 4px;
        white-space: nowrap;
        color: rgba(30, 60, 114, .06);
        pointer-events: none;
        user-select: none;
    }

    .adm-paper > *:not(.adm-watermark) {
        position: relative;
        z-index: 1;
    }

    .adm-paper-head {
        text-align: center;
        padding-bottom: 14px;
        border-bottom: 2px solid #1e3c72;
    }

    .adm-crest {
        width: 64px;
        height: 64px;
        margin: 0 auto 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: #fff;
        background: #1e3c72;
        border: 3px solid #ffc53d;
    }

    .adm-uni {
        font-size: 1.5rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: #0f172a;
        line-height: 1.1;
    }

    .adm-office {
        margin-top: 2px;
        font-size: .88rem;
        font-weight: 700;
        color: #b02a37;
    }

    .adm-badge-title {
        display: inline-block;
        margin-top: 10px;
        padding: 5px 28px;
        border-radius: 4px;
        font-size: .95rem;
        font-weight: 800;
        letter-spacing: 3px;
        color: #fff;
        background: #1e3c72;
    }

    .adm-main {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        padding: 18px 0;
    }

    .adm-table {
        flex: 1;
        border-collapse: collapse;
    }

        .adm-table th, .adm-table td {
            padding: 7px 8px;
            font-size: .88rem;
            border-bottom: 1px solid #d5dde8;
            vertical-align: top;
        }

        .adm-table tr:last-child th, .adm-table tr:last-child td {
            border-bottom: 0;
        }

        .adm-table th {
            width: 130px;
            font-weight: 700;
            color: #475569;
            white-space: nowrap;
        }

        .adm-table td {
            font-weight: 700;
            color: #0f172a;
        }

            .adm-table td.exam {
                color: #1e3c72;
            }

            .adm-table td.cand {
                font-size: 1.02rem;
                font-weight: 800;
                text-transform: uppercase;
            }

            .adm-table td.roll {
                font-size: 1.15rem;
                font-weight: 900;
                color: #b02a37;
                letter-spacing: .5px;
            }

    .adm-photo-col {
        flex-shrink: 0;
        width: 130px;
        text-align: center;
    }

    .adm-photo {
        display: block;
        width: 105px;
        height: 125px;
        margin: 0 auto 8px;
        object-fit: cover;
        border: 2px solid #1e3c72;
        border-radius: 4px;
        background: #fff;
    }

    .adm-photo-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #64748b;
        background: #eef3fb;
    }

    .adm-sign-line {
        height: 24px;
        width: 120px;
        margin: 0 auto;
        border-bottom: 1.5px dashed #475569;
    }

    .adm-sign-label {
        margin-top: 3px;
        font-size: .68rem;
        font-weight: 700;
        color: #475569;
    }

    .adm-foot {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        padding-top: 14px;
        border-top: 2px solid #1e3c72;
    }

    .adm-foot-col {
        flex: 1;
        text-align: center;
    }

    .adm-qr {
        width: 76px;
        height: 76px;
        display: block;
        margin: 0 auto 4px;
    }

    .adm-small {
        font-size: .7rem;
        font-weight: 700;
        color: #475569;
    }

    .adm-verified {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
        color: #fff;
        background: #198754;
    }

    .adm-signature {
        font-family: 'Brush Script MT', cursive;
        font-size: 1.6rem;
        color: #0b2545;
        line-height: 1.1;
    }

    .adm-sig-line {
        margin-top: 2px;
        padding-top: 4px;
        border-top: 1.5px solid #0f172a;
        font-size: .75rem;
        font-weight: 700;
        color: #0f172a;
    }

    @@media (max-width: 576px) {
        .adm-paper {
            padding: 18px 14px;
        }

        .adm-main {
            flex-direction: column-reverse;
            align-items: center;
        }

        .adm-table {
            width: 100%;
        }

        .adm-foot {
            flex-direction: column;
            align-items: center;
        }

        .adm-watermark {
            font-size: 2rem;
        }
    }

    @@media print {
        @@page {
            size: A4;
            margin: 10mm;
        }

        body * {
            visibility: hidden;
        }

        .adm-sheets, .adm-sheets * {
            visibility: visible;
        }

        .adm-sheets {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block;
        }

        .no-print {
            display: none !important;
        }

        .adm-paper {
            max-width: none;
            margin: 0;
            box-shadow: none;
            break-inside: avoid;
            page-break-after: always;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            .adm-paper:last-child {
                page-break-after: auto;
            }

        .adm-crest, .adm-badge-title, .adm-verified {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>