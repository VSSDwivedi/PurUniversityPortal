@model List<AdmitCard>
@{
    ViewData["Title"] = "College Bulk Admit Cards";
    Layout = "_AdminLayout";
    var exams = ViewBag.Examinations as List<Examination> ?? new List<Examination>();
    int selectedExamId = ViewBag.SelectedExamId;
}

<div class="custom-card shadow-sm mb-4 no-print">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-id-card text-warning"></i> College Examinee Admit Cards</h5>
        <button onclick="window.print()" class="btn btn-primary btn-sm fw-bold">
            <i class="fa-solid fa-print me-1"></i> Print All Selected Admit Cards
        </button>
    </div>

    <!-- Exam Selector -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <select name="examId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var ex in exams)
                    {
                        <option value="@ex.ExaminationId" selected="@(selectedExamId == ex.ExaminationId)">
                            @ex.ExamName (@ex.ExamCode)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <span class="badge bg-primary fs-6">Total Generated Cards: @Model.Count</span>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    foreach (var card in Model)
    {
        <div class="print-paper shadow mb-5" style="page-break-after: always;">
            <div class="print-watermark">APEX UNIVERSITY</div>

            <div class="admit-card-header text-center">
                <div class="uni-crest mx-auto mb-2" style="width: 65px; height: 65px; font-size: 1.6rem;">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <h4 class="fw-bold mb-0 text-dark">APEX UNIVERSITY</h4>
                <div class="fw-bold text-danger">Office of the Controller of Examinations</div>
                <div class="admit-card-title my-2">ADMIT CARD</div>
            </div>

            <div class="row align-items-center mb-3">
                <div class="col-8">
                    <table class="table table-sm table-borderless mb-0 small">
                        <tr><td style="width: 140px;" class="fw-bold text-muted">Examination:</td><td class="fw-bold text-primary">@card.ExamName</td></tr>
                        <tr><td class="fw-bold text-muted">Candidate:</td><td class="fw-bold text-dark text-uppercase fs-6">@card.StudentName</td></tr>
                        <tr><td class="fw-bold text-muted">Roll Number:</td><td class="fw-bold text-danger fs-5">@card.RollNumber</td></tr>
                        <tr><td class="fw-bold text-muted">Registration:</td><td class="fw-bold text-dark">@card.RegistrationNumber</td></tr>
                        <tr><td class="fw-bold text-muted">Program & Sem:</td><td><strong>@card.ProgramName</strong> &bull; @card.SemesterName</td></tr>
                        <tr><td class="fw-bold text-muted">College:</td><td><strong>@card.CollegeName</strong></td></tr>
                        <tr><td class="fw-bold text-muted">Exam Center:</td><td><strong>@card.CenterName</strong> (@card.CenterLocation)</td></tr>
                    </table>
                </div>
                <div class="col-4 text-center">
                    @if (!string.IsNullOrEmpty(card.PhotoUrl))
                    {
                        <img src="@card.PhotoUrl" alt="Student Photo" class="admit-photo-box shadow-sm mb-1" style="width: 105px; height: 125px;" />
                    }
                    else
                    {
                        <div class="admit-photo-box shadow-sm mb-1 mx-auto d-flex align-items-center justify-content-center bg-light text-secondary fs-2" style="width: 105px; height: 125px;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                    }
                    <div style="height: 25px; border-bottom: 1px dashed #64748b; width: 120px; margin: 0 auto;"></div>
                    <small class="text-muted" style="font-size: 0.65rem;">Candidate Signature</small>
                </div>
            </div>

            <div class="row align-items-end pt-3 border-top">
                <div class="col-4 text-center">
                    @if (!string.IsNullOrEmpty(card.QrCodeBase64))
                    {
                        <img src="@card.QrCodeBase64" alt="QR" style="width: 75px; height: 75px;" />
                    }
                    <div class="text-muted" style="font-size: 0.6rem;">Admit Card No: @card.AdmitCardNumber</div>
                </div>
                <div class="col-4 text-center">
                    <small class="text-muted d-block">Issued: @card.GeneratedDate.ToString("yyyy-MM-dd")</small>
                    <span class="badge bg-success">Verified Official</span>
                </div>
                <div class="col-4 text-center">
                    <div style="font-family: 'Brush Script MT', cursive; font-size: 1.5rem; color: #0b2545;">Prof. Dr. Rajesh Sharma</div>
                    <div class="signature-line" style="font-size: 0.75rem;">Controller of Examinations</div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="custom-card p-5 text-center text-muted">
        <i class="fa-solid fa-id-card fa-3x text-secondary mb-3"></i>
        <h5>No Admit Cards Found</h5>
        <p>No approved admit cards generated for this examination session yet.</p>
    </div>
}
