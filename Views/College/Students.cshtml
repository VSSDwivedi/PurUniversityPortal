@model List<Student>
@{
    ViewData["Title"] = "College Student Directory";
    Layout = "_AdminLayout";
    var college = ViewBag.College as College;
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-user-graduate text-primary"></i> Students of @(college?.CollegeName ?? "College")</h5>
        <a asp-action="RegisterStudent" class="btn btn-primary btn-sm fw-bold">
            <i class="fa-solid fa-user-plus me-1"></i> Register New Student
        </a>
    </div>

    <!-- Filter Form -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search by name, ID, or Reg No..." />
            </div>
            <div class="col-md-3">
                <select name="programId" class="form-select form-select-sm">
                    <option value="">-- All Programs --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p.ProgramId" selected="@(ViewBag.SelectedProgram == p.ProgramId)">@p.ProgramName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="semesterId" class="form-select form-select-sm">
                    <option value="">-- All Semesters --</option>
                    @foreach (var s in semesters)
                    {
                        <option value="@s.SemesterId" selected="@(ViewBag.SelectedSemester == s.SemesterId)">@s.SemesterName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- All Statuses --</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <a asp-action="Students" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    <!-- Students Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Registration No</th>
                    <th>Program</th>
                    <th>Semester</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@s.StudentUniqueId</strong></td>
                            <td>
                                <div class="fw-bold text-dark">@s.FullName</div>
                                <small class="text-muted">@s.Email</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(s.RegistrationNumber))
                                {
                                    <span class="badge bg-secondary">@s.RegistrationNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Pending Allocation</span>
                                }
                            </td>
                            <td>@s.ProgramName</td>
                            <td>@s.CurrentSemester</td>
                            <td>@s.MobileNumber</td>
                            <td>
                                <span class="badge @(s.RegistrationStatus == "Approved" ? "bg-success" : "bg-warning text-dark") px-2 py-1">
                                    @s.RegistrationStatus
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="AdminStudent" asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-eye me-1"></i> View Dossier
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No students found matching the selected criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
