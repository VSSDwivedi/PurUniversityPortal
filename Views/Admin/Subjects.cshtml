@model List<Subject>
@{
    ViewData["Title"] = "Subject & Curriculum Management";
    Layout = "_AdminLayout";
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    var semesters = ViewBag.Semesters as List<Semester> ?? new List<Semester>();
    int? selProg = ViewBag.SelectedProgramId;
    int? selSem = ViewBag.SelectedSemesterId;
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-book-open text-primary"></i> Curriculum Subject Configuration</h5>
        <button class="btn btn-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
            <i class="fa-solid fa-plus me-1"></i> Add Subject
        </button>
    </div>

    <!-- Filter Bar -->
    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <select name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Programs --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p.ProgramId" selected="@(selProg == p.ProgramId)">@p.ProgramName (@p.ProgramCode)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="semesterId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Semesters --</option>
                    @foreach (var s in semesters)
                    {
                        <option value="@s.SemesterId" selected="@(selSem == s.SemesterId)">@s.SemesterName</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <a asp-action="Subjects" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Subject Title</th>
                    <th>Program</th>
                    <th>Semester</th>
                    <th>Credits</th>
                    <th>Full</th>
                    <th>Pass</th>
                    <th>Internal</th>
                    <th>External</th>
                    <th>Practical</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@sub.SubjectCode</strong></td>
                        <td class="fw-bold text-dark">@sub.SubjectName</td>
                        <td>@sub.ProgramName</td>
                        <td><span class="badge bg-secondary">@sub.SemesterName</span></td>
                        <td><strong>@sub.CreditHours</strong></td>
                        <td>@sub.FullMarks</td>
                        <td class="text-danger fw-bold">@sub.PassMarks</td>
                        <td>@sub.InternalMarks</td>
                        <td>@sub.ExternalMarks</td>
                        <td>@(sub.PracticalMarks > 0 ? sub.PracticalMarks.ToString() : "-")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@sub.SubjectId">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </button>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@sub.SubjectId" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <form asp-action="EditSubject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="SubjectId" value="@sub.SubjectId" />
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Edit Subject</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row g-2 mb-3">
                                            <div class="col-4">
                                                <label class="form-label small fw-bold">Code *</label>
                                                <input type="text" name="SubjectCode" value="@sub.SubjectCode" class="form-control" required />
                                            </div>
                                            <div class="col-8">
                                                <label class="form-label small fw-bold">Subject Name *</label>
                                                <input type="text" name="SubjectName" value="@sub.SubjectName" class="form-control" required />
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Program *</label>
                                                <select name="ProgramId" class="form-select" required>
                                                    @foreach (var p in programs)
                                                    {
                                                        <option value="@p.ProgramId" selected="@(sub.ProgramId == p.ProgramId)">@p.ProgramName</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Semester *</label>
                                                <select name="SemesterId" class="form-select" required>
                                                    @foreach (var s in semesters)
                                                    {
                                                        <option value="@s.SemesterId" selected="@(sub.SemesterId == s.SemesterId)">@s.SemesterName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-3">
                                                <label class="form-label small fw-bold">Credits</label>
                                                <input type="number" name="CreditHours" value="@sub.CreditHours" class="form-control" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-bold">Full Marks</label>
                                                <input type="number" name="FullMarks" value="@sub.FullMarks" class="form-control" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-bold">Pass Marks</label>
                                                <input type="number" name="PassMarks" value="@sub.PassMarks" class="form-control" />
                                            </div>
                                            <div class="col-3">
                                                <label class="form-label small fw-bold">Internal (Theory)</label>
                                                <input type="number" name="InternalMarks" value="@sub.InternalMarks" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">External (University Board)</label>
                                                <input type="number" name="ExternalMarks" value="@sub.ExternalMarks" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Practical Marks</label>
                                                <input type="number" name="PracticalMarks" value="@sub.PracticalMarks" class="form-control" />
                                            </div>
                                        </div>
                                        <input type="hidden" name="IsActive" value="true" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Subject Modal -->
<div class="modal fade" id="addSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddSubject" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Curriculum Subject</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-bold">Code (e.g. CMP212) *</label>
                            <input type="text" name="SubjectCode" class="form-control" placeholder="e.g. CMP212" required />
                        </div>
                        <div class="col-8">
                            <label class="form-label small fw-bold">Subject Name *</label>
                            <input type="text" name="SubjectName" class="form-control" placeholder="e.g. Data Structures & Algorithms" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Program *</label>
                            <select name="ProgramId" class="form-select" required>
                                @foreach (var p in programs)
                                {
                                    <option value="@p.ProgramId">@p.ProgramName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Semester *</label>
                            <select name="SemesterId" class="form-select" required>
                                @foreach (var s in semesters)
                                {
                                    <option value="@s.SemesterId">@s.SemesterName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-3">
                            <label class="form-label small fw-bold">Credits</label>
                            <input type="number" name="CreditHours" value="3" class="form-control" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-bold">Full Marks</label>
                            <input type="number" name="FullMarks" value="100" class="form-control" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-bold">Pass Marks</label>
                            <input type="number" name="PassMarks" value="45" class="form-control" />
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-bold">Internal (40)</label>
                            <input type="number" name="InternalMarks" value="40" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">External (60)</label>
                            <input type="number" name="ExternalMarks" value="60" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Practical Marks</label>
                            <input type="number" name="PracticalMarks" value="0" class="form-control" />
                        </div>
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Create Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>
