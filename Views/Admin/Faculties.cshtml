@model List<Faculty>
@{
    ViewData["Title"] = "Faculty Management";
    Layout = "_AdminLayout";
}

<div class="custom-card shadow-sm">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-graduation-cap text-primary"></i> Academic Faculties</h5>
        <button class="btn btn-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addFacultyModal">
            <i class="fa-solid fa-plus me-1"></i> Add Faculty
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Faculty Name</th>
                    <th>Dean / Head</th>
                    <th>Programs</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@f.FacultyCode</strong></td>
                        <td class="fw-bold text-dark">@f.FacultyName</td>
                        <td>@(f.DeanName ?? "-")</td>
                        <td><span class="badge bg-secondary">@f.ProgramCount Programs</span></td>
                        <td><small class="text-muted">@f.Description</small></td>
                        <td>
                            <span class="badge @(f.IsActive ? "bg-success" : "bg-danger")">
                                @(f.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@f.FacultyId">
                                <i class="fa-solid fa-pen-to-square"></i> Edit
                            </button>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@f.FacultyId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="EditFaculty" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="FacultyId" value="@f.FacultyId" />
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Edit Faculty</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Faculty Code *</label>
                                            <input type="text" name="FacultyCode" value="@f.FacultyCode" class="form-control" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Faculty Name *</label>
                                            <input type="text" name="FacultyName" value="@f.FacultyName" class="form-control" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Dean Name</label>
                                            <input type="text" name="DeanName" value="@f.DeanName" class="form-control" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Description</label>
                                            <textarea name="Description" class="form-control" rows="2">@f.Description</textarea>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked="@f.IsActive" id="chkActive-@f.FacultyId" />
                                            <label class="form-check-label small" for="chkActive-@f.FacultyId">Active Faculty</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Faculty Modal -->
<div class="modal fade" id="addFacultyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddFaculty" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add New Faculty</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Faculty Code (e.g. FST) *</label>
                        <input type="text" name="FacultyCode" class="form-control" placeholder="e.g. FST" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Faculty Name *</label>
                        <input type="text" name="FacultyName" class="form-control" placeholder="e.g. Faculty of Science & Technology" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Dean Name</label>
                        <input type="text" name="DeanName" class="form-control" placeholder="e.g. Prof. Dr. K. P. Sharma" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Brief description of departments and disciplines"></textarea>
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Create Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>
