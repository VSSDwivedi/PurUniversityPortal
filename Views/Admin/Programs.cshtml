@model List<ProgramModel>
@{
    ViewData["Title"] = "Academic Program Management";
    Layout = "_AdminLayout";
    var faculties = ViewBag.Faculties as List<Faculty> ?? new List<Faculty>();
}

<div class="custom-card shadow-sm">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-book-bookmark text-primary"></i> Academic Degree Programs</h5>
        <button class="btn btn-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addProgModal">
            <i class="fa-solid fa-plus me-1"></i> Add Program
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Program Title</th>
                    <th>Faculty</th>
                    <th>Level</th>
                    <th>Duration</th>
                    <th>Semesters</th>
                    <th>Credits</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@p.ProgramCode</strong></td>
                        <td class="fw-bold text-dark">@p.ProgramName</td>
                        <td>@p.FacultyName</td>
                        <td><span class="badge bg-secondary">@p.DegreeLevel</span></td>
                        <td>@p.DurationYears Years</td>
                        <td>@p.TotalSemesters Sem</td>
                        <td>@p.TotalCredits Cr</td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-danger")">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@p.ProgramId">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@p.ProgramId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="EditProgram" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProgramId" value="@p.ProgramId" />
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Edit Academic Program</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Program Code *</label>
                                            <input type="text" name="ProgramCode" value="@p.ProgramCode" class="form-control" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Program Name *</label>
                                            <input type="text" name="ProgramName" value="@p.ProgramName" class="form-control" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Faculty *</label>
                                            <select name="FacultyId" class="form-select" required>
                                                @foreach (var f in faculties)
                                                {
                                                    <option value="@f.FacultyId" selected="@(p.FacultyId == f.FacultyId)">@f.FacultyName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-4">
                                                <label class="form-label small fw-bold">Degree Level</label>
                                                <select name="DegreeLevel" class="form-select">
                                                    <option value="Bachelor" selected="@(p.DegreeLevel == "Bachelor")">Bachelor</option>
                                                    <option value="Master" selected="@(p.DegreeLevel == "Master")">Master</option>
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label small fw-bold">Semesters</label>
                                                <input type="number" name="TotalSemesters" value="@p.TotalSemesters" class="form-control" />
                                            </div>
                                            <div class="col-4">
                                                <label class="form-label small fw-bold">Credits</label>
                                                <input type="number" name="TotalCredits" value="@p.TotalCredits" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked="@p.IsActive" id="chkProgActive-@p.ProgramId" />
                                            <label class="form-check-label small" for="chkProgActive-@p.ProgramId">Active Program</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Program Modal -->
<div class="modal fade" id="addProgModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddProgram" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Academic Program</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Program Code (e.g. BE-CMP) *</label>
                        <input type="text" name="ProgramCode" class="form-control" placeholder="e.g. BE-CMP" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Program Name *</label>
                        <input type="text" name="ProgramName" class="form-control" placeholder="e.g. Bachelor of Computer Engineering" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Faculty *</label>
                        <select name="FacultyId" class="form-select" required>
                            @foreach (var f in faculties)
                            {
                                <option value="@f.FacultyId">@f.FacultyName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-bold">Degree Level</label>
                            <select name="DegreeLevel" class="form-select">
                                <option value="Bachelor">Bachelor</option>
                                <option value="Master">Master</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Duration (Yrs)</label>
                            <input type="number" step="0.5" name="DurationYears" value="4.0" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Semesters</label>
                            <input type="number" name="TotalSemesters" value="8" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Total Credits</label>
                        <input type="number" name="TotalCredits" value="130" class="form-control" />
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Create Program</button>
                </div>
            </form>
        </div>
    </div>
</div>
