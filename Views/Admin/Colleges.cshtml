@model List<College>
@{
    ViewData["Title"] = "College Management";
    Layout = "_AdminLayout";
}

<div class="custom-card shadow-sm">
    <div class="card-header-custom">
        <h5><i class="fa-solid fa-building-columns text-primary"></i> Constituent & Affiliated Colleges</h5>
        <button class="btn btn-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addCollegeModal">
            <i class="fa-solid fa-plus me-1"></i> Add College
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>College Name</th>
                    <th>Location / Address</th>
                    <th>Principal / Chief</th>
                    <th>Contact</th>
                    <th>Email</th>
                    <th>Students</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong class="text-primary">@c.CollegeCode</strong></td>
                        <td class="fw-bold text-dark">@c.CollegeName</td>
                        <td><i class="fa-solid fa-location-dot text-danger me-1"></i> @c.Address</td>
                        <td>@(c.PrincipalName ?? "-")</td>
                        <td>@c.ContactNumber</td>
                        <td><small>@c.Email</small></td>
                        <td><span class="badge bg-secondary">@c.StudentCount Enrolled</span></td>
                        <td>
                            <span class="badge @(c.IsActive ? "bg-success" : "bg-danger")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@c.CollegeId">
                                <i class="fa-solid fa-pen-to-square"></i> Edit  
                            </button>
                        </td>
                    </tr>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal-@c.CollegeId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="EditCollege" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="CollegeId" value="@c.CollegeId" />
                                    <div class="modal-header">
                                        <h5 class="modal-title fw-bold">Edit College Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">College Code *</label>
                                            <input type="text" name="CollegeCode" value="@c.CollegeCode" class="form-control" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">College Name *</label>
                                            <input type="text"
                                                   name="CollegeName"
                                                   value="@c.CollegeName"
                                                   class="form-control"
                                                   maxlength="200"
                                                   pattern="[A-Za-z][A-Za-z\s&().'-]*"
                                                   title="Numbers are not allowed"
                                                   required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Address *</label>
                                            <input type="text" name="Address" value="@c.Address" class="form-control" required />
                                        </div>
                                        <div class="row g-2 mb-3">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Contact Phone *</label>
                                                <input type="tel"
                                                       name="ContactNumber"
                                                       value="@c.ContactNumber"
                                                       class="form-control"
                                                       maxlength="10"
                                                       minlength="10"
                                                       pattern="[0-9]{10}"
                                                       inputmode="numeric"
                                                       title="Enter exactly 10 digits"
                                                       required />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Official Email *</label>
                                                <input type="email"
                                                       name="Email"
                                                       value="@c.Email"
                                                       class="form-control"
                                                       maxlength="150"
                                                       required />
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Principal / Campus Chief</label>
                                            <input type="text" name="PrincipalName" value="@c.PrincipalName" class="form-control" />
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked="@c.IsActive" id="chkColActive-@c.CollegeId" />
                                            <label class="form-check-label small" for="chkColActive-@c.CollegeId">Active College Affiliation</label>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary btn-sm fw-bold">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add College Modal -->
<div class="modal fade" id="addCollegeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddCollege" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Affiliated College</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">College Code (e.g. AEC) *</label>
                        <input type="text" name="CollegeCode" class="form-control" placeholder="e.g. AEC" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">College Name *</label>
                        <input type="text"
                               name="CollegeName"
                               class="form-control"
                               placeholder="Enter College Name"
                               maxlength="200"
                               onkeydown="return /^[a-zA-Z ]$/.test(event.key) || ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)"
                               onpaste="return false"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Address *</label>
                        <input type="text" name="Address" class="form-control" placeholder="e.g. Pokhara-30, Kaski" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Contact Phone *</label>
                            <input type="tel"
                                   name="ContactNumber"
                                   id="collegeContact"
                                   class="form-control"
                                   placeholder="Enter 10 digit number"
                                   maxlength="10"
                                   minlength="10"
                                   pattern="[0-9]{10}"
                                   inputmode="numeric"
                                   title="Enter exactly 10 digits"
                                   required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Official Email *</label>
                            <input type="email"
                                   name="Email"
                                   class="form-control"
                                   placeholder="info@college.edu.np"
                                   maxlength="150"
                                   required />
                        </div>
                    </div>
                     <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Password *</label>
                            <div class="input-group">
                                <input type="password" name="Password"
                                       id="collegePassword" class="form-control"
                                       minlength="8" required />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="toggleCollegePassword('collegePassword','eyePassword')">
                                    <i class="fa-solid fa-eye" id="eyePassword"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Confirm Password *</label>
                            <div class="input-group">
                                <input type="password" name="ConfirmPassword"
                                       id="collegeConfirmPassword" class="form-control"
                                       minlength="8" required />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="toggleCollegePassword('collegeConfirmPassword','eyeConfirmPassword')">
                                    <i class="fa-solid fa-eye" id="eyeConfirmPassword"></i>
                                </button>
                            </div>
                            <small id="passwordMatchMessage"></small>
                        </div>
                    </div>


                    <div class="mb-3">
                        <label class="form-label small fw-bold">Principal / Campus Chief</label>
                        <input type="text" name="PrincipalName" class="form-control" placeholder="Er. / Dr. Principal Name" />
                    </div>


                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Add College</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.querySelectorAll('input[name="ContactNumber"]').forEach(input => {

        input.addEventListener("input", function () {

            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);

        });

    });
    document.querySelectorAll('input[name="CollegeName"]').forEach(input => {

        input.addEventListener("input", function () {

            this.setCustomValidity("");

            if (/[0-9]/.test(this.value)) {
                this.setCustomValidity("Numbers are not allowed in college name.");
            }

        });

    });

    function toggleCollegePassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);

        input.type = input.type === "password" ? "text" : "password";

        icon.classList.toggle("fa-eye");
        icon.classList.toggle("fa-eye-slash");
    }

    const cp = document.getElementById("collegePassword");
    const ccp = document.getElementById("collegeConfirmPassword");

    function validateCollegePassword() {
        const msg = document.getElementById("passwordMatchMessage");

        if (!ccp.value) {
            msg.textContent = "";
            return;
        }

        msg.textContent = cp.value === ccp.value
            ? "Password matched!"
            : "Password does not match!";

        msg.style.color = cp.value === ccp.value ? "green" : "red";
    }

    cp.addEventListener("input", validateCollegePassword);
    ccp.addEventListener("input", validateCollegePassword);

</script>