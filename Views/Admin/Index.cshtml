        background: rgba(255, 255, 255, .25);
    }

    .mini-value {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .mini-title {
        font-size: .68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        opacity: .92;
    }

    .mini-blue {
        background: linear-gradient(135deg, #2a5298, #4776e6);
    }

    .mini-green {
        background: linear-gradient(135deg, #11998e, #38b97d);
    }

    .mini-orange {
        background: linear-gradient(135deg, #f76707, #ffa62b);
    }

    .mini-red {
        background: linear-gradient(135deg, #d63031, #ff6b6b);
    }
</style>