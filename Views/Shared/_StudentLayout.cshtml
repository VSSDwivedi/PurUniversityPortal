<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portal | Purbanchal University</title>

    <!-- Favicons -->
    <link href="~/images/college-logo.png" rel="icon" type="image/png" />
    <link href="~/images/college-logo.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Quicksand:wght@400;500;600;700&family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Font Awesome 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Main puexam.edu.np Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Common admin/student UI (site.css ke baad, taaki sab dashboard pages pe same design lage) -->
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />

    <!-- Dashboard shell: sidebar aur content alag-alag scroll honge (site.css ke baad rakhna zaroori hai) -->
    <style>
        /* ---------- Sidebar: header/user/sign-out fixed, sirf menu list scroll hoti hai ---------- */
        .dashboard-sidebar {
            display: flex !important;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            max-height: 100vh;
            max-height: 100dvh;
            overflow: hidden !important;
        }

            .dashboard-sidebar > * {
                flex-shrink: 0;
            }

            .dashboard-sidebar > .nav {
                flex: 1 1 auto;
                min-height: 0;
                flex-wrap: nowrap;
                overflow-y: auto;
                overflow-x: hidden;
                overscroll-behavior: contain;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, .3) transparent;
            }

                .dashboard-sidebar > .nav::-webkit-scrollbar {
                    width: 6px;
                }

                .dashboard-sidebar > .nav::-webkit-scrollbar-track {
                    background: transparent;
                }

                .dashboard-sidebar > .nav::-webkit-scrollbar-thumb {
                    background: rgba(255, 255, 255, .28);
                    border-radius: 6px;
                }

                    .dashboard-sidebar > .nav::-webkit-scrollbar-thumb:hover {
                        background: rgba(255, 255, 255, .45);
                    }

        /* ---------- Desktop: page fixed, sirf content area scroll hota hai ---------- */
        @@media (min-width: 992px) {
            html, body {
                height: 100%;
                overflow: hidden;
            }

            .dashboard-wrapper {
                height: 100vh;
                height: 100dvh;
                overflow: hidden;
            }

            .dashboard-sidebar {
                top: 0;
            }

            .dashboard-content {
                height: 100vh;
                height: 100dvh;
                min-height: 0 !important;
                min-width: 0;
                overflow-y: auto;
                overflow-x: hidden;
                overscroll-behavior: contain;
                scroll-behavior: smooth;
                scrollbar-gutter: stable;
            }
        }

        /* ---------- Print: admit card / grade sheet poore print hon, scroll ki wajah se kate nahi ---------- */
        @@media print {
            html, body,
            .dashboard-wrapper,
            .dashboard-content {
                height: auto !important;
                overflow: visible !important;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="dashboard-wrapper">
        <!-- Sidebar Backdrop for Mobile -->
        <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

        <!-- Student Sidebar -->
        <aside id="dashboardSidebar" class="dashboard-sidebar no-print">
            <div class="sidebar-brand d-flex align-items-center justify-content-between">
                <div class="overflow-hidden">
                    <span class="d-block text-white fw-bold small text-truncate">PURBANCHAL UNIVERSITY</span>
                    <small class="text-warning fw-semibold" style="font-size: 11px;">Student Portal & Entrance</small>
                </div>
                <button type="button" id="sidebarCloseBtn" class="btn-close-sidebar d-lg-none" aria-label="Close Sidebar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="p-3 bg-black bg-opacity-25 border-bottom border-secondary d-flex align-items-center gap-2">
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: bold; flex-shrink: 0;">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <div class="overflow-hidden text-truncate">
                    <div class="fw-bold text-white small text-truncate">@User.Identity?.Name</div>
                    <small class="text-white-50" style="font-size: 11px;">Purbanchal Student</small>
                </div>
            </div>

            <ul class="nav flex-column py-2">
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-gauge-high"></i>
                        <span>Student Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="Profile" class="nav-link">
                        <i class="fa-solid fa-id-badge"></i>
                        <span>My Academic Profile</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="ApplyExam" class="nav-link">
                        <i class="fa-solid fa-file-pen"></i>
                        <span>Apply Exam Form</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="MyApplications" class="nav-link">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>My Applications</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="AdmitCard" class="nav-link">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Exam Card / Admit Card</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="Results" class="nav-link">
                        <i class="fa-solid fa-award"></i>
                        <span>Grade Sheets & Results</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Student" asp-action="StudentRoutine" class="nav-link">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Exam Routine / Schedule</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Notices" class="nav-link">
                        <i class="fa-solid fa-bullhorn"></i>
                        <span>University Notices</span>
                    </a>
                </li>
            </ul>

            <div class="p-3 border-top border-secondary mt-auto">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger w-100">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="dashboard-content">
            <!-- Topbar in Dashboard -->
            <div class="dashboard-topbar d-flex justify-content-between align-items-center mb-4 no-print bg-white p-3 rounded-3 shadow-sm border flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 gap-sm-3 min-w-0">
                    <button type="button" id="sidebarToggle" class="btn btn-primary d-lg-none flex-shrink-0" aria-label="Toggle Navigation">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="overflow-hidden">
                        <h4 class="fw-bold mb-0 text-primary text-truncate">@ViewData["Title"]</h4>
                        <small class="text-muted d-none d-sm-block text-truncate">Purbanchal University &bull; Office of the Examination Management</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a asp-controller="Student" asp-action="AdmitCard" class="btn btn-warning btn-sm fw-bold">
                        <i class="fa-solid fa-id-card me-1"></i> <span class="d-none d-sm-inline">Exam </span>Card
                    </a>
                    <a asp-controller="Results" asp-action="Studentfindresult" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-square-poll-vertical me-1"></i> <span class="d-none d-sm-inline">Find </span>Result
                    </a>
                </div>
            </div>

            <!-- Global Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-info me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>