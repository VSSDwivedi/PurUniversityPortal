                            <li><i class="bx bx-chevron-right"></i><a href="/downloads-new">Downloads</a></li>
                            <li><i class="bx bx-chevron-right"></i><a href="/exam-schedule-new">Exams Schedule</a></li>
                            <li><i class="bx bx-chevron-right"></i><a href="https://entrance.puexam.edu.np" target="_blank">Exam Form</a></li>
                            <li><i class="bx bx-chevron-right"></i><a href="https://entrance.puexam.edu.np" target="_blank">Exam Card</a></li>
