    <!-- Vendor Scripts -->
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/jquery.validate.min.js"></script>
    <script src="/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="/assets/vendor/aos/aos.js"></script>
    <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="/assets/vendor/php-email-form/validate.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/assets/js/nepali.datepicker.v2.min.js"></script>
    <script src="/assets/js/main.js"></script>

    <!-- Global puexam Interactive Handlers -->
    <script>
        $(document).ready(function() {
            // Mobile Nav
            $(document).off('click', '.nav-open');
            $(".nav-open").click(function () {
                $(this).hide();
                $('#header').removeClass('hide-nav-header');
                $('#header').addClass('show-nav-header');
                $('.nav-close').show();
            });

            $(document).off('click', '.nav-close');
            $(".nav-close").click(function () {
                $(this).hide();
                $('#header').removeClass('show-nav-header');
                $('#header').addClass('hide-nav-header');
                $('.nav-open').show();
            });

            // Notice PDF Modal Trigger
            $(document).on('click', '[data-href]', function() {
                var href = $(this).data('href');
                var title = $(this).data('title');
                var content = $(this).data('content') || '';
                if (href) {
                    $('#noticeTitle').text(title || 'Notice');
                    $('#contentDetail').html(content);
                    $('#noticeObject').attr('data', href);
                    $('#noticeFrame').attr('href', href);
                    var modal = new bootstrap.Modal(document.getElementById('noticeModal'));
                    modal.show();
                }
            });

            // Popup Notice Slider
            if ($('#modalNotice').length && !sessionStorage.getItem('puexam_popup_dismissed')) {
                var noticeSwiper = new Swiper('.home-popup-slider', {
                    speed: 600,
                    loop: true,
                    autoplay: {
                        delay: 4000,
                        disableOnInteraction: false
                    },
                    pagination: {
                        el: '.swiper-pagination',
                        clickable: true
                    },
                    navigation: {
                        nextEl: '.swiper-button-next',
                        prevEl: '.swiper-button-prev'
                    }
                });
                $('#modalNotice').modal('show');
                $('#modalNotice .btn-close').click(function() {
                    sessionStorage.setItem('puexam_popup_dismissed', 'true');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>