                            <div class="swiper-slide text-center">
                                <img src="/public/image/slider/regd_law_master_level_2026_1784871891.jpg" class="img-fluid popup-slider-img w-100" alt="Regd Master Law">
                            </div>
                            <div class="swiper-slide text-center">
                                <img src="/public/image/slider/affiliation_collection_letter_1784028015.jpg" class="img-fluid popup-slider-img w-100" alt="Affiliation Fee Paying Letter">
                            </div>
                            <div class="swiper-slide text-center">
                                <img src="/public/image/slider/regd_master_arts_mgmt_2026_1781850556.jpg" class="img-fluid popup-slider-img w-100" alt="Regd Master Arts Mgmt">
