    <style>
        label.error {
            font-size: 11px;
            height: 0px;
            color: red;
            clear: both;
            width: 100%;
        }
        .header-inner-pages header#header,
        header#header.header-inner-pages {
            background: rgba(21, 34, 43, 0.95) !important;
            padding: 10px 0;
            position: sticky;
            top: 0;
        }
        header#header.fixed-top {
            transition: all 0.5s;
            z-index: 997;
            padding: 15px 0;
        }
        .popup-slider-img {
            max-height: 80vh;
            object-fit: contain;
            background: #fff;
        }
        #modalNotice .modal-dialog {
            max-width: 900px;
        }
        .gradesheet-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        .gradesheet-table th, .gradesheet-table td {
            border: 1px solid #111;
            padding: 6px 10px;
            font-size: 13px;
        }
        .gradesheet-table th {
            background: #f1f4f9;
        }
