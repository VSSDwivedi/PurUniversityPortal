                    {
                        <li class="dropdown"><a href="#" class="text-warning"><span><i class="fa fa-user me-1"></i> @User.Identity.Name</span> <i class="bi bi-chevron-down"></i></a>
                            <ul>
                                @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Examination Controller"))
                                {
                                    <li><a asp-controller="Admin" asp-action="Index"><i class="fa fa-gauge me-2 text-primary"></i> Admin Panel</a></li>
                                }
                                @if (User.IsInRole("Student"))
                                {
                                    <li><a asp-controller="Student" asp-action="Index"><i class="fa fa-user-graduate me-2 text-success"></i> Student Portal</a></li>
                                    <li><a asp-controller="Student" asp-action="ApplyExam"><i class="fa fa-file-pen me-2 text-info"></i> Exam Form</a></li>
                                    <li><a asp-controller="Student" asp-action="AdmitCard"><i class="fa fa-id-card me-2 text-warning"></i> Admit Card</a></li>
                                }
                                @if (User.IsInRole("College Admin"))
                                {
                                    <li><a asp-controller="College" asp-action="Index"><i class="fa fa-building me-2 text-info"></i> College Panel</a></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                                            <i class="fa fa-sign-out me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="d-none d-xl-inline-block">
                            <a href="/college-login-new" class="btn btn-sm btn-outline-warning py-1 px-2 text-warning ms-2" style="font-size: 12px; border-radius: 4px;">Login</a>
