                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="content-data mb-3" id="contentDetail"></div>
                    <object id="noticeObject" data="" type="application/pdf" width="100%" height="575">
                        <p class="text-center py-4">
                            Your browser does not support embedded PDF viewing.
                            <a id="noticeFrame" href="" target="_blank" class="btn btn-primary"><i class="fa fa-download me-1"></i> Click here to download or open the PDF file</a>
                        </p>
                    </object>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

