@{
    var userType = User.Claims
        .FirstOrDefault(c => c.Type == "UserType")?.Value ?? "";

    bool isCollegeAdmin = userType.Equals(
        "CollegeAdmin",
        StringComparison.OrdinalIgnoreCase
    );
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Admin Portal | Purbanchal University OEM</title>

    <!-- Favicons -->
    <link href="~/images/college-logo.png" rel="icon" type="image/png" />
    <link href="~/images/college-logo.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Quicksand:wght@400;500;600;700&family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Font Awesome 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Main Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Admin UI -->
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />

    <style>

        .dashboard-sidebar {
            display: flex !important;
            flex-direction: column;
            height: 100vh;
            height: 100dvh;
            max-height: 100vh;
            max-height: 100dvh;
            overflow: hidden !important;
        }

            .dashboard-sidebar > * {
                flex-shrink: 0;
            }

            .dashboard-sidebar > .nav {
                flex: 1 1 auto;
                min-height: 0;
                flex-wrap: nowrap;
                overflow-y: auto;
                overflow-x: hidden;
                overscroll-behavior: contain;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, .3) transparent;
            }

                .dashboard-sidebar > .nav::-webkit-scrollbar {
                    width: 6px;
                }

                .dashboard-sidebar > .nav::-webkit-scrollbar-track {
                    background: transparent;
                }

                .dashboard-sidebar > .nav::-webkit-scrollbar-thumb {
                    background: rgba(255, 255, 255, .28);
                    border-radius: 6px;
                }

                    .dashboard-sidebar > .nav::-webkit-scrollbar-thumb:hover {
                        background: rgba(255, 255, 255, .45);
                    }

        /* College Admin Sidebar Styling */

        .college-sidebar .sidebar-brand {
            border-bottom: 2px solid #f28a1c;
        }

        .college-sidebar .nav-link {
            transition: all .3s ease;
        }

            .college-sidebar .nav-link:hover {
                background: rgba(255,255,255,.12);
            }

        @@media (min-width: 992px) {

            html, body {
                height: 100%;
                overflow: hidden;
            }

            .dashboard-wrapper {
                height: 100vh;
                height: 100dvh;
                overflow: hidden;
            }

            .dashboard-sidebar {
                top: 0;
            }

            .dashboard-content {
                height: 100vh;
                height: 100dvh;
                min-height: 0 !important;
                min-width: 0;
                overflow-y: auto;
                overflow-x: hidden;
                overscroll-behavior: contain;
                scroll-behavior: smooth;
                scrollbar-gutter: stable;
            }
        }

        @@media print {

            html, body,
            .dashboard-wrapper,
            .dashboard-content {
                height: auto !important;
                overflow: visible !important;
            }
        }

    </style>

</head>

<body class="bg-light">

    <div class="dashboard-wrapper">

        <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

        <!-- SIDEBAR START -->

        <aside id="dashboardSidebar"
               class="dashboard-sidebar no-print @(isCollegeAdmin ? "college-sidebar" : "")">

            <!-- Sidebar Brand -->

            <div class="sidebar-brand d-flex align-items-center justify-content-between">

                <div class="overflow-hidden">

                    <span class="d-block text-white fw-bold small text-truncate">
                        PURBANCHAL UNIVERSITY
                    </span>

                    <small class="text-warning fw-semibold" style="font-size: 11px;">

                        @if (isCollegeAdmin)
                        {
                            <text>College Management Portal</text>
                        }
                        else
                        {
                            <text>Office of Exam Management</text>
                        }

                    </small>

                </div>

                <button type="button"
                        id="sidebarCloseBtn"
                        class="btn-close-sidebar d-lg-none"
                        aria-label="Close Sidebar">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>

            <!-- Logged In User -->

            <div class="p-3 bg-black bg-opacity-25 border-bottom border-secondary d-flex align-items-center gap-2">

                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center"
                     style="width: 38px; height: 38px; font-weight: bold; flex-shrink: 0;">

                    @if (isCollegeAdmin)
                    {
                        <i class="fa-solid fa-building-columns"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-user-shield"></i>
                    }

                </div>

                <div class="overflow-hidden text-truncate">

                    <div class="fw-bold text-white small text-truncate">
                        @User.Identity?.Name
                    </div>

                    <span class="badge bg-primary py-0 px-2" style="font-size: 10px;">
                        @userType
                    </span>

                </div>

            </div>

            <!-- SIDEBAR MENU -->

            <ul class="nav flex-column py-2">

                @if (isCollegeAdmin)
                {
                    <!-- COLLEGE ADMIN MENU -->

                    <li class="nav-item">

                        <a asp-controller="College"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-gauge-high"></i>

                            <span>College Dashboard</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminStudent"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-user-graduate"></i>

                            <span>Student Registrations</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminExam"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-calendar-check"></i>

                            <span>Examinations & Routines</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminMarks"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-marker"></i>

                            <span>Marks Entry & Evaluation</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminResult"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-square-poll-vertical"></i>

                            <span>Result Processing & Publish</span>

                        </a>

                    </li>
                }
                else
                {
                    <!-- UNIVERSITY ADMIN MENU -->

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-chart-pie"></i>

                            <span>Executive Dashboard</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminStudent"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-user-graduate"></i>

                            <span>Student Registrations</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminExam"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-calendar-check"></i>

                            <span>Examinations & Routines</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminExam"
                           asp-action="Applications"
                           class="nav-link">

                            <i class="fa-solid fa-id-card"></i>

                            <span>Exam Form Applications</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminExam"
                           asp-action="Centers"
                           class="nav-link">

                            <i class="fa-solid fa-location-dot"></i>

                            <span>Examination Centers</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminMarks"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-marker"></i>

                            <span>Marks Entry & Evaluation</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminResult"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-square-poll-vertical"></i>

                            <span>Result Processing & Publish</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminResult"
                           asp-action="BulkGradeSheets"
                           class="nav-link">

                            <i class="fa-solid fa-file-invoice"></i>

                            <span>Official Grade Sheets</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="AdminNotice"
                           asp-action="Index"
                           class="nav-link">

                            <i class="fa-solid fa-bullhorn"></i>

                            <span>Notice Board Management</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Colleges"
                           class="nav-link">

                            <i class="fa-solid fa-building-columns"></i>

                            <span>Colleges & Campuses</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Faculties"
                           class="nav-link">

                            <i class="fa-solid fa-sitemap"></i>

                            <span>Faculties (7 PU Faculties)</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Programs"
                           class="nav-link">

                            <i class="fa-solid fa-graduation-cap"></i>

                            <span>Academic Programs</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Subjects"
                           class="nav-link">

                            <i class="fa-solid fa-book-open"></i>

                            <span>Curriculum Subjects</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="GradeScales"
                           class="nav-link">

                            <i class="fa-solid fa-sliders"></i>

                            <span>PU Grading Scales (4.0 GPA)</span>

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Admin"
                           asp-action="Settings"
                           class="nav-link">

                            <i class="fa-solid fa-gear"></i>

                            <span>System Settings</span>

                        </a>

                    </li>

                }

            </ul>

            <!-- Logout -->

            <div class="p-3 border-top border-secondary mt-auto">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-sm btn-danger w-100">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>

                        Sign Out

                    </button>

                </form>

            </div>

        </aside>

        <!-- SIDEBAR END -->
        <!-- MAIN CONTENT START -->

        <div class="dashboard-content">

            <!-- TOPBAR START -->

            <div class="dashboard-topbar d-flex justify-content-between align-items-center mb-4 no-print bg-white p-3 rounded-3 shadow-sm border flex-wrap gap-2">

                <div class="d-flex align-items-center gap-2 gap-sm-3 min-w-0">

                    <button type="button"
                            id="sidebarToggle"
                            class="btn btn-primary d-lg-none flex-shrink-0"
                            aria-label="Toggle Navigation">

                        <i class="fa-solid fa-bars"></i>

                    </button>

                    <div class="overflow-hidden">

                        <h4 class="fw-bold mb-0 text-primary text-truncate">
                            @ViewData["Title"]
                        </h4>

                        <small class="text-muted d-none d-sm-block text-truncate">

                            @if (isCollegeAdmin)
                            {
                                <text>Purbanchal University &bull; College Management Portal</text>
                            }
                            else
                            {
                                <text>Purbanchal University &bull; Office of the Examination Management, Biratnagar</text>
                            }

                        </small>

                    </div>

                </div>


                <!-- TOPBAR BUTTONS -->

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    @if (isCollegeAdmin)
                    {
                        <!-- College Admin Buttons -->

                        <a asp-controller="CollegeStudent"
                           asp-action="Index"
                           class="badge bg-warning text-dark text-decoration-none py-2 px-3">

                            <i class="fa-solid fa-user-plus me-1"></i>

                            Student Registration

                        </a>

                        <a asp-controller="CollegeMarks"
                           asp-action="Index"
                           class="badge bg-info text-dark text-decoration-none py-2 px-3">

                            <i class="fa-solid fa-upload me-1"></i>

                            Marks Upload

                        </a>
                    }
                    else
                    {
                        <!-- University Admin Buttons -->

                        <a asp-controller="AdminStudent"
                           asp-action="Index"
                           asp-route-status="Pending"
                           class="badge bg-warning text-dark text-decoration-none py-2 px-3">

                            <i class="fa-solid fa-user-clock me-1"></i>

                            <span class="d-none d-md-inline">Pending </span>Registrations

                        </a>

                        <a asp-controller="AdminExam"
                           asp-action="Applications"
                           asp-route-status="Pending"
                           class="badge bg-info text-dark text-decoration-none py-2 px-3">

                            <i class="fa-solid fa-file-pen me-1"></i>

                            <span class="d-none d-md-inline">Exam </span>Applications

                        </a>
                    }

                </div>

            </div>

            <!-- TOPBAR END -->
            <!-- SUCCESS MESSAGE -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">

                    <i class="fa-solid fa-circle-check me-2"></i>

                    @TempData["SuccessMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- ERROR MESSAGE -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">

                    <i class="fa-solid fa-triangle-exclamation me-2"></i>

                    @TempData["ErrorMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- INFO MESSAGE -->
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">

                    <i class="fa-solid fa-circle-info me-2"></i>

                    @TempData["InfoMessage"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            <!-- PAGE CONTENT -->
            @RenderBody()

        </div>

        <!-- MAIN CONTENT END -->

    </div>


    <!-- SCRIPTS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/admin-ui.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
