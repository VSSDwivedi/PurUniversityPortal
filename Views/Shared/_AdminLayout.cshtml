<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | Purbanchal University OEM</title>
    
    <!-- Favicons -->
    <link href="~/images/college-logo.png" rel="icon" type="image/png" />
    <link href="~/images/college-logo.png" rel="apple-touch-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Quicksand:wght@400;500;600;700&family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Font Awesome 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Main puexam.edu.np Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="dashboard-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="dashboard-sidebar no-print">
            <div class="sidebar-brand">
             @*    <img src="~/images/pulogo.png" alt="Purbanchal University" style="max-height: 44px;" /> *@
                <div class="overflow-hidden">
                    <span class="d-block text-white fw-bold small text-truncate">PURBANCHAL UNIVERSITY</span>
                    <small class="text-warning fw-semibold" style="font-size: 11px;">Office of Exam Management</small>
                </div>
            </div>

            <div class="p-3 bg-black bg-opacity-25 border-bottom border-secondary d-flex align-items-center gap-2">
                <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-weight: bold;">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div class="overflow-hidden text-truncate">
                    <div class="fw-bold text-white small text-truncate">@User.Identity?.Name</div>
                    <span class="badge bg-primary py-0 px-2" style="font-size: 10px;">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
            </div>

            <ul class="nav flex-column py-2">
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Executive Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminStudent" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Student Registrations</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminExam" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Examinations & Routines</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminExam" asp-action="Applications" class="nav-link">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Exam Form Applications</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminExam" asp-action="Centers" class="nav-link">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>Examination Centers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminMarks" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-marker"></i>
                        <span>Marks Entry & Evaluation</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminResult" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-square-poll-vertical"></i>
                        <span>Result Processing & Publish</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminResult" asp-action="BulkGradeSheets" class="nav-link">
                        <i class="fa-solid fa-file-invoice"></i>
                        <span>Official Grade Sheets</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="AdminNotice" asp-action="Index" class="nav-link">
                        <i class="fa-solid fa-bullhorn"></i>
                        <span>Notice Board Management</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Colleges" class="nav-link">
                        <i class="fa-solid fa-building-columns"></i>
                        <span>Colleges & Campuses</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Faculties" class="nav-link">
                        <i class="fa-solid fa-sitemap"></i>
                        <span>Faculties (7 PU Faculties)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Programs" class="nav-link">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>Academic Programs</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Subjects" class="nav-link">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Curriculum Subjects</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="GradeScales" class="nav-link">
                        <i class="fa-solid fa-sliders"></i>
                        <span>PU Grading Scales (4.0 GPA)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Settings" class="nav-link">
                        <i class="fa-solid fa-gear"></i>
                        <span>System Settings</span>
                    </a>
                </li>
            </ul>

            <div class="p-3 border-top border-secondary mt-auto">
              @*   <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-sm btn-outline-light w-100 mb-2">
                    <i class="fa-solid fa-globe me-1"></i> Public Website
                </a> *@
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger w-100">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="dashboard-content">
            <!-- Topbar in Dashboard -->
            <div class="d-flex justify-content-between align-items-center mb-4 no-print bg-white p-3 rounded-3 shadow-sm border">
                <div>
                    <h4 class="fw-bold mb-0 text-primary">@ViewData["Title"]</h4>
                    <small class="text-muted">Purbanchal University &bull; Office of the Examination Management, Biratnagar</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="AdminStudent" asp-action="Index" asp-route-status="Pending" class="badge bg-warning text-dark text-decoration-none py-2 px-3">
                        <i class="fa-solid fa-user-clock me-1"></i> Pending Registrations
                    </a>
                    <a asp-controller="AdminExam" asp-action="Applications" asp-route-status="Pending" class="badge bg-info text-dark text-decoration-none py-2 px-3">
                        <i class="fa-solid fa-file-pen me-1"></i> Exam Applications
                    </a>
               @*      <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-house me-1"></i> puexam.edu.np Home
                    </a> *@
                </div>
            </div>

            <!-- Global Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid fa-circle-info me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
