@model List<Result>
@{
    var exam = ViewBag.Examination as Examination;
    ViewData["Title"] = "Result Ledger - " + (exam?.ExamName ?? "Examination");
    Layout = "_AdminLayout";
    var colleges = ViewBag.Colleges as List<College> ?? new List<College>();
    var programs = ViewBag.Programs as List<ProgramModel> ?? new List<ProgramModel>();
    int? selCol = ViewBag.SelectedCollege;
    int? selProg = ViewBag.SelectedProgram;
    bool isPublished = Model.Any(r => r.IsPublished); bool isCollegeAdmin = ViewBag.IsCollegeAdmin ?? false;
 
}

<div class="custom-card shadow-sm mb-4">
    <div class="card-header-custom">
        <div>
            <h5 class="text-primary mb-0"><i class="fa-solid fa-square-poll-vertical me-2"></i> Result Ledger: @(exam?.ExamName)</h5>
            <small class="text-muted">Total Examinees: @Model.Count &bull; Passed: @Model.Count(r => r.ResultStatus == "Passed") &bull; Back/Failed: @Model.Count(r => r.ResultStatus != "Passed")</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-examId="@(exam?.ExaminationId ?? 0)" asp-route-collegeId="@selCol" asp-route-programId="@selProg" class="btn btn-outline-success btn-sm fw-bold">
                <i class="fa-solid fa-file-excel me-1"></i> Export Excel
            </a>
            <a asp-action="BulkGradeSheets" asp-route-examId="@(exam?.ExaminationId ?? 0)" asp-route-collegeId="@selCol" target="_blank" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fa-solid fa-print me-1"></i> Bulk Grade Sheets
            </a>

            @if (isPublished)
            {
                <form asp-action="Publish" method="post" class="d-inline" onsubmit="return confirm('Revoke public access to these results?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@(exam?.ExaminationId ?? 0)" />
                    <input type="hidden" name="publish" value="false" />
                    <button type="submit" class="btn btn-danger btn-sm fw-bold shadow-sm">
                        <i class="fa-solid fa-eye-slash me-1"></i> Unpublish Results
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Publish" method="post" class="d-inline" onsubmit="return confirm('OFFICIALLY PUBLISH RESULTS? Once published, students can immediately look up marks and download Grade Sheets online.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@(exam?.ExaminationId ?? 0)" />
                    <input type="hidden" name="publish" value="true" />
                    <button type="submit" class="btn btn-success btn-sm fw-bold shadow-sm">
                        <i class="fa-solid fa-globe me-1"></i> Publish Results Online
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="p-3 bg-light border-bottom">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="examId" value="@(exam?.ExaminationId ?? 0)" />
            <div class="col-md-5">
                @if (isCollegeAdmin)
                {
                    <select class="form-select form-select-sm" disabled>
                        @foreach (var c in colleges)
                        {
                            <option value="@c.CollegeId" selected="@(selCol == c.CollegeId)">@c.CollegeName</option>
                        }
                    </select>
                    <input type="hidden" name="collegeId" value="@selCol" />
                }
                else
                {
                    <select name="collegeId" class="form-select form-select-sm">
                        <option value="">-- All Colleges --</option>
                        @foreach (var c in colleges)
                        {
                            <option value="@c.CollegeId" selected="@(selCol == c.CollegeId)">@c.CollegeName</option>
                        }
                    </select>
                }
            </div>
            <div class="col-md-5">
                <select name="programId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Programs --</option>
                    @foreach (var p in programs)
                    {
                        <option value="@p.ProgramId" selected="@(selProg == p.ProgramId)">@p.ProgramName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Back to Sessions</a>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-center">
            <thead class="table-light">
                <tr>
                    <th>Roll Number</th>
                    <th class="text-start">Candidate Name</th>
                    <th>Registration No</th>
                    <th>College</th>
                    <th>Program</th>
                    <th>Total Obtained</th>
                    <th>Percentage</th>
                    <th>SGPA</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var r in Model)
                    {
                        <tr>
                            <td><strong class="text-danger fs-6">@r.RollNumber</strong></td>
                            <td class="text-start fw-bold text-dark">@r.StudentName</td>
                            <td><span class="badge bg-secondary">@r.RegistrationNumber</span></td>
                            <td><small>@r.CollegeName</small></td>
                            <td>@r.ProgramName</td>
                            <td>@r.TotalMarksObtained.ToString("F1") / @r.TotalFullMarks.ToString("F0")</td>
                            <td class="fw-bold text-primary">@r.Percentage.ToString("F1")%</td>
                            <td><strong class="text-success fs-6">@r.SGPA.ToString("F2")</strong></td>
                            <td>
                                <span class="badge @(r.ResultStatus == "Passed" ? "bg-success" : "bg-danger") px-3 py-1">
                                    @r.ResultStatus
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Results" asp-action="GradeSheet" asp-route-id="@r.ResultId" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-print me-1"></i> Grade Sheet
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            No calculated results found for this examination session. Click "Process Results" above to compute marks and SGPA.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
