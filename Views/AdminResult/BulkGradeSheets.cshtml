@model List<Result>
@{
    var exam = ViewBag.Examination as Examination;
    ViewData["Title"] = "Bulk Grade Sheets - " + (exam?.ExamName ?? "Examination");
    Layout = null; // Print-ready standalone layout
    var gradeScales = ViewBag.GradeScales as List<GradeScale> ?? new List<GradeScale>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Bulk Provisional Grade Sheets - @(exam?.ExamName) - Purbanchal University</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: #f8fafc; font-family: 'Times New Roman', Times, serif; }
        .gradesheet-border { border: 3px double #003980; padding: 25px; background: #fff; page-break-after: always; margin-bottom: 30px; position: relative; max-width: 900px; margin-left: auto; margin-right: auto; }
        .print-watermark {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 5rem;
            color: rgba(0, 57, 128, 0.04);
            font-weight: 900;
            pointer-events: none;
            white-space: nowrap;
        }
        @@media print {
            body { background: #fff; }
            .no-print { display: none !important; }
            .gradesheet-border { border: 2px solid #000; margin-bottom: 0; max-width: 100%; box-shadow: none !important; }
        }
    </style>
</head>
<body>
    <div class="container text-center my-3 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold shadow">
            <i class="fa-solid fa-print me-1"></i> Print All @Model.Count Grade Sheets
        </button>
    </div>

    @foreach (var r in Model)
    {
        <div class="gradesheet-border shadow">
            <div class="print-watermark">PURBANCHAL UNIVERSITY</div>

            <div class="text-center border-bottom pb-2 mb-3">
                <img src="~/images/pulogobg.png" alt="Purbanchal University" style="max-height: 110px;" class="mb-1" />
                <h4 class="fw-bold mb-0 text-dark">PURBANCHAL UNIVERSITY</h4>
                <div class="fw-bold text-danger">Office of the Examination Management</div>
                <div class="small text-muted">Biratnagar, Nepal &bull; puexam.edu.np</div>
                <div class="mt-1"><span class="badge bg-dark px-3 py-1 text-uppercase">Provisional Statement of Marks / Grade Sheet</span></div>
            </div>

            <div class="border rounded p-2 mb-3 bg-light small">
                <div class="row g-1">
                    <div class="col-7"><strong>Student:</strong> <span class="text-primary fw-bold text-uppercase">@r.StudentName</span></div>
                    <div class="col-5"><strong>Roll No:</strong> <span class="text-danger fw-bold">@r.RollNumber</span></div>
                    <div class="col-7"><strong>Reg No:</strong> <span class="text-primary fw-bold">@r.RegistrationNumber</span></div>
                    <div class="col-5"><strong>Semester:</strong> @r.SemesterName</div>
                    <div class="col-7"><strong>Program:</strong> @r.ProgramName (@r.ProgramCode)</div>
                    <div class="col-5"><strong>Examination:</strong> @r.ExamName</div>
                    <div class="col-12"><strong>College:</strong> @r.CollegeName</div>
                </div>
            </div>

            <table class="table table-bordered table-sm align-middle text-center mb-2 small">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th class="text-start">Subject Title</th>
                        <th>Credit</th>
                        <th>Internal</th>
                        <th>External</th>
                        <th>Practical</th>
                        <th>Total</th>
                        <th>Grade</th>
                        <th>GP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in r.Details)
                    {
                        <tr>
                            <td class="fw-bold">@s.SubjectCode</td>
                            <td class="text-start">@s.SubjectName</td>
                            <td>@s.CreditHours</td>
                            <td>@s.InternalMarks.ToString("F1")</td>
                            <td>@s.ExternalMarks.ToString("F1")</td>
                            <td>@(s.PracticalMarks > 0 ? s.PracticalMarks.ToString("F1") : "-")</td>
                            <td class="fw-bold">@s.TotalMarks.ToString("F1")</td>
                            <td class="fw-bold @(s.Grade == "F" ? "text-danger" : "text-primary")">@s.Grade</td>
                            <td>@s.GradePoint.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="fw-bold">
                    <tr>
                        <td colspan="2" class="text-start">Total Credits: @r.TotalCreditHours</td>
                        <td colspan="4" class="text-end">Percentage: @r.Percentage.ToString("F2")%</td>
                        <td colspan="3">Marks: @r.TotalMarksObtained.ToString("F1")</td>
                    </tr>
                </tfoot>
            </table>

            <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2 bg-light small">
                <div>
                    <span class="me-3"><strong>SGPA:</strong> <span class="text-primary fw-bold">@r.SGPA.ToString("F2")</span></span>
                    <span class="me-3"><strong>CGPA:</strong> <span class="text-success fw-bold">@r.CGPA.ToString("F2")</span></span>
                </div>
                <div>
                    <strong>Result:</strong> <span class="badge @(r.ResultStatus == "Passed" ? "bg-success" : "bg-danger")">@r.ResultStatus.ToUpper()</span>
                </div>
            </div>

            <div class="row align-items-end pt-2 border-top">
                <div class="col-4 text-center">
                    @if (!string.IsNullOrEmpty(r.GradeSheetQrCodeBase64))
                    {
                        <img src="@r.GradeSheetQrCodeBase64" alt="Verification QR" style="width: 75px; height: 75px;" />
                    }
                    <div class="text-muted" style="font-size: 0.6rem;">puexam.edu.np verification</div>
                </div>
                <div class="col-4 text-center">
                    <div class="small text-muted mb-1">Issue Date: @(r.PublishedDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))</div>
                    <div style="border-top: 1px solid #333; width: 140px; margin: 0 auto;"></div>
                    <div class="small fw-bold">Computer Section</div>
                </div>
                <div class="col-4 text-center">
                    <div style="font-family: 'Brush Script MT', cursive; font-size: 1.4rem; color: #003980;">Prof. Dr. Suryanath Adhikari</div>
                    <div style="border-top: 1px solid #333; width: 160px; margin: 0 auto;"></div>
                    <div class="small fw-bold">Controller of Examinations</div>
                </div>
            </div>
        </div>
    }
</body>
</html>
